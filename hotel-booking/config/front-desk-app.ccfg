config app hotel.FrontDesk {
  base {
    targets = ["angular"];
    clients {
      angular {
        scope = "@marram";
      }
    }
    strings = ["config/strings/front-desk.en-US.ccfg"];
  }
  profile test as "test" extends base {
    web { port = 4300; }
  }
  profile aws as "aws" extends base {
    web { domain { name = "desk.marram.example.com"; } }
  }
  profile development as "dev" extends aws {
  }
  profile production as "prod" extends base {
    web { port = 4300; }
  }
}
