config service hotel.ChannelMock {
  import "config/templates/infrastructure.ccfg";

  base {
    port = 8092;
    replicas = 1;
    healthCheck {
      path = "/health";
      initialDelay = "10s";
    }
    rdbms channelDb from postgresContainer(id: "e43a7c18-9d62-4b1f-b305-7f8e2c6a1d94", database: "hotel_channel_mock");
    httpSecurity from localHttpSecurity(host: "hotel-channel-mock");
    serviceCredentialOps from machineCredential();
    resilience {
      defaults {
        timeout = "10s";
      }
      dependencyPolicy {
        defaults {
          rdbms from standardDatabasePolicy();
        }
      }
    }
  }

  profile test as "test" extends base {
    alias env = "TEST";
    alias resource = "test";
  }

  profile aws as "aws" extends base {
    alias env = "AWS";
    alias resource = "aws";

    remoteConfigOps {
      appconfigMinPollSeconds = 15;
    }
    resources {
      requests {
        cpu = "100m";
        memory = "256Mi";
      }
    }
    scaling {
      replicas {
        min = 1;
        max = 1;
      }
      triggers = [];
    }
    replace rdbms channelDb from rdsPostgres(id: "e43a7c18-9d62-4b1f-b305-7f8e2c6a1d94", database: "hotel_channel_mock");
  }

  profile development as "dev" extends aws {
    alias env = "DEV";
    alias resource = "dev";
  }

  profile production as "prod" extends base {
    alias env = "PROD";
    alias resource = "prod";
  }
}
