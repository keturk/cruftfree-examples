config service hotel.PaymentMock {
  import "config/templates/infrastructure.ccfg";

  base {
    port = 8090;
    replicas = 1;
    healthCheck {
      path = "/health";
      initialDelay = "10s";
    }
    rdbms paymentDb from postgresContainer(id: "6a1e4f3c-2b80-47d9-a6c5-9e3b1d7f2c40", database: "hotel_payment_mock");
    httpSecurity from localHttpSecurity(host: "hotel-payment-mock");
    serviceCredentialOps from machineCredential();
    resilience {
      defaults {
        timeout = "10s";
      }
      dependencyPolicy {
        defaults {
          rdbms from standardDatabasePolicy();
        }
      }
    }
  }

  profile test as "test" extends base {
    alias env = "TEST";
    alias resource = "test";
  }

  profile aws as "aws" extends base {
    alias env = "AWS";
    alias resource = "aws";

    remoteConfigOps {
      appconfigMinPollSeconds = 15;
    }
    resources {
      requests {
        cpu = "100m";
        memory = "256Mi";
      }
    }
    scaling {
      replicas {
        min = 1;
        max = 1;
      }
      triggers = [];
    }
    replace rdbms paymentDb from rdsPostgres(id: "6a1e4f3c-2b80-47d9-a6c5-9e3b1d7f2c40", database: "hotel_payment_mock");
  }

  profile development as "dev" extends aws {
    alias env = "DEV";
    alias resource = "dev";
  }

  profile production as "prod" extends base {
    alias env = "PROD";
    alias resource = "prod";
  }
}
