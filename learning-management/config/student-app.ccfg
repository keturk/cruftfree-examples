config app lms.Student {
  base {
    targets = ["angular", "flutter"];
    clients {
      angular {
        scope = "@larkhill";
      }
    }
    appId = "com.example.larkhill";
    strings = ["config/strings/student.en-US.ccfg"];
  }
  profile test as "test" extends base {
    web { port = 4200; }
  }
  // The deployed profile also ships the mobile app, so it declares how the release is signed. Each
  // Android value names a logical secret handle the operator supplies at build time, never the secret
  // itself. The iOS team id is a public Apple Developer identifier.
  profile azure as "azure" extends base {
    android {
      keystore = "android_keystore";
      keyAlias = "android_key_alias";
      storePassword = "android_store_password";
      keyPassword = "android_key_password";
    }
    ios { teamId = "ABCDE12345"; }
    web { domain { name = "larkhill.example.com"; } }
  }
  profile development as "dev" extends azure {
  }
  profile production as "prod" extends base {
    web { port = 4200; }
  }
}
