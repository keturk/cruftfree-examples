// helpdesk-system infrastructure
// Generated by CruftFree. Do not edit manually.

targetScope = 'resourceGroup'


@description('Azure region for all resources')
param location string = 'eastus'

@description('Environment name (dev, staging, production)')
param environment string = 'dev'

@description('Object id of the identity running the deployment, granted the rights each schema run needs. Deliberately has no default: the operator is a deploy-time fact, and a default would grant the wrong identity.')
param operatorPrincipalId string

@description('Directory object type of operatorPrincipalId -- User for a signed-in human, ServicePrincipal for an automation identity. Azure rejects a role assignment whose declared principalType does not match the object.')
@allowed([
  'User'
  'ServicePrincipal'
  'Group'
])
param operatorPrincipalType string



// ---- Shared Infrastructure ----

module keyVault 'modules/key-vault.bicep' = {
  name: 'key-vault'
  params: {
    location: location
    vaultName: 'helpdesk-system-kv-${environment}'
  }
}

// Private vault of helpdesk.NoticeService: holds only the secrets that service alone
// reads, so its identity is granted the vault as a whole and nothing wider.
module helpdeskNoticeServiceKeyVault 'modules/key-vault.bicep' = {
  name: 'key-vault-helpdesk-notice-service'
  params: {
    location: location
    vaultName: 'helpdes-516b59c6-sv-${environment}'
  }
}

module virtualNetwork 'modules/virtual-network.bicep' = {
  name: 'virtual-network'
  params: {
    location: location
    environment: environment
  }
}



// ---- Shared Azure Container Registry ----
// ONE registry for the whole system; every container-mode web app pulls by
// managed identity (acrUseManagedIdentityCreds on the web-app module below,
// AcrPull role assignment in the per-service role loop), and so does every
// schema run's container group, as its block's schema identity (the run store
// grants it). Images are differentiated by repository name, not by registry
// (the backlog-010 asymmetry vs. AWS's repo-per-service ECR, deliberately kept).
module containerRegistry 'modules/container-registry.bicep' = {
  name: 'container-registry'
  params: {
    location: location
    environment: environment
    vnetId: virtualNetwork.outputs.vnetId
    // Reuses the shared storage-family PE subnet -- ACR has no dedicated
    // subnet in the CIDR plan, matching the deploy-script-infra.bicep
    // private-endpoint precedent (main.bicep.j2, deployScriptInfra module).
    subnetId: virtualNetwork.outputs.storageSubnetId
  }
}

// ---- Shared RDBMS Pools ----
// One shared flexible server per group; passwordless Entra AD auth (authConfig).
// No administratorPassword param — password auth is disabled server-wide. Emitted
// here (foundation stage) too: these are exactly the offer/quota-restricted,
// slow-to-provision resources this stage exists to canary. Pool modules no
// longer accept principalId params — leaf grants reference the app tier
// managed identity, so they belong to the full stage only (below).
module helpdeskTicketServiceTicketDbDevelopmentPool 'modules/helpdesk-ticket-service-ticket-db-development-pool.bicep' = {
  name: 'helpdesk-ticket-service-ticket-db-development-pool'
  params: {
    location: location
    pgDelegatedSubnetId: virtualNetwork.outputs.pgDelegatedSubnetId1
    pgPrivateDnsZoneId: virtualNetwork.outputs.postgresPrivateDnsZoneId
  }
}
module helpdeskKnowledgeServiceKnowledgeDbDevelopmentPool 'modules/helpdesk-knowledge-service-knowledge-db-development-pool.bicep' = {
