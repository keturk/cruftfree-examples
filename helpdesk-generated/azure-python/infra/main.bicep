// azure.context.trusted_caller_backend_audience_module_ref (emitted only under a
// managed gateway). Serialized into ONE dependsOn chain across both sources:
// each Entra module creates a Microsoft.Graph/applications + servicePrincipal
// pair, and concurrent creation of multiple app/SP pairs is a documented
// directory eventual-consistency hazard (Azure/bicep#16811). One-at-a-time
// provisioning avoids that class of race as cheap insurance (a handful of
// modules, a few seconds). The dependsOn is genuine (no output reference links
// the modules), so the no-unnecessary-dependson linter does not flag it.
module identityEntraAppRegistration 'modules/identity/identity-entra-app-registration.bicep' = {
  name: 'identity-entra-app-registration'
  params: {
    environment: environment
  }
}
module machineEntraAppRegistration 'modules/identity/machine-entra-app-registration.bicep' = {
  name: 'machine-entra-app-registration'
  params: {
    environment: environment
  }
  dependsOn: [
    identityEntraAppRegistration
  ]
}
module identityHelpCentreBrowserEntraAppRegistration 'modules/identity/identity-help-centre-browser-entra-app-registration.bicep' = {
  name: 'identity-help-centre-browser-entra-app-registration'
  params: {
    environment: environment
    apiApplicationId: identityEntraAppRegistration.outputs.applicationId
  }
  dependsOn: [
    machineEntraAppRegistration
  ]
}
module identityConsoleBrowserEntraAppRegistration 'modules/identity/identity-console-browser-entra-app-registration.bicep' = {
  name: 'identity-console-browser-entra-app-registration'
  params: {
    environment: environment
    apiApplicationId: identityEntraAppRegistration.outputs.applicationId
  }
  dependsOn: [
    identityHelpCentreBrowserEntraAppRegistration
  ]
}
module trustedCallerBackendAudience 'modules/identity/backend-audience.bicep' = {
  name: 'backend-audience-app-registration'
  params: {
    environment: environment
  }
  dependsOn: [
    identityConsoleBrowserEntraAppRegistration
  ]
}
// A public client this deployment provisions has no id until Graph creates
// the registration; its runtime config names the output below, and the deploy
// script reads it back before any client is given the config.
output IdentityHelpCentreBrowserPublicClientId string = identityHelpCentreBrowserEntraAppRegistration.outputs.applicationId
output IdentityConsoleBrowserPublicClientId string = identityConsoleBrowserEntraAppRegistration.outputs.applicationId
// ---- Static Web Apps (Standard) ----
// One Azure Static Web App per declared frontend App with a resolved
// web.domain -- wired via the static_web_hosting
// domain's appends main_bicep from azure.context.static_web_app_module_refs.
// Standalone: no dependency edge onto the rest of this deployment's
// infrastructure -- the deployment token is read via listSecrets() by the
// deploy script's own swa deploy upload step, never threaded through as a
// Bicep param (static-web-app.bicep.j2's own module comment). Each site's
// default hostname is exported below for the DNS-records artifact.
module helpCentreStaticWebApp 'modules/help-centre-static-web-app.bicep' = {
  name: 'help-centre-static-web-app'
  params: {
    staticSiteName: 'helpdesk-system-help-centre'
    customDomainName: 'help.lanternpost.example.com'
  }
}

output helpCentreStaticWebAppDefaultHostname string = helpCentreStaticWebApp.outputs.staticSiteDefaultHostname
