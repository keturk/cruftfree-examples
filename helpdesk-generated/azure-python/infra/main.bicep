output consoleStaticWebAppDefaultHostname string = consoleStaticWebApp.outputs.staticSiteDefaultHostname
// ---- Post-deployment identity app-setting leaf modules ----
// One leaf module per web app, overlaying onto its target site AFTER the site and
// every referenced identity exists:
//   * the three DI-1/D14 CRUFTFREE_CALLER_* settings (managed gateway only), and
//   * IDENTITY_<PROVIDER>_AUDIENCE_CLIENT_ID — the Entra app registration's
//     deploy-time client-ID GUID, which is the `aud` of the v2 access tokens
//     those registrations issue and so cannot be baked into the static plan.
// Both groups go through ONE module on purpose: two modules declaring the same
// site's sites/config@appsettings child do not merge — the later deployment
// replaces the earlier one's properties.
// These are LEAVES: they hold edges to APIM + peers + the app registrations + the
// target site, but nothing depends on them — so the module graph stays acyclic
// even when peers mutually `use` each other, which would otherwise force a
// BCP080 cycle in the caller's direction.
module helpdeskTicketServiceWebAppTrustedCaller 'modules/trusted-caller-settings.bicep' = {
  name: 'helpdesk-ticket-service-webapp-tc'
  params: {
    webAppName: helpdeskTicketServiceWebApp.outputs.webAppName
    baseAppSettings: helpdeskTicketServiceWebApp.outputs.baseAppSettings
    trustedCallerClientId: trustedCallerBackendAudience.outputs.backendClientId
    trustedCallerExpectedIssuer: '${az.environment().authentication.loginEndpoint}${tenant().tenantId}/v2.0'
    trustedCallerPrincipalIds: join([apiManagement.outputs.apimPrincipalId, helpdeskNoticeServiceWebApp.outputs.principalId], ',')
    identityAudienceSettings: {
      IDENTITY_IDENTITY_AUDIENCE_CLIENT_ID: identityEntraAppRegistration.outputs.applicationId
      IDENTITY_MACHINE_AUDIENCE_CLIENT_ID: machineEntraAppRegistration.outputs.applicationId
    }
  }
}
