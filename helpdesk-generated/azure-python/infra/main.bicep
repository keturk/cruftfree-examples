// ---- Shared deploy-script infrastructure (UAMI + private script storage + file PE) ----
// Instantiated ONCE per stage; consumed by the schema-owner, in-VNet bootstrap and
// secret-seeding deploymentScripts (hoisted out of in-vnet-bootstrap.bicep so
// every deploymentScript reuses the same identity/storage/PE plumbing instead of
// provisioning its own).
module deployScriptInfra 'modules/deploy-script-infra.bicep' = {
  name: 'deploy-script-infra'
  params: {
    location: location
    environment: environment
    privateEndpointSubnetId: virtualNetwork.outputs.storageSubnetId
    vnetId: virtualNetwork.outputs.vnetId
  }
}

// ---- In-VNet bootstrap (seed private App Config + datasource identities) ----
// Deployment script run on the ContainerInstance-delegated subnet, authed as
// the shared deploy-script UAMI. Declared AFTER App Config, the pooled
// Postgres servers, and the web apps so all seed targets exist (the per-service
// managed-identity object-ids are resolved at run time from the deployed App
// Service sites). The deployer never reaches the private data plane.
module bootstrapInVnet 'modules/in-vnet-bootstrap.bicep' = {
  name: 'in-vnet-bootstrap'
  params: {
    location: location
    environment: environment
    appConfigEndpoint: appConfiguration.outputs.endpoint
    appConfigStoreName: appConfiguration.outputs.configStoreName
    containerInstanceSubnetId: virtualNetwork.outputs.containerInstanceSubnetId
    keyVaultName: keyVault.outputs.vaultName
    scriptIdentityId: deployScriptInfra.outputs.identityId
    scriptIdentityPrincipalId: deployScriptInfra.outputs.identityPrincipalId
    scriptIdentityName: deployScriptInfra.outputs.identityName
    scriptStorageAccountName: deployScriptInfra.outputs.storageAccountName
    appInsightsConnectionString: appInsights.outputs.connectionString
  }
  // deployScriptInfra is NOT listed here: its outputs are referenced as params
  // above, so ARM already infers that dependency (no-unnecessary-dependson). The
  // entries below are ordering-only -- the bootstrap reads their deploy-time
  // host/endpoint ARM properties (Redis hostName, Cosmos documentEndpoint, the
  // Foundry workload identity's clientId) or must simply run after them, and
  // none is referenced as a param. The run store declares the schema identities
  // each Postgres block's owner role is created from.
  dependsOn: [
    runStore
    helpdeskTicketServiceTicketDbDevelopmentPool
    helpdeskKnowledgeServiceKnowledgeDbDevelopmentPool
    helpdeskNoticeServiceNoticeDbDevelopmentPool
    helpdeskEmailMockEmailDbDevelopmentPool
    helpdeskTicketServiceWebApp
    helpdeskKnowledgeServiceWebApp
    helpdeskNoticeServiceWebApp
    helpdeskEmailMockWebApp
  ]
}

// ---- Secret-seeding (seed cruftfree-owned KV secrets + App Config keys, gate operator secrets) ----
// Runs LATE, after in-vnet-bootstrap: its required-config gate (_check_config_key)
// must validate the FULLY-SEEDED store, and in-vnet-bootstrap is what bulk-imports
// the authoritative config key-values (resolved endpoints, service base URLs,
// cache hosts) into this same App Configuration store. Gating before that import
// ran would fail every fresh (empty-store) deployment on keys that only
// in-vnet-bootstrap ever writes. Depends on the vault, the App Configuration
// store, its own data-plane grants (KV + App Config), the App Config private
// endpoint (when emitted), the shared deploy-script infra, AND in-vnet-bootstrap
// (for the ordering above). It still never depends on a web app directly --
// running after in-vnet-bootstrap (which itself depends on every web app) is
// sufficient, and is safe because every service resolves its Key Vault/App
// Configuration references lazily at runtime. Consumes appConfigEndpoint so
// its az appconfig calls authenticate via --endpoint/--auth-mode login
// (data-plane), never --name (ARM discovery, which needs the RG Reader /
// App Configuration Data Owner roles that in-vnet-bootstrap grants).
module secretSeeding 'modules/secret-seeding.bicep' = {
  name: 'secret-seeding'
  params: {
    location: location
    environment: environment
    keyVaultName: keyVault.outputs.vaultName
    serviceVaultNames: {
      'helpdesk-notice-service': helpdeskNoticeServiceKeyVault.outputs.vaultName
    }
    appConfigStoreName: appConfiguration.outputs.configStoreName
    appConfigEndpoint: appConfiguration.outputs.endpoint
    scriptIdentityId: deployScriptInfra.outputs.identityId
    scriptIdentityPrincipalId: deployScriptInfra.outputs.identityPrincipalId
    scriptStorageAccountName: deployScriptInfra.outputs.storageAccountName
    containerInstanceSubnetId: virtualNetwork.outputs.containerInstanceSubnetId
  }
  dependsOn: [
    // keyVault and deployScriptInfra are NOT listed: their outputs are referenced
    // as params above, so ARM already infers those dependencies
    // (no-unnecessary-dependson). Only genuine ordering-deps belong here.
    // Must run AFTER in-vnet-bootstrap so the required-config gate below
    // validates the store once bootstrap has imported the authoritative
    // config key-values into it (see module comment above).
    bootstrapInVnet
    // The App Configuration and Key Vault (application and per-service) private
    // endpoints + DNS records must exist before this module's data-plane calls
    // can resolve each store's private IP.
    peKeyvault
    // The App Configuration and Key Vault (application and per-service) private
    // endpoints + DNS records must exist before this module's data-plane calls
    // can resolve each store's private IP.
    peHelpdeskNoticeServiceKeyVault
    // The App Configuration and Key Vault (application and per-service) private
    // endpoints + DNS records must exist before this module's data-plane calls
    // can resolve each store's private IP.
    peAppconfig
  ]
}


// ---- Run store and schema identities ----
// The private store that carries files to and from each RDBMS block's one-shot
// schema workload, one schema identity per block, and the rights the identity
// running the deploy needs to start a run: the run store's blobs, importing the
// run's images into the shared registry, one container group per run in the
// schema-run subnet, and presenting each schema identity. Each schema identity
// pulls its run's images from that registry over its private endpoint.
// The operator is a deploy-time fact, so it arrives as a parameter.
// A block on an external server's schema identity is granted the block's owner
// password in the application vault, so the module deploys after the vault.
module runStore 'modules/run-store.bicep' = {
  name: 'run-store'
  params: {
    location: location
    environment: environment
    operatorPrincipalId: operatorPrincipalId
    operatorPrincipalType: operatorPrincipalType
    schemaRunSubnetId: virtualNetwork.outputs.schemaRunSubnetId
    containerRegistryName: containerRegistry.outputs.acrName
  }
  dependsOn: [
    keyVault
  ]
}
