// Azure Key Vault for helpdesk-system
// Generated by CruftFree. Do not edit manually.
//
// Network posture is PROFILE-DERIVED (data_plane_public), not per-service:
//  * private-by-default -> publicNetworkAccess 'Disabled' + networkAcls Deny.
//    The data plane is reachable only over the private endpoint from inside the
//    VNet; the operator-machine preflight seeds/reads it via that PE.
//  * public-restricted / public -> publicNetworkAccess 'Enabled' + Allow so the
//    operator-machine runtime-requirements preflight can reach the data plane.
//    RBAC (enableRbacAuthorization) remains the guard and 'bypass: AzureServices'
//    is kept in both modes. The private endpoint still exists in every mode for
//    in-VNet consumers; 'Enabled' only ADDS public reachability.

@description('Azure region')
param location string

@description('Vault name: the application vault, or one service\'s private vault (the same module serves both)')
param vaultName string

resource keyVault 'Microsoft.KeyVault/vaults@2023-07-01' = {
  name: vaultName
  location: location
  properties: {
    sku: {
      family: 'A'
      name: 'standard'
    }
    tenantId: subscription().tenantId
    enableRbacAuthorization: true
    // main.bicep resolves notification credentials via
    // notificationCredentialsVault.getSecret(...) at deployment time (an ARM
    // template function, not a data-plane call) -- that resolution requires
    // enabledForTemplateDeployment; without it the deployment fails.
    enabledForTemplateDeployment: true
    enableSoftDelete: true
    softDeleteRetentionInDays: 30
    enablePurgeProtection: null
    publicNetworkAccess: 'Disabled'
    networkAcls: {
      defaultAction: 'Deny'
      bypass: 'AzureServices'
    }
  }
}

output vaultName string = keyVault.name
output vaultUri string = keyVault.properties.vaultUri
