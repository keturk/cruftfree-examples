// Shared deploy-script infrastructure for helpdesk-system.
// Provisions the user-assigned managed identity, the private script-storage
// account, and the Azure Files private endpoint (DNS zone + link + PE + PE-DNS
// group + storage-file RBAC) consumed by EVERY in-VNet deploymentScript (the
// bootstrap seeder and the secret-seeding module). Extracted from
// in-vnet-bootstrap.bicep.j2 so a second deploymentScript reuses the same
// identity/storage/PE plumbing instead of provisioning its own.
// Generated by CruftFree. Do not edit manually.

@description('Azure region')
param location string

@description('Environment name')
param environment string

@description('Resource id of the subnet hosting the script storage file private endpoint')
param privateEndpointSubnetId string

@description('Resource id of the virtual network (for the file private DNS zone link)')
param vnetId string

// User-assigned identity the deploymentScript containers run as. It is the
// single authenticated principal for every seeding step across both scripts.
resource bootstrapIdentity 'Microsoft.ManagedIdentity/userAssignedIdentities@2023-01-31' = {
  name: 'helpdesk-system-bootstrap-${environment}-id'
  location: location
}

// Storage account the deploymentScripts mount for their execution files. Kept
// minimal; only the bootstrap identity uses it. The name is a fixed 'boot'
// prefix + a 13-char uniqueString() (lowercase alphanumeric), so it is always
// 17 chars — provably within the 3..24 storage-name bounds (no BCP334) and
// unique per resource group + environment.
//
// A VNet-injected deployment script (containerSettings.subnetIds) cannot mount a
// public storage account — Azure rejects it with
// DeploymentScriptStorageAccountWithServiceEndpointEnabled. The mounted storage
// must be private: publicNetworkAccess Disabled + a Deny firewall with the
// AzureServices bypass, reached over a `file` private endpoint, with the script
// identity granted Storage File Data Privileged Contributor (all wired below).
resource scriptStorage 'Microsoft.Storage/storageAccounts@2023-01-01' = {
  name: 'boot${uniqueString(resourceGroup().id, 'helpdesk-system', environment)}'
  location: location
  sku: {
    name: 'Standard_LRS'
  }
  kind: 'StorageV2'
  properties: {
    minimumTlsVersion: 'TLS1_2'
    allowBlobPublicAccess: false
    // MUST stay true, and it is a platform constraint rather than a preference:
    // the ONLY way to mount a storage account in an Azure Container Instance is
    // via an account key, so the deploymentScript service's requirements for an
    // existing storage account state `allowSharedKeyAccess` must be true
    // (Microsoft Learn, "Use an existing storage account"). The Storage File
    // Data Privileged Contributor grant below covers the SERVICE's own
    // identity-authenticated share management; it does not replace the mount.
    //
    // Setting this to false does not fail fast -- ARM accepts the template, the
    // container group is created and then never leaves 'Creating' because the
    // volume cannot be attached, and the deployment dies ~20 minutes later with
    // DeploymentScriptACIProvisioningTimeout and no ACI error of its own. That
    // is exactly what it did.
    //
    // The key is never authored, passed, output, or read by this template --
    // the script service fetches it. The account is reachable only through the
    // `file` private endpoint below (publicNetworkAccess Disabled + a Deny
    // firewall), holds nothing but deployment-script scratch files, and its
    // keys are therefore not a credential anyone can reach from outside the
    // VNet. That is the most secure configuration compatible with the mount.
    allowSharedKeyAccess: true
    publicNetworkAccess: 'Disabled'
    networkAcls: {
      defaultAction: 'Deny'
      bypass: 'AzureServices'
    }
  }
}

// Private DNS zone + file private endpoint so the in-VNet ACI mounts the script
// storage file share over the private network. No other resource uses Azure
// Files, so this zone is created here (the module stays self-contained).
resource scriptStorageFileDnsZone 'Microsoft.Network/privateDnsZones@2024-06-01' = {
  name: 'privatelink.file.${az.environment().suffixes.storage}'
  location: 'global'
}

resource scriptStorageFileDnsLink 'Microsoft.Network/privateDnsZones/virtualNetworkLinks@2024-06-01' = {
  parent: scriptStorageFileDnsZone
  name: 'boot-file-link-${environment}'
  location: 'global'
  properties: {
    registrationEnabled: false
    virtualNetwork: {
      id: vnetId
    }
  }
}

resource scriptStorageFilePe 'Microsoft.Network/privateEndpoints@2023-11-01' = {
  name: '${scriptStorage.name}-file-pe'
  location: location
  properties: {
    subnet: {
      id: privateEndpointSubnetId
    }
    privateLinkServiceConnections: [
      {
        name: 'file'
        properties: {
          privateLinkServiceId: scriptStorage.id
          groupIds: [
            'file'
          ]
        }
      }
    ]
  }
}

resource scriptStorageFilePeDns 'Microsoft.Network/privateEndpoints/privateDnsZoneGroups@2023-11-01' = {
  parent: scriptStorageFilePe
  name: 'default'
  properties: {
    privateDnsZoneConfigs: [
      {
        name: 'config'
        properties: {
          privateDnsZoneId: scriptStorageFileDnsZone.id
        }
      }
    ]
  }
}

// Storage File Data Privileged Contributor — required for the deploymentScript
// managed identity to mount the file share over the private endpoint.
var storageFileDataPrivilegedContributorRoleId = '69566ab7-960f-475b-8e7c-b3118f30c6bd'

resource scriptStorageFileRbac 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  scope: scriptStorage
  name: guid(scriptStorage.id, bootstrapIdentity.id, storageFileDataPrivilegedContributorRoleId)
  properties: {
    roleDefinitionId: subscriptionResourceId(
      'Microsoft.Authorization/roleDefinitions',
      storageFileDataPrivilegedContributorRoleId
    )
    principalId: bootstrapIdentity.properties.principalId
    principalType: 'ServicePrincipal'
  }
}

output identityId string = bootstrapIdentity.id
output identityPrincipalId string = bootstrapIdentity.properties.principalId
output identityName string = bootstrapIdentity.name
output storageAccountName string = scriptStorage.name
output fileRbacName string = scriptStorageFileRbac.name
