// API Management gateway custom-domain TLS certificate store for helpdesk-system
// Generated by CruftFree. Do not edit manually.
//
// Deployed by scripts/deploy.py as its own stage, BEFORE the infrastructure
// deployment that creates API Management -- never as part of it. Both reasons
// are ordering facts API Management enforces while it applies a Key
// Vault-backed hostname:
//   1. The certificate must already be in this vault. The operator imports it
//      between this stage and the next; the deploy script refuses to continue
//      until it is present.
//   2. The identity API Management reads it with must already hold its role.
//      A system-assigned identity only exists once API Management does, so it
//      can never be granted in time -- the user-assigned identity below is
//      created and granted here, one stage earlier.
//
// Holds ONLY TLS certificates, never an application secret: the identity is
// granted Key Vault Secrets User on THIS vault alone (API Management requires
// list + get secrets on the vault containing the certificate, a vault-scope
// grant), never the application secrets vault, the resource group or the
// subscription.
//
// Both names are literals computed and validated at generation time for this
// profile's environment -- the same literals API Management's references and
// the deploy script carry.

@description('Azure region')
param location string

resource tlsCertificateVault 'Microsoft.KeyVault/vaults@2023-07-01' = {
  name: 'help-bb7aa3f3-tls-kv-dev'
  location: location
  properties: {
    sku: {
      family: 'A'
      name: 'standard'
    }
    tenantId: subscription().tenantId
    enableRbacAuthorization: true
    enableSoftDelete: true
    // ON, unlike the application secrets vault: a purged certificate is a
    // production outage for every custom domain bound to it, and this vault
    // holds nothing else to weigh against that. A torn-down environment's
    // vault is therefore RECOVERED on the next deploy (with its certificate),
    // never purged.
    enablePurgeProtection: true
    softDeleteRetentionInDays: 90
    publicNetworkAccess: 'Disabled'
    networkAcls: {
      defaultAction: 'Deny'
      bypass: 'AzureServices'
    }
  }
}

// The identity API Management reads the certificate with -- used for nothing
// else, so it carries this one grant and no other.
resource tlsCertificateReader 'Microsoft.ManagedIdentity/userAssignedIdentities@2023-01-31' = {
  name: 'helpdesk-system-apim-tls-id-dev'
  location: location
}

// Named from resource ids only: a role assignment's name must be computable
// when the deployment starts, which a principal id never is.
resource tlsCertificateReaderRole 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  scope: tlsCertificateVault
  name: guid(tlsCertificateVault.id, tlsCertificateReader.id, '4633458b-17de-408a-b874-0445c86b69e6')
  properties: {
    roleDefinitionId: subscriptionResourceId(
      'Microsoft.Authorization/roleDefinitions',
      '4633458b-17de-408a-b874-0445c86b69e6'
    )
    principalId: tlsCertificateReader.properties.principalId
    principalType: 'ServicePrincipal'
  }
}

output vaultName string = tlsCertificateVault.name
output vaultUri string = tlsCertificateVault.properties.vaultUri
output readerIdentityName string = tlsCertificateReader.name
