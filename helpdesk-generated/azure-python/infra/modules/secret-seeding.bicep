// Secret-seeding deploymentScript for helpdesk-system.
// Runs inside the VNet (delegated Microsoft.ContainerInstance subnet), authed as
// the shared deploy-script user-assigned managed identity (from
// deploy-script-infra), to seed cruftfree-owned secrets into Key
// Vault and verify/seed required App Configuration keys. Grants the shared
// identity Key Vault Secrets Officer on the vault's data plane (secrets) AND
// App Configuration Data Owner on the store's data plane (config keys) so it
// can create/update both, with no ARM-visible role needed this early.
//
// This module runs LATE, after in-vnet-bootstrap.bicep: main.bicep's
// dependsOn for this module includes in-vnet-bootstrap (in addition to Key
// Vault + its own KV grant, the App Configuration store + its own App
// Configuration Data Owner grant, and the shared script infra), because the
// required-config gate below (``_check_config_key``) must validate the
// FULLY-SEEDED store -- in-vnet-bootstrap is what bulk-imports the
// authoritative config key-values (resolved endpoints, service base URLs,
// cache hosts) into this same App Configuration store. Gating before that
// import ran would fail every fresh (empty-store) deployment. Running after
// in-vnet-bootstrap (which itself depends on every web app) is safe because
// every service resolves its Key Vault / App Configuration references
// lazily at runtime -- this module never depends on a web app directly.
// Every ``az appconfig`` call below uses
// ``--endpoint``/``--auth-mode login`` (data-plane auth), NEVER ``--name``
// (which resolves the store through ARM and requires an ARM-visible role --
// RG Reader + App Configuration Data Owner -- that those ARM grants,
// declared in in-vnet-bootstrap.bicep, provide). scriptContent is DATA-DRIVEN from the
// same runtime-requirements manifest that fed the (now-superseded)
// operator-side preflight: JWT keypair generate-if-missing,
// owned-secret generate-if-missing, the operator-secret fail-closed gate, and
// the required-config/required-secret gate. Every gap increments one shared
// counter and the script exits nonzero at the end, failing the ARM deployment
// after reporting EVERY unsatisfied requirement rather than only the first.
// Generated by CruftFree. Do not edit manually.

@description('Azure region')
param location string

@description('Environment name')
param environment string

@description('Name of the Key Vault the seeder writes cruftfree-owned secrets into and verifies operator-owned secrets against')
param keyVaultName string

@description('Names of the per-service Key Vaults, keyed by service kebab name; the seeder writes each service-private secret into its own service vault')
param serviceVaultNames object

@description('Name of the private App Configuration store the seeder verifies required config keys against (unused when the manifest carries no config-key items)')
param appConfigStoreName string

@description('Endpoint URL of the private App Configuration store, used for data-plane --endpoint/--auth-mode login calls (unused when the manifest carries no config-key items)')
param appConfigEndpoint string

@description('Resource id of the deploy-script UAMI (from deploy-script-infra)')
param scriptIdentityId string

@description('Principal id of the deploy-script UAMI')
param scriptIdentityPrincipalId string

@description('Name of the private script-storage account')
param scriptStorageAccountName string

@description('Resource id of the ContainerInstance-delegated subnet for in-VNet execution')
param containerInstanceSubnetId string

// Key Vault Secrets Officer -- lets the UAMI create/update secrets over the data plane.
var keyVaultSecretsOfficerRoleId = 'b86a8fe4-44ce-4948-aee5-eccb2c155cd7'

// App Configuration Data Owner -- lets the UAMI create/update config key-values
// over the data plane (--auth-mode login). Same role id / guid() inputs as
// in-vnet-bootstrap.bicep's grant on the same store, so both modules converge
// on the SAME idempotent roleAssignment resource rather than colliding.
var appConfigDataOwnerRoleId = '5ae67dd6-50cb-40e7-96ff-dc2bfa4b606b'

resource keyVault 'Microsoft.KeyVault/vaults@2023-07-01' existing = {
  name: keyVaultName
}

resource appConfigStore 'Microsoft.AppConfiguration/configurationStores@2023-03-01' existing = {
  name: appConfigStoreName
}

// Private vault of service 'helpdesk-notice-service': the seeder writes that service's own secrets here.
resource serviceVault0 'Microsoft.KeyVault/vaults@2023-07-01' existing = {
  name: serviceVaultNames['helpdesk-notice-service']
}

resource seederServiceVault0SecretsOfficer 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  scope: serviceVault0
  name: guid(serviceVault0.id, scriptIdentityId, keyVaultSecretsOfficerRoleId)
  properties: {
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', keyVaultSecretsOfficerRoleId)
    principalId: scriptIdentityPrincipalId
    principalType: 'ServicePrincipal'
  }
}


resource seederKvSecretsOfficer 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  scope: keyVault
  name: guid(keyVault.id, scriptIdentityId, keyVaultSecretsOfficerRoleId)
  properties: {
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', keyVaultSecretsOfficerRoleId)
    principalId: scriptIdentityPrincipalId
    principalType: 'ServicePrincipal'
  }
}

resource seederAppConfigDataOwner 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  scope: appConfigStore
  name: guid(appConfigStore.id, scriptIdentityId, appConfigDataOwnerRoleId)
  properties: {
    roleDefinitionId: subscriptionResourceId(
      'Microsoft.Authorization/roleDefinitions',
      appConfigDataOwnerRoleId
    )
    principalId: scriptIdentityPrincipalId
    principalType: 'ServicePrincipal'
  }
}

resource secretSeeding 'Microsoft.Resources/deploymentScripts@2023-08-01' = {
  name: 'helpdesk-system-secret-seeding-${environment}'
  location: location
  kind: 'AzureCLI'
  identity: {
    type: 'UserAssigned'
    userAssignedIdentities: {
      '${scriptIdentityId}': {}
    }
  }
  dependsOn: [
    // Seeder runs LATE, after in-vnet-bootstrap (see main.bicep's dependsOn on
    // this module and the header comment above): it waits on the vault + its
    // own KV grant, the App Configuration store + its own App Configuration
    // Data Owner grant, and the shared script infra. It does NOT depend
    // directly on any web app -- apps resolve secrets/config lazily at
    // runtime, and running after in-vnet-bootstrap (which does depend on
    // every web app) is what lets the required-config gate below validate
    // the fully-seeded store.
    seederKvSecretsOfficer
    seederAppConfigDataOwner
    seederServiceVault0SecretsOfficer
  ]
  properties: {
    azCliVersion: '2.62.0'
    retentionInterval: 'PT1H'
    timeout: 'PT30M'
    storageAccountSettings: {
      storageAccountName: scriptStorageAccountName
    }
    containerSettings: {
      subnetIds: [
        {
          id: containerInstanceSubnetId
        }
      ]
    }
    environmentVariables: [
      {
        name: 'KV_VAULT_NAME'
        value: keyVaultName
      }
      {
        name: 'KV_SERVICE_0'
        value: serviceVault0.name
      }
      {
        name: 'APP_CONFIG_STORE_NAME'
        value: appConfigStoreName
      }
      {
        name: 'APP_CONFIG_ENDPOINT'
        value: appConfigEndpoint
      }
    ]
    scriptContent: '''
      set -euo pipefail

      # --- Failure gate: EVERY unsatisfied requirement -- a required config
      # key, a cruftfree-owned secret, or an operator-owned secret with no usable
      # value -- increments this counter, driving a final nonzero exit that
      # fails the ARM deployment. Aggregating rather than exiting on the first
      # gap means ONE deployment run reports every value an operator must set.
      _required_gap_count=0
      _fail() {
        echo "SECRET-SEEDING FAIL: $1" >&2
        _required_gap_count=$((_required_gap_count + 1))
      }

      _appconfig_value_present() {
        # Returns 0 when a value exists for key+label, 1 otherwise. Value is read
        # for presence only and is never printed.
        local _key="$1" _label="$2"
        az appconfig kv show \
          --endpoint "${APP_CONFIG_ENDPOINT}" \
          --auth-mode login \
          --key "${_key}" \
          --label "${_label}" \
          --query value --output tsv >/dev/null 2>&1
      }

      _keyvault_secret_ready() {
        # Returns 0 when the secret exists, is enabled, not expired, and
        # non-empty. The value is checked for emptiness only and is never
        # printed.
        # $1=vault name $2=secret name
        local _vault="$1" _name="$2"
        local _json _err
        _err="$(mktemp)"
        if ! _json="$(az keyvault secret show \
          --vault-name "${_vault}" \
          --name "${_name}" \
          --query '{enabled: attributes.enabled, expires: attributes.expires, len: length(value)}' \
          --output json --only-show-errors 2>"${_err}")"; then
          # A not-yet-created secret is the EXPECTED input to every
          # generate-if-missing path and to the operator-secret gate, which
          # reports its own actionable message. Echoing the CLI's not-found
          # error would emit one benign ERROR line per handle -- and ARM
          # reports a failed deploymentScript's FIRST stderr line as the
          # deployment's root cause, so that noise masks the real failures.
          # Any OTHER failure (denied, throttled, vault unreachable) is still
          # surfaced verbatim, because it is NOT an expected outcome here.
          grep -q 'SecretNotFound' "${_err}" || cat "${_err}" >&2
          rm -f "${_err}"
          return 1
        fi
        rm -f "${_err}"
        local _enabled _expires _len
        _enabled="$(echo "${_json}" | python3 -c 'import sys,json;print(json.load(sys.stdin)["enabled"])' || echo "")"
        _len="$(echo "${_json}" | python3 -c 'import sys,json;print(json.load(sys.stdin)["len"] or 0)' || echo "0")"
        _expires="$(echo "${_json}" | python3 -c 'import sys,json;print(json.load(sys.stdin)["expires"] or "")' || echo "")"
        if [ "${_enabled}" != "True" ]; then
          return 1
        fi
        if [ "${_len}" -eq 0 ]; then
          return 1
        fi
        if [ -n "${_expires}" ]; then
          local _now
          _now="$(date -u +%s)"
          local _exp_epoch
          _exp_epoch="$(date -u -d "${_expires}" +%s 2>/dev/null || echo 0)"
          if [ "${_exp_epoch}" -ne 0 ] && [ "${_exp_epoch}" -le "${_now}" ]; then
            return 1
          fi
        fi
        return 0
      }

      # --- Per-requirement processors. The seeding work is factored into these
      # fixed functions (defined once) so each requirement below is a single
      # call. Unrolling a full bash block per requirement made scriptContent
      # grow O(requirements) and overflowed ARM's 131072-char expression-literal
      # limit on large systems; the calls keep it O(requirements) in SHORT lines
      # while this constant-size logic is emitted just once.
      _seed_config_default() {
        # $1=platform_name $2=label $3=logical_name $4=value; $5.. = extra az flags
        local _pn="$1" _lbl="$2" _ln="$3" _val="$4"; shift 4
        if _appconfig_value_present "$_pn" "$_lbl"; then
          echo "config key '$_ln' present (label='$_lbl'); preserving existing value."
        else
          echo "config key '$_ln' missing (label='$_lbl'); seeding declared default."
          # --only-show-errors: seeding a feature-flag key (".appconfig.featureflag/...")
          # through the generic key-value command makes the CLI emit an advisory
          # WARNING on stderr. ARM scrapes a failed deploymentScript's stderr and
          # reports its FIRST line as the deployment's root cause, so an unsuppressed
          # advisory masks the real failure reported further down.
          az appconfig kv set \
            --endpoint "${APP_CONFIG_ENDPOINT}" \
            --auth-mode login \
            --key "$_pn" \
            --label "$_lbl" \
            "$@" \
            --value "$_val" \
            --only-show-errors \
            --yes >/dev/null \
            || _fail "could not seed config key '$_ln' (rendered '$_pn', label '$_lbl'). Fix: grant App Configuration Data Owner to the deploy-script identity."
        fi
      }

      _check_config_key() {
        # $1=platform_name $2=label $3=logical_name
        if ! _appconfig_value_present "$1" "$2"; then
          _fail "required config key '$3' (rendered '$1', label '$2') has no value and no default. Fix: set this key in App Configuration for label '$2' before deploying."
        fi
      }

      _seed_keypair() {
        # $1=vault name $2=logical_name $3=private_platform_name $4=public_platform_name
        local _vault="$1" _ln="$2" _priv_name="$3" _pub_name="$4"
        # generate-if-missing, never overwrite: an operator-supplied key is preserved.
        if _keyvault_secret_ready "$_vault" "$_pub_name"; then
          echo "keypair '$_ln' present; preserving existing key."
        else
          local _priv _pub
          # python3 and its 'cryptography' package ship with the azure-cli
          # image (the CLI runs on them), so nothing is installed: the script
          # that generates secrets fetches no third-party artifact. RSA-3072,
          # exponent 65537; PKCS8 private PEM, SubjectPublicKeyInfo public PEM.
          _priv="$(python3 -c 'import sys; from cryptography.hazmat.primitives import serialization as s; from cryptography.hazmat.primitives.asymmetric import rsa; sys.stdout.write(rsa.generate_private_key(public_exponent=65537, key_size=3072).private_bytes(s.Encoding.PEM, s.PrivateFormat.PKCS8, s.NoEncryption()).decode())')" \
            || { echo "ERROR: RSA private key generation (python3 cryptography) failed for keypair '$_ln' (rendered '$_priv_name')" >&2; exit 1; }
          _pub="$(printf '%s\n' "$_priv" | python3 -c 'import sys; from cryptography.hazmat.primitives import serialization as s; sys.stdout.write(s.load_pem_private_key(sys.stdin.buffer.read(), password=None).public_key().public_bytes(s.Encoding.PEM, s.PublicFormat.SubjectPublicKeyInfo).decode())')" \
            || { echo "ERROR: RSA public key derivation (python3 cryptography) failed for keypair '$_ln' (rendered '$_pub_name')" >&2; exit 1; }
          az keyvault secret set --vault-name "$_vault" --name "$_priv_name" --value "$_priv" \
            --tags "cruftfree:provisioned-by=cruftfree" -o none \
            || _fail "could not write keypair private half '$_ln' (rendered '$_priv_name'). Fix: grant Key Vault Secrets Officer to the deploy-script identity."
          az keyvault secret set --vault-name "$_vault" --name "$_pub_name" --value "$_pub" \
            --tags "cruftfree:provisioned-by=cruftfree" -o none \
            || _fail "could not write keypair public half '$_ln' (rendered '$_pub_name'). Fix: grant Key Vault Secrets Officer to the deploy-script identity."
          unset _priv _pub
        fi
      }

      _seed_owned_secret() {
        # $1=vault name $2=logical_name $3=platform_name
        local _vault="$1" _ln="$2" _pn="$3"
        if _keyvault_secret_ready "$_vault" "$_pn"; then
          echo "cruftfree-owned secret '$_ln' already present and valid; preserving existing value."
        else
          if az keyvault secret show --vault-name "$_vault" --name "$_pn" >/dev/null 2>&1; then
            _fail "cruftfree-owned secret '$_ln' (rendered '$_pn') exists but is disabled/expired/empty. Fix: re-run secret-seeding with rotate/repair to replace it, or remove the broken version."
          else
            echo "cruftfree-owned secret '$_ln' missing; generating a strong value once."
            local _generated
            _generated="$(python3 -c 'import base64, secrets; print(base64.b64encode(secrets.token_bytes(48)).decode())')" \
              || { echo "ERROR: random value generation (python3 secrets) failed for secret '$_ln' (rendered '$_pn')" >&2; exit 1; }
            az keyvault secret set \
              --vault-name "$_vault" \
              --name "$_pn" \
              --value "${_generated}" \
              --tags "cruftfree:provisioned-by=cruftfree" >/dev/null \
              || _fail "could not write generated secret '$_ln' (rendered '$_pn'). Fix: grant Key Vault Secrets Officer to the deploy-script identity."
            unset _generated
          fi
        fi
      }

      _seed_cipher_key() {
        # $1=vault name $2=logical_name $3=platform_name
        # The field cipher key of a database block that stores an encrypted field: 32 random
        # bytes as unpadded base64url, the format the services' cipher reads. Generated
        # once and NEVER replaced: a replaced key leaves every value stored under it
        # unreadable, so a key that exists but is unusable fails the deployment instead
        # of being repaired here.
        local _vault="$1" _ln="$2" _pn="$3"
        if _keyvault_secret_ready "$_vault" "$_pn"; then
          echo "cruftfree-owned cipher key '$_ln' already present and valid; preserving existing value."
        else
          if az keyvault secret show --vault-name "$_vault" --name "$_pn" >/dev/null 2>&1; then
            _fail "cruftfree-owned cipher key '$_ln' (rendered '$_pn') exists but is disabled/expired/empty. Values stored under it are unreadable without it, so it is never replaced here. Fix: restore or re-enable the key's last good version."
          else
            echo "cruftfree-owned cipher key '$_ln' missing; generating it once."
            local _generated
            _generated="$(python3 -c 'import secrets; print(secrets.token_urlsafe(32))')" \
              || { echo "ERROR: random key generation (python3 secrets) failed for cipher key '$_ln' (rendered '$_pn')" >&2; exit 1; }
            az keyvault secret set \
              --vault-name "$_vault" \
              --name "$_pn" \
              --value "${_generated}" \
              --tags "cruftfree:provisioned-by=cruftfree" >/dev/null \
              || _fail "could not write generated cipher key '$_ln' (rendered '$_pn'). Fix: grant Key Vault Secrets Officer to the deploy-script identity."
            unset _generated
          fi
        fi
      }

      _check_operator_secret() {
        # $1=vault name $2=logical_name $3=platform_name $4=owning_integration $5=effect
        # Fail-closed, and NEVER writes: CruftFree cannot produce a third-party
        # credential, and seeding a stand-in value would let this deployment
        # report success while the integration is dead. A usable value is
        # preserved untouched; anything else (missing / disabled / expired /
        # empty) increments the shared gap counter with the effect and the exact
        # command that sets the real value, so the run reports every gap before
        # failing.
        local _vault="$1" _ln="$2" _pn="$3" _integration="$4" _effect="$5"
        if _keyvault_secret_ready "$_vault" "$_pn"; then
          echo "operator secret '$_ln' present."
        else
          _fail "operator-owned secret '$_ln' (rendered '$_pn', integration '$_integration') has no usable value in Key Vault '${_vault}'. CruftFree never writes a value into an operator-owned secret."
          echo "    effect: ${_effect}" >&2
          echo "    fix:    az keyvault secret set --vault-name ${_vault} --name ${_pn} --value <REAL_VALUE>" >&2
        fi
      }

      _report_optional_secret() {
        # $1=vault name $2=logical_name $3=platform_name $4=owning_integration $5=effect
        # An operator-owned handle the author declared 'required = false'.
        # Reported, never fatal, and NEVER written: the author has stated this
        # deployment is expected to run (degraded) without the value, so the gap
        # counter is deliberately untouched -- gating here would enforce a
        # requirement the application definition explicitly waived. The message
        # still carries the effect and the exact command, so an operator who DOES
        # have the value knows how to supply it.
        local _vault="$1" _ln="$2" _pn="$3" _integration="$4" _effect="$5"
        if _keyvault_secret_ready "$_vault" "$_pn"; then
          echo "optional operator secret '$_ln' present."
        else
          echo "SECRET-SEEDING NOTICE: optional operator-owned secret '$_ln' (rendered '$_pn', integration '$_integration') has no usable value in Key Vault '${_vault}'. Declared 'required = false', so this does NOT fail the deployment."
          echo "    effect: ${_effect}"
          echo "    to supply it: az keyvault secret set --vault-name ${_vault} --name ${_pn} --value <REAL_VALUE>"
        fi
      }

      _require_platform_secret() {
        # $1=vault name $2=logical_name $3=platform_name
        # A secret this deployment's own Bicep writes from the resource it
        # deploys (a connection string or account key read back with
        # listKeys()). Verified, NEVER written and never asked of the operator:
        # a generated or hand-set stand-in would replace the resource's real
        # value. Absent means the writing module did not run or did not write
        # it -- a deployment defect, counted as a gap so the run fails closed.
        local _vault="$1" _ln="$2" _pn="$3"
        if _keyvault_secret_ready "$_vault" "$_pn"; then
          echo "platform-written secret '$_ln' present."
        else
          _fail "platform-written secret '$_ln' (rendered '$_pn') has no usable value in Key Vault '${_vault}'. This deployment's Bicep writes it from the resource it provisions; re-run the deployment and check the module that writes '${_pn}'. CruftFree never generates a value for it and an operator must not set one."
        fi
      }

      echo "CruftFree secret-seeding: 21 config requirement(s), 1 keypair(s), 1 secret handle(s)."

      # RBAC-propagation probe: the App Configuration Data Owner grant above
      # can take several minutes to become effective on the data plane even
      # after ARM reports the roleAssignment as succeeded. Retry a cheap
      # authenticated read BEFORE the first real seeding call below so a
      # not-yet-propagated grant fails loud with ONE actionable message
      # instead of cascading into a confusing per-key failure for every
      # config requirement.
      _appconfig_rbac_ready=0
      _appconfig_probe_attempt=1
      while [ "${_appconfig_probe_attempt}" -le 30 ]; do
        if az appconfig kv list --endpoint "${APP_CONFIG_ENDPOINT}" --auth-mode login --top 1 -o none >/dev/null 2>&1; then
          _appconfig_rbac_ready=1
          break
        fi
        sleep 10
        _appconfig_probe_attempt=$((_appconfig_probe_attempt + 1))
      done
      if [ "${_appconfig_rbac_ready}" -ne 1 ]; then
        echo "SECRET-SEEDING FAIL: App Configuration store '${APP_CONFIG_STORE_NAME}' is still unreachable over the data plane after 30 attempts (~5 minutes). The deploy-script identity requires the 'App Configuration Data Owner' role on this store -- RBAC propagation can take several minutes after the grant becomes an ARM success; re-running this deployment may resolve a transient delay." >&2
        exit 1
      fi

      _seed_config_default "connections:email_db_database" "local" "email_db_database" '"helpdesk_email_mock"'
      _check_config_key "connections:email_db_host" "local" "email_db_host"
      _seed_config_default "connections:email_db_port" "local" "email_db_port" '5432'
      _check_config_key "connections:email_db_user" "local" "email_db_user"
      _seed_config_default "connections:email_provider_base_url" "local" "email_provider_base_url" '"http://helpdesk-email-mock:8091"'
      _check_config_key "connections:helpdesk_ticket_service_base_url" "local" "helpdesk_ticket_service_base_url"
      _seed_config_default "connections:knowledge_db_database" "local" "knowledge_db_database" '"helpdesk_knowledge"'
      _check_config_key "connections:knowledge_db_host" "local" "knowledge_db_host"
      _seed_config_default "connections:knowledge_db_port" "local" "knowledge_db_port" '5432'
      _check_config_key "connections:knowledge_db_user" "local" "knowledge_db_user"
      _check_config_key "connections:mq_brokers" "local" "mq_brokers"
      _seed_config_default "connections:notice_db_database" "local" "notice_db_database" '"helpdesk_notice"'
      _check_config_key "connections:notice_db_host" "local" "notice_db_host"
      _seed_config_default "connections:notice_db_port" "local" "notice_db_port" '5432'
      _check_config_key "connections:notice_db_user" "local" "notice_db_user"
      _seed_config_default "connections:ticket_db_database" "local" "ticket_db_database" '"helpdesk_ticket"'
      _check_config_key "connections:ticket_db_host" "local" "ticket_db_host"
      _seed_config_default "connections:ticket_db_port" "local" "ticket_db_port" '5432'
      _check_config_key "connections:ticket_db_user" "local" "ticket_db_user"
      _check_config_key "connections:tracing_connection_string" "local" "tracing_connection_string"
      _seed_config_default "settings:debugMode" "local" "debugMode" 'false'

      _seed_keypair "$KV_VAULT_NAME" "jwt-keypair" "jwt-private-key" "jwt-public-key"

      _check_operator_secret "$KV_SERVICE_0" "email_provider_api_key" "email-provider-api-key" "email_provider_api_key" "API key for the email vendor (EmailProvider contract)."

      if [ "${_required_gap_count}" -ne 0 ]; then
        echo "SECRET SEEDING FAILED: ${_required_gap_count} requirement(s) unsatisfied -- each is listed above with its effect and the exact command that fixes it. No secret VALUE is ever printed." >&2
        exit 1
      fi

      echo "CruftFree secret-seeding: all requirements satisfied."
    '''
  }
}

output secretSeedingName string = secretSeeding.name
