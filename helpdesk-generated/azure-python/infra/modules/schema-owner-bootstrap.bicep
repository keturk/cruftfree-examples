        text = certificate.decode("ascii").strip()
        return ssl.DER_cert_to_PEM_cert(ssl.PEM_cert_to_DER_cert(text)).strip()
    if certificate.startswith(_DER_SEQUENCE):
        return ssl.DER_cert_to_PEM_cert(certificate).strip()
    raise ValueError("it starts with neither a PEM certificate header nor a DER sequence")


def ca_bundle_pem(certificates: Sequence[bytes], failure: Callable[[str], Exception]) -> bytes:
    """*certificates*, each PEM or DER as its publisher serves it, as one PEM bundle.

    Raises:
        Exception: *failure*'s, when there is none, or one is neither a PEM nor a DER
            certificate.
    """
    if not certificates:
        raise failure("The CA bundle names no certificate; name at least one root to fetch.")
    blocks: list[str] = []
    for index, certificate in enumerate(certificates, start=1):
        try:
            blocks.append(_pem_certificate(certificate))
        except (UnicodeDecodeError, ValueError) as error:
            raise failure(
                f"CA certificate {index} of the bundle is not a certificate ({error}). "
                "Expected a PEM or DER X.509 certificate from its publisher."
            ) from error
    return ("\n".join(blocks) + "\n").encode("ascii")


def fetch_ca_bundle(urls: Sequence[str], destination: Path, failure: Callable[[str], Exception]) -> None:
    """Fetch every root certificate of *urls* over verified HTTPS and write them to *destination*,
    a file that must not exist yet.

    Raises:
        Exception: *failure*'s, when a URL is not HTTPS, a download fails, or what it served
            is not a certificate.
