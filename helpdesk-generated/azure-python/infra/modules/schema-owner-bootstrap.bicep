    with destination.open("xb") as handle:
        handle.write(bundle)


def write_ca_bundle(arguments: Sequence[str]) -> None:
    """Fetch the roots named after the bundle's file in *arguments* (``<file> <url>...``) into
    that file, as :func:`fetch_ca_bundle` does.

    Raises:
        CaBundleError: The arguments name no file or no URL, or as :func:`fetch_ca_bundle`.
    """
    if len(arguments) < 2:
        raise CaBundleError(f"Expected the bundle's file and at least one root URL, got {list(arguments)}.")
    destination, *urls = arguments
    fetch_ca_bundle(urls, Path(destination), CaBundleError)


