import sys
import urllib.request
from collections.abc import Callable, Sequence
from pathlib import Path

#: Seconds one CA certificate download may take.
CA_CERTIFICATE_FETCH_SECONDS: float = 30.0

#: The exit status of :func:`run_ca_bundle_fetch` when no bundle could be written.
CA_BUNDLE_FAILURE_STATUS: int = 2

_PEM_BEGIN: bytes = b"-----BEGIN CERTIFICATE-----"
_DER_SEQUENCE: bytes = b"\x30"
_HTTPS: str = "https://"


class CaBundleError(Exception):
    """No CA bundle could be written; the message names what to fix."""


def _pem_certificate(certificate: bytes) -> str:
    """*certificate*, PEM or DER as its publisher serves it, as one PEM block.

    Raises:
        ValueError: It is neither a PEM nor a DER X.509 certificate.
    """
