resource vnet 'Microsoft.Network/virtualNetworks@2023-11-01' = {
  name: 'helpdesk-system-vnet-${environment}'
  location: location
  properties: {
    addressSpace: {
      addressPrefixes: [
        vnetAddressPrefix
      ]
    }
    subnets: [
      {
        name: 'apps'
        properties: {
          addressPrefix: appsSubnetPrefix
          networkSecurityGroup: {
            id: defaultNsg.id
          }
        }
      }
      {
        name: 'database'
        properties: {
          addressPrefix: databaseSubnetPrefix
          privateEndpointNetworkPolicies: 'Disabled'
          networkSecurityGroup: {
            id: databaseNsg.id
          }
        }
      }
      {
        name: 'cache'
        properties: {
          addressPrefix: cacheSubnetPrefix
          privateEndpointNetworkPolicies: 'Disabled'
          networkSecurityGroup: {
            id: defaultNsg.id
          }
        }
      }
      {
        name: 'messaging'
        properties: {
          addressPrefix: messagingSubnetPrefix
          privateEndpointNetworkPolicies: 'Disabled'
          networkSecurityGroup: {
            id: messagingNsg.id
          }
        }
      }
      {
        name: 'storage'
        properties: {
          addressPrefix: storageSubnetPrefix
          privateEndpointNetworkPolicies: 'Disabled'
          networkSecurityGroup: {
            id: defaultNsg.id
          }
        }
      }
      {
        name: 'keyvault'
        properties: {
          addressPrefix: keyvaultSubnetPrefix
          privateEndpointNetworkPolicies: 'Disabled'
          networkSecurityGroup: {
            id: defaultNsg.id
          }
        }
      }
      {
        name: 'app-service-integration'
        properties: {
          addressPrefix: appServiceIntegrationSubnetPrefix
          // Every web app routes ALL of its outbound traffic through this subnet
          // (outboundVnetRouting.applicationTraffic), so this is the egress point
          // for service-to-service calls. The Microsoft.Web service endpoint is
          // what makes the App Service front end able to see the SOURCE SUBNET of
          // such a call: without it, a vnetSubnetResourceId access restriction on
          // the callee has nothing to match on and every peer call is rejected
          // with 403 Ip Forbidden. Service endpoints and a subnet delegation
          // coexist -- this does not conflict with the serverFarms delegation
          // below.
          serviceEndpoints: [
            {
              service: 'Microsoft.Web'
            }
          ]
          delegations: [
            {
              name: 'app-service-delegation'
              properties: {
                serviceName: 'Microsoft.Web/serverFarms'
              }
            }
          ]
          networkSecurityGroup: {
            id: defaultNsg.id
          }
        }
      }
      {
        name: 'app-service-private-endpoints'
        properties: {
          addressPrefix: appServicePrivateEndpointsSubnetPrefix
          privateEndpointNetworkPolicies: 'Disabled'
          networkSecurityGroup: {
            id: defaultNsg.id
          }
        }
      }
      {
        name: 'containerinstance'
        properties: {
          addressPrefix: containerInstanceSubnetPrefix
          // NO Microsoft.Web service endpoint here, deliberately. Adding one to
          // route this subnet's App Service traffic over the Azure backbone --
          // so an access-restriction rule could match its source subnet -- does
          // not work from a ContainerInstance-delegated subnet: the traffic is
          // black-holed rather than delivered, and every call fails at the
          // transport layer with no HTTP response at all (curl exit 000). The
          // in-VNet bootstrap script is unaffected because it talks to ARM and
          // to private endpoints, neither of which this endpoint would cover.
          //
          // Post-deploy web-app health is therefore verified on the ARM plane
          // (the platform's own health-check signal), which needs no network
          // path from any subnet -- see the deploy script's verify command.
          delegations: [
            {
              name: 'aci-delegation'
              properties: {
                serviceName: 'Microsoft.ContainerInstance/containerGroups'
              }
            }
          ]
          natGateway: {
            id: deploymentScriptNatGateway.id
          }
          networkSecurityGroup: {
            id: deploymentScriptNsg.id
          }
        }
      }
      {
        name: 'pg-delegated-1'
        properties: {
          addressPrefix: pgDelegatedSubnetPrefix1
          delegations: [
            {
              name: 'pg-flexible-server-delegation'
              properties: {
                serviceName: 'Microsoft.DBforPostgreSQL/flexibleServers'
              }
            }
          ]
          networkSecurityGroup: {
            id: defaultNsg.id
          }
        }
      }
      {
        name: 'pg-delegated-2'
        properties: {
          addressPrefix: pgDelegatedSubnetPrefix2
          delegations: [
            {
              name: 'pg-flexible-server-delegation'
              properties: {
                serviceName: 'Microsoft.DBforPostgreSQL/flexibleServers'
              }
            }
          ]
          networkSecurityGroup: {
            id: defaultNsg.id
          }
        }
      }
      {
        name: 'pg-delegated-3'
        properties: {
          addressPrefix: pgDelegatedSubnetPrefix3
          delegations: [
            {
              name: 'pg-flexible-server-delegation'
              properties: {
                serviceName: 'Microsoft.DBforPostgreSQL/flexibleServers'
              }
            }
          ]
          networkSecurityGroup: {
            id: defaultNsg.id
          }
        }
      }
      {
        name: 'pg-delegated-4'
        properties: {
          addressPrefix: pgDelegatedSubnetPrefix4
          delegations: [
            {
              name: 'pg-flexible-server-delegation'
              properties: {
                serviceName: 'Microsoft.DBforPostgreSQL/flexibleServers'
              }
            }
          ]
          networkSecurityGroup: {
            id: defaultNsg.id
          }
        }
      }
      {
        // The subnet each schema run's container group joins: apart from the
        // deploymentScripts' subnet, whose NSG admits the Microsoft Container
        // Registry, so nothing beside a run's owner credential reaches a
        // registry. Appended after the pg-delegated subnets, which keep 9..N.
        name: 'schemarun'
        properties: {
          addressPrefix: schemaRunSubnetPrefix
          delegations: [
            {
              name: 'aci-delegation'
              properties: {
                serviceName: 'Microsoft.ContainerInstance/containerGroups'
              }
            }
          ]
          natGateway: {
            id: deploymentScriptNatGateway.id
          }
          networkSecurityGroup: {
            id: schemaRunNsg.id
          }
        }
      }
    ]
  }
}

