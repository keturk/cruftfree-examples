@description('Source prefixes of the managed edge that fronts the apps subnet; empty when this composition provisions no such edge')
param apimEdgeSourceAddressPrefixes array = []

// Inbound traffic crosses TWO network security groups, and Azure evaluates the
// SUBNET's before the NIC's. A rule admitting the managed edge on the NIC
// alone is therefore dead: the subnet's DenyAllInbound drops the packet first,
// and nothing anywhere reports it -- the edge just times out and returns 500,
// with both NSGs individually looking correct.
//
// That is not hypothetical: the whole stack came up healthy behind an edge
// that could not reach it, because the allow rule lived only on the NIC.
//
// So the edge is admitted here as well, and the two rule sets are derived from
// the SAME prefixes and ports the VM module receives -- never re-typed.
// Destination is the apps subnet, not '*': the datastore and Key Vault subnets
// share this NSG and have no business admitting anything from outside the VNet.
var apimEdgeSubnetRules = [
  for (apimSourcePrefix, apimIpIndex) in apimEdgeSourceAddressPrefixes: {
    name: 'AllowApimEdgeToApps${apimIpIndex}'
    properties: {
      priority: 200 + apimIpIndex
      direction: 'Inbound'
      access: 'Allow'
      protocol: 'Tcp'
      sourcePortRange: '*'
      destinationPortRanges: [
      ]
      sourceAddressPrefix: apimSourcePrefix
      destinationAddressPrefix: appsSubnetPrefix
    }
  }
]

// Default NSG: used by the 'apps' subnet and by any subnet with no
// datastore-specific allow rule below (e.g. a datastore subnet whose block
// kind this application does not provision, or a non-datastore subnet like
// 'keyvault'). Keeps today's VNet-wide-allow posture for everything this
// task does not scope down to a single port.
resource defaultNsg 'Microsoft.Network/networkSecurityGroups@2023-11-01' = {
  name: 'helpdesk-system-default-nsg-${environment}'
  location: location
  properties: {
    securityRules: concat(apimEdgeSubnetRules, [
      {
        name: 'AllowVNetInbound'
        properties: {
          priority: 100
          direction: 'Inbound'
          access: 'Allow'
          protocol: '*'
          sourcePortRange: '*'
          destinationPortRange: '*'
          sourceAddressPrefix: 'VirtualNetwork'
          destinationAddressPrefix: 'VirtualNetwork'
        }
      }
      {
        name: 'DenyAllInbound'
        properties: {
          priority: 1000
          direction: 'Inbound'
          access: 'Deny'
          protocol: '*'
          sourcePortRange: '*'
          destinationPortRange: '*'
          sourceAddressPrefix: '*'
          destinationAddressPrefix: '*'
        }
      }
    ])
  }
}

