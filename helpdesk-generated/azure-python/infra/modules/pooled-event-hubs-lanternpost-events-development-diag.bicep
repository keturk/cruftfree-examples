// Diagnostic settings for pooled-event-hubs-lanternpost-events-development (event-hubs)
// Generated by CruftFree. Do not edit manually.

@description('Environment name')
param environment string

@description('Name of the target resource to attach diagnostics to')
param targetResourceName string

@description('Log Analytics workspace ID for diagnostics')
param logAnalyticsWorkspaceId string

resource targetResource 'Microsoft.EventHub/namespaces@2024-01-01' existing = {
  name: targetResourceName
}

resource diagnosticSettings 'Microsoft.Insights/diagnosticSettings@2021-05-01-preview' = {
  name: 'pooled-event-hubs-lanternpost-events-development-diag-${environment}'
  scope: targetResource
  properties: {
    workspaceId: logAnalyticsWorkspaceId
    // Per-setting retentionPolicy is rejected by Azure for new diagnostic
    // settings ("Diagnostic settings does not support retention for new
    // diagnostic settings"). Retention lives on the Log Analytics workspace
    // instead: fed by the portable platforms.azure.diagnostics.retentionDays
    // straight into the workspace's retentionInDays in app-insights.bicep --
    // never on this module.
    logs: [
      {
        category: 'ArchiveLogs'
        enabled: true
      }
      {
        category: 'OperationalLogs'
        enabled: true
      }
      {
        category: 'AutoScaleLogs'
        enabled: true
      }
    ]
    metrics: [
      {
        category: 'AllMetrics'
        enabled: true
      }
    ]
  }
}
