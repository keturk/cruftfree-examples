config app social.Desk {
  base {
    targets = ["angular"];
    clients {
      angular {
        scope = "@rookery";
      }
    }
    strings = ["config/strings/desk.en-US.ccfg"];
  }
  profile test as "test" extends base {
    web { port = 4300; }
  }
  profile aws as "aws" extends base {
    web { domain { name = "desk.rookery.example.com"; } }
  }
  profile development as "dev" extends aws {
  }
  profile production as "prod" extends base {
    web { port = 4300; }
  }
}
