config service social.PostService {
  import "config/templates/infrastructure.ccfg";

  base {
    port = 8002;
    replicas = 1;
    healthCheck {
      path = "/health";
      initialDelay = "10s";
    }
    rdbms postDb from postgresContainer(id: "3222afe5-4f9b-4a2d-9aa6-e78199fab662", database: "social_post");
    cache redis from redisContainer();
    pubsub mq from kafkaContainer();
    httpSecurity from localHttpSecurity(host: "social-post-service");
    outboxOps from outboxBatches();
    kafkaOps from kafkaPolling();
    cacheOps from redisPool();
    rateLimitOps from rateLimitWindow();
    serviceCredentialOps from machineCredential();
    microserviceClientOps from peerClient();
    retryBudgetOps from retryBudget();
    resilience {
      defaults {
        timeout = "10s";
      }
      dependencyPolicy {
        defaults {
          rdbms from standardDatabasePolicy();
          cache from standardCachePolicy();
        }
      }
    }
    secrets {
      // The default only exists on a local stack, where it matches the hash seeded in seed/, so the
      // example runs with nothing to configure. Any other deployment must supply the handle's value.
      secret moderation_provider_api_key {
        required = true;
        purpose = "API key for the moderation vendor (ModerationProvider contract).";
        localDefault = "dev-only-moderation-key-not-a-credential";
      }
    }
  }

  profile test as "test" extends base {
    alias env = "TEST";
    alias resource = "test";
  }

  profile aws as "aws" extends base {
    alias env = "AWS";
    alias resource = "aws";

    remoteConfigOps {
      appconfigMinPollSeconds = 15;
    }
    resources {
      requests {
        cpu = "100m";
        memory = "256Mi";
      }
      limits {
        cpu = "500m";
        memory = "512Mi";
      }
    }
    // Consumers run as SQS-triggered Lambdas: the `mq` topics cross service boundaries, which on AWS
    // means SNS/SQS, and no language target runs an SQS pubsub consumer inside the service process.
    runtime { consumers = "decoupled"; }

    replicas = 2;
    scaling {
      replicas {
        min = 2;
        max = 4;
      }
      triggers = [];
    }
    replace rdbms postDb from rdsPostgres(id: "3222afe5-4f9b-4a2d-9aa6-e78199fab662", database: "social_post", poolSize: 20, maxOverflow: 10);
    replace cache redis from elasticache();
    replace pubsub mq from snsSqs();
    // The machine identity is an operator-managed OIDC issuer on AWS, so its client secret is a handle
    // here: the value lives in the platform vault under this name, never in a generated artifact.
    secrets {
      secret machine_identity_client_secret {
        required = true;
        purpose = "OIDC client secret for the machine identity provider (external issuer on AWS).";
      }
    }
  }

  profile development as "dev" extends aws {
    alias env = "DEV";
    alias resource = "dev";
  }

  profile production as "prod" extends base {
    alias env = "PROD";
    alias resource = "prod";
  }
}
