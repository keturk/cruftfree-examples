config service social.ModerationMock {
  import "config/templates/infrastructure.ccfg";

  base {
    port = 8090;
    replicas = 1;
    healthCheck {
      path = "/health";
      initialDelay = "10s";
    }
    rdbms moderationDb from postgresContainer(id: "7ed3651b-c0ba-4d62-917c-7700aaab8695", database: "social_moderation_mock");
    httpSecurity from localHttpSecurity(host: "social-moderation-mock");
    serviceCredentialOps from machineCredential();
    resilience {
      defaults {
        timeout = "10s";
      }
      dependencyPolicy {
        defaults {
          rdbms from standardDatabasePolicy();
        }
      }
    }
  }

  profile test as "test" extends base {
    alias env = "TEST";
    alias resource = "test";
  }

  profile aws as "aws" extends base {
    alias env = "AWS";
    alias resource = "aws";

    remoteConfigOps {
      appconfigMinPollSeconds = 15;
    }
    resources {
      requests {
        cpu = "100m";
        memory = "256Mi";
      }
    }
    scaling {
      replicas {
        min = 1;
        max = 1;
      }
      triggers = [];
    }
    replace rdbms moderationDb from rdsPostgres(id: "7ed3651b-c0ba-4d62-917c-7700aaab8695", database: "social_moderation_mock");
  }

  profile development as "dev" extends aws {
    alias env = "DEV";
    alias resource = "dev";
  }

  profile production as "prod" extends base {
    alias env = "PROD";
    alias resource = "prod";
  }
}
