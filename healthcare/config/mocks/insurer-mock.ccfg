config service healthcare.InsurerMock {
  import "config/templates/infrastructure.ccfg";

  base {
    port = 8090;
    replicas = 1;
    healthCheck {
      path = "/health";
      initialDelay = "10s";
    }
    rdbms insurerDb from postgresContainer(id: "3cbca03d-cc3f-4a8e-8a4f-e9d648faab09", database: "healthcare_insurer_mock");
    httpSecurity from localHttpSecurity(host: "healthcare-insurer-mock");
    serviceCredentialOps from machineCredential();
    resilience {
      defaults {
        timeout = "10s";
      }
      dependencyPolicy {
        defaults {
          rdbms from standardDatabasePolicy();
        }
      }
    }
  }

  profile test as "test" extends base {
    alias env = "TEST";
    alias resource = "test";
  }

  profile aws as "aws" extends base {
    alias env = "AWS";
    alias resource = "aws";

    remoteConfigOps {
      appconfigMinPollSeconds = 15;
    }
    resources {
      requests {
        cpu = "100m";
        memory = "256Mi";
      }
    }
    scaling {
      replicas {
        min = 1;
        max = 1;
      }
      triggers = [];
    }
    replace rdbms insurerDb from rdsPostgres(id: "3cbca03d-cc3f-4a8e-8a4f-e9d648faab09", database: "healthcare_insurer_mock");
  }

  profile development as "dev" extends aws {
    alias env = "DEV";
    alias resource = "dev";
  }

  profile production as "prod" extends base {
    alias env = "PROD";
    alias resource = "prod";
  }
}
