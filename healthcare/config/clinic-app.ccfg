config app healthcare.Clinic {
  base {
    targets = ["angular"];
    clients {
      angular {
        scope = "@ferncrest";
      }
    }
    strings = ["config/strings/clinic.en-US.ccfg"];
  }
  profile test as "test" extends base {
    web { port = 4300; }
  }
  profile aws as "aws" extends base {
    web { domain { name = "clinic.ferncrest.example.com"; } }
  }
  profile development as "dev" extends aws {
  }
  profile production as "prod" extends base {
    web { port = 4300; }
  }
}
