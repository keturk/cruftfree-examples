config service healthcare.RecordService {
  import "config/templates/infrastructure.ccfg";

  base {
    port = 8003;
    replicas = 1;
    healthCheck {
      path = "/health";
      initialDelay = "10s";
    }
    rdbms recordDb from postgresContainer(id: "c6675cf1-2c0b-4480-abc5-fece0245e3eb", database: "healthcare_record");
    pubsub mq from kafkaContainer();
    httpSecurity from localHttpSecurity(host: "healthcare-record-service");
    outboxOps from outboxBatches();
    kafkaOps from kafkaPolling();
    serviceCredentialOps from machineCredential();
    microserviceClientOps from peerClient();
    retryBudgetOps from retryBudget();
    jobs {
      jobs {
        SyncPharmacy {
          schedule = "*/5 * * * *";
          timeout = "120s";
        }
        SettleClaims {
          schedule = "*/10 * * * *";
          timeout = "120s";
        }
      }
    }
    resilience {
      defaults {
        timeout = "10s";
      }
      dependencyPolicy {
        defaults {
          rdbms from standardDatabasePolicy();
        }
      }
    }
    secrets {
      // Each default only exists on a local stack, where it matches the hash seeded in that mock's
      // seed file, so the example runs with nothing to configure. Any other deployment must supply
      // the handle's value.
      secret insurer_provider_api_key {
        required = true;
        purpose = "API key for the insurer (InsurerProvider contract).";
        localDefault = "dev-only-insurer-key-not-a-credential";
      }
      secret pharmacy_provider_api_key {
        required = true;
        purpose = "API key for the pharmacy network (PharmacyProvider contract).";
        localDefault = "dev-only-pharmacy-key-not-a-credential";
      }
      secret sms_provider_api_key {
        required = true;
        purpose = "API key for the text vendor (SmsProvider contract).";
        localDefault = "dev-only-sms-key-not-a-credential";
      }
    }
  }

  profile test as "test" extends base {
    alias env = "TEST";
    alias resource = "test";
  }

  profile aws as "aws" extends base {
    alias env = "AWS";
    alias resource = "aws";

    remoteConfigOps {
      appconfigMinPollSeconds = 15;
    }
    resources {
      requests {
        cpu = "100m";
        memory = "256Mi";
      }
      limits {
        cpu = "500m";
        memory = "512Mi";
      }
    }
    // Consumers run as SQS-triggered Lambdas: the `mq` topics cross service boundaries, which on AWS
    // means SNS/SQS, and no language target runs an SQS pubsub consumer inside the service process.
    runtime { consumers = "decoupled"; }

    replicas = 2;
    scaling {
      replicas {
        min = 2;
        max = 4;
      }
      triggers = [];
    }
    replace rdbms recordDb from rdsPostgres(id: "c6675cf1-2c0b-4480-abc5-fece0245e3eb", database: "healthcare_record", poolSize: 20, maxOverflow: 10);
    replace pubsub mq from snsSqs();
  }

  profile development as "dev" extends aws {
    alias env = "DEV";
    alias resource = "dev";
  }

  profile production as "prod" extends base {
    alias env = "PROD";
    alias resource = "prod";
  }
}
