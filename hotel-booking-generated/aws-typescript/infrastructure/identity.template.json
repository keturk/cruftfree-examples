{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Outputs": {
    "ChannelMockAppClientId": {
      "Description": "App client ID for service ChannelMock",
      "Export": {
        "Name": "hotel-system-identity-ChannelMockAppClientId"
      },
      "Value": {
        "Ref": "ChannelMockAppClient"
      }
    },
    "EmailMockAppClientId": {
      "Description": "App client ID for service EmailMock",
      "Export": {
        "Name": "hotel-system-identity-EmailMockAppClientId"
      },
      "Value": {
        "Ref": "EmailMockAppClient"
      }
    },
    "IdentityFrontDeskBrowserPublicClientId": {
      "Description": "Public client ID for FrontDesk-browser",
      "Export": {
        "Name": "hotel-system-identity-IdentityFrontDeskBrowserPublicClientId"
      },
      "Value": {
        "Ref": "FrontDeskBrowserAppClient"
      }
    },
    "IdentityGuestBrowserPublicClientId": {
      "Description": "Public client ID for Guest-browser",
      "Export": {
        "Name": "hotel-system-identity-IdentityGuestBrowserPublicClientId"
      },
      "Value": {
        "Ref": "GuestBrowserAppClient"
      }
    },
    "IdentityGuestNativePublicClientId": {
      "Description": "Public client ID for Guest-native",
      "Export": {
        "Name": "hotel-system-identity-IdentityGuestNativePublicClientId"
      },
      "Value": {
        "Ref": "GuestNativeAppClient"
      }
    },
    "NoticeServiceAppClientId": {
      "Description": "App client ID for service NoticeService",
      "Export": {
        "Name": "hotel-system-identity-NoticeServiceAppClientId"
      },
      "Value": {
        "Ref": "NoticeServiceAppClient"
      }
    },
    "PaymentMockAppClientId": {
      "Description": "App client ID for service PaymentMock",
      "Export": {
        "Name": "hotel-system-identity-PaymentMockAppClientId"
      },
      "Value": {
        "Ref": "PaymentMockAppClient"
      }
    },
    "StayServiceAppClientId": {
      "Description": "App client ID for service StayService",
      "Export": {
        "Name": "hotel-system-identity-StayServiceAppClientId"
      },
      "Value": {
        "Ref": "StayServiceAppClient"
      }
    },
    "UserPoolArn": {
      "Description": "ARN of the user pool the services write user attributes to.",
      "Export": {
        "Name": "hotel-system-identity-UserPoolArn"
      },
      "Value": {
        "Fn::GetAtt": [
          "IdentityUserPool",
          "Arn"
        ]
      }
    },
    "UserPoolId": {
      "Description": "Cognito User Pool ID for identity",
      "Value": {
        "Ref": "IdentityUserPool"
      }
    }
  },
  "Resources": {
    "ChannelMockAppClient": {
      "Properties": {
        "AllowedOAuthFlows": [
          "code"
        ],
        "AllowedOAuthFlowsUserPoolClient": true,
        "ClientName": "ChannelMock",
        "GenerateSecret": true,
        "UserPoolId": {
          "Ref": "IdentityUserPool"
        }
      },
      "Type": "AWS::Cognito::UserPoolClient"
    },
    "EmailMockAppClient": {
      "Properties": {
        "AllowedOAuthFlows": [
          "code"
        ],
        "AllowedOAuthFlowsUserPoolClient": true,
        "ClientName": "EmailMock",
        "GenerateSecret": true,
        "UserPoolId": {
          "Ref": "IdentityUserPool"
        }
      },
      "Type": "AWS::Cognito::UserPoolClient"
    },
    "FrontDeskBrowserAppClient": {
      "Properties": {
        "AllowedOAuthFlows": [
          "code"
        ],
        "AllowedOAuthFlowsUserPoolClient": true,
        "CallbackURLs": [
          "https://desk.marram.example.com/auth/callback"
        ],
        "ClientName": "FrontDesk-browser",
        "GenerateSecret": false,
        "LogoutURLs": [
          "https://desk.marram.example.com/auth/logout"
        ],
        "UserPoolId": {
          "Ref": "IdentityUserPool"
        }
      },
      "Type": "AWS::Cognito::UserPoolClient"
    },
    "GuestBrowserAppClient": {
      "Properties": {
        "AllowedOAuthFlows": [
          "code"
        ],
        "AllowedOAuthFlowsUserPoolClient": true,
        "CallbackURLs": [
          "https://stay.marram.example.com/auth/callback"
        ],
        "ClientName": "Guest-browser",
        "GenerateSecret": false,
        "LogoutURLs": [
          "https://stay.marram.example.com/auth/logout"
        ],
        "UserPoolId": {
          "Ref": "IdentityUserPool"
        }
      },
      "Type": "AWS::Cognito::UserPoolClient"
    },
    "GuestNativeAppClient": {
      "Properties": {
        "AllowedOAuthFlows": [
          "code"
        ],
        "AllowedOAuthFlowsUserPoolClient": true,
        "CallbackURLs": [
          "com.example.marram://oauth/callback"
        ],
        "ClientName": "Guest-native",
        "GenerateSecret": false,
        "LogoutURLs": [
          "com.example.marram://oauth/logout"
        ],
        "UserPoolId": {
          "Ref": "IdentityUserPool"
        }
      },
      "Type": "AWS::Cognito::UserPoolClient"
    },
    "HostedUiDomain": {
      "Properties": {
        "Domain": "hotel-system",
        "UserPoolId": {
          "Ref": "IdentityUserPool"
        }
      },
      "Type": "AWS::Cognito::UserPoolDomain"
    },
    "IdentityFrontDeskGroup": {
      "Properties": {
        "Description": "CruftFree role: frontDesk",
        "GroupName": "frontdesk",
        "UserPoolId": {
          "Ref": "IdentityUserPool"
        }
      },
      "Type": "AWS::Cognito::UserPoolGroup"
    },
    "IdentityOperatorGroup": {
      "Properties": {
        "Description": "CruftFree role: operator",
        "GroupName": "operators",
        "UserPoolId": {
          "Ref": "IdentityUserPool"
        }
      },
      "Type": "AWS::Cognito::UserPoolGroup"
    },
    "IdentityUserPool": {
      "DeletionPolicy": "Retain",
      "Properties": {
        "AccountRecoverySetting": {
          "RecoveryMechanisms": [
            {
              "Name": "verified_email",
              "Priority": 1
            }
          ]
        },
        "AdminCreateUserConfig": {
          "AllowAdminCreateUserOnly": false
        },
        "AutoVerifiedAttributes": [
          "email"
        ],
        "MfaConfiguration": "OFF",
        "UserPoolName": "HotelSystemUserPool",
        "UsernameAttributes": [
          "email"
        ]
      },
      "Type": "AWS::Cognito::UserPool",
      "UpdateReplacePolicy": "Retain"
    },
    "NoticeServiceAppClient": {
      "Properties": {
        "AllowedOAuthFlows": [
          "code"
        ],
        "AllowedOAuthFlowsUserPoolClient": true,
        "ClientName": "NoticeService",
        "GenerateSecret": true,
        "UserPoolId": {
          "Ref": "IdentityUserPool"
        }
      },
      "Type": "AWS::Cognito::UserPoolClient"
    },
    "PaymentMockAppClient": {
      "Properties": {
        "AllowedOAuthFlows": [
          "code"
        ],
        "AllowedOAuthFlowsUserPoolClient": true,
        "ClientName": "PaymentMock",
        "GenerateSecret": true,
        "UserPoolId": {
          "Ref": "IdentityUserPool"
        }
      },
      "Type": "AWS::Cognito::UserPoolClient"
    },
    "StayServiceAppClient": {
      "Properties": {
        "AllowedOAuthFlows": [
          "code"
        ],
        "AllowedOAuthFlowsUserPoolClient": true,
        "ClientName": "StayService",
        "GenerateSecret": true,
        "UserPoolId": {
          "Ref": "IdentityUserPool"
        }
      },
      "Type": "AWS::Cognito::UserPoolClient"
    }
  }
}
