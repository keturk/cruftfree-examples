{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Outputs": {
    "HotelChannelMockNlbListenerArn": {
      "Description": "NLB listener forwarding to hotel-channel-mock",
      "Export": {
        "Name": "hotel-system-gateway-nlb-HotelChannelMockNlbListenerArn"
      },
      "Value": {
        "Ref": "HotelChannelMockListener"
      }
    },
    "HotelChannelMockNlbTargetGroupArn": {
      "Description": "NLB target group polled by deploy.py's verify phase for hotel-channel-mock",
      "Export": {
        "Name": "hotel-system-gateway-nlb-HotelChannelMockNlbTargetGroupArn"
      },
      "Value": {
        "Ref": "HotelChannelMockNlbTg"
      }
    },
    "HotelEmailMockNlbListenerArn": {
      "Description": "NLB listener forwarding to hotel-email-mock",
      "Export": {
        "Name": "hotel-system-gateway-nlb-HotelEmailMockNlbListenerArn"
      },
      "Value": {
        "Ref": "HotelEmailMockListener"
      }
    },
    "HotelEmailMockNlbTargetGroupArn": {
      "Description": "NLB target group polled by deploy.py's verify phase for hotel-email-mock",
      "Export": {
        "Name": "hotel-system-gateway-nlb-HotelEmailMockNlbTargetGroupArn"
      },
      "Value": {
        "Ref": "HotelEmailMockNlbTg"
      }
    },
    "HotelNoticeServiceNlbListenerArn": {
      "Description": "NLB listener forwarding to hotel-notice-service",
      "Export": {
        "Name": "hotel-system-gateway-nlb-HotelNoticeServiceNlbListenerArn"
      },
      "Value": {
        "Ref": "HotelNoticeServiceListener"
      }
    },
    "HotelNoticeServiceNlbTargetGroupArn": {
      "Description": "NLB target group polled by deploy.py's verify phase for hotel-notice-service",
      "Export": {
        "Name": "hotel-system-gateway-nlb-HotelNoticeServiceNlbTargetGroupArn"
      },
      "Value": {
        "Ref": "HotelNoticeServiceNlbTg"
      }
    },
    "HotelPaymentMockNlbListenerArn": {
      "Description": "NLB listener forwarding to hotel-payment-mock",
      "Export": {
        "Name": "hotel-system-gateway-nlb-HotelPaymentMockNlbListenerArn"
      },
      "Value": {
        "Ref": "HotelPaymentMockListener"
      }
    },
    "HotelPaymentMockNlbTargetGroupArn": {
      "Description": "NLB target group polled by deploy.py's verify phase for hotel-payment-mock",
      "Export": {
        "Name": "hotel-system-gateway-nlb-HotelPaymentMockNlbTargetGroupArn"
      },
      "Value": {
        "Ref": "HotelPaymentMockNlbTg"
      }
    },
    "HotelStayServiceNlbListenerArn": {
      "Description": "NLB listener forwarding to hotel-stay-service",
      "Export": {
        "Name": "hotel-system-gateway-nlb-HotelStayServiceNlbListenerArn"
      },
      "Value": {
        "Ref": "HotelStayServiceListener"
      }
    },
    "HotelStayServiceNlbTargetGroupArn": {
      "Description": "NLB target group polled by deploy.py's verify phase for hotel-stay-service",
      "Export": {
        "Name": "hotel-system-gateway-nlb-HotelStayServiceNlbTargetGroupArn"
      },
      "Value": {
        "Ref": "HotelStayServiceNlbTg"
      }
    },
    "NlbArn": {
      "Description": "The gateway's internal NLB.",
      "Export": {
        "Name": "hotel-system-gateway-nlb-NlbArn"
      },
      "Value": {
        "Ref": "Nlb"
      }
    },
    "NlbDnsName": {
      "Description": "The NLB's DNS name.",
      "Export": {
        "Name": "hotel-system-gateway-nlb-NlbDnsName"
      },
      "Value": {
        "Fn::GetAtt": [
          "Nlb",
          "DNSName"
        ]
      }
    },
    "NlbSecurityGroupId": {
      "Description": "The NLB's security group, admitted by each gateway-routed service.",
      "Export": {
        "Name": "hotel-system-gateway-nlb-NlbSecurityGroupId"
      },
      "Value": {
        "Fn::GetAtt": [
          "NlbSecurityGroup",
          "GroupId"
        ]
      }
    }
  },
  "Resources": {
    "HotelChannelMockListener": {
      "Properties": {
        "DefaultActions": [
          {
            "TargetGroupArn": {
              "Ref": "HotelChannelMockNlbTg"
            },
            "Type": "forward"
          }
        ],
        "LoadBalancerArn": {
          "Ref": "Nlb"
        },
        "Port": 8092,
        "Protocol": "TCP"
      },
      "Type": "AWS::ElasticLoadBalancingV2::Listener"
    },
    "HotelChannelMockNlbTg": {
      "Properties": {
        "HealthCheckPath": "/ready",
        "HealthCheckProtocol": "HTTP",
        "Port": 8092,
        "Protocol": "TCP",
        "TargetType": "ip",
        "VpcId": {
          "Fn::ImportValue": "hotel-system-vpc-VpcId"
        }
      },
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup"
    },
    "HotelEmailMockListener": {
      "Properties": {
        "DefaultActions": [
          {
            "TargetGroupArn": {
              "Ref": "HotelEmailMockNlbTg"
            },
            "Type": "forward"
          }
        ],
        "LoadBalancerArn": {
          "Ref": "Nlb"
        },
        "Port": 8091,
        "Protocol": "TCP"
      },
      "Type": "AWS::ElasticLoadBalancingV2::Listener"
    },
    "HotelEmailMockNlbTg": {
      "Properties": {
        "HealthCheckPath": "/ready",
        "HealthCheckProtocol": "HTTP",
        "Port": 8091,
        "Protocol": "TCP",
        "TargetType": "ip",
        "VpcId": {
          "Fn::ImportValue": "hotel-system-vpc-VpcId"
        }
      },
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup"
    },
    "HotelNoticeServiceListener": {
      "Properties": {
        "DefaultActions": [
          {
            "TargetGroupArn": {
              "Ref": "HotelNoticeServiceNlbTg"
            },
            "Type": "forward"
          }
        ],
        "LoadBalancerArn": {
          "Ref": "Nlb"
        },
        "Port": 8002,
        "Protocol": "TCP"
      },
      "Type": "AWS::ElasticLoadBalancingV2::Listener"
    },
    "HotelNoticeServiceNlbTg": {
      "Properties": {
        "HealthCheckPath": "/ready",
        "HealthCheckProtocol": "HTTP",
        "Port": 8002,
        "Protocol": "TCP",
        "TargetType": "ip",
        "VpcId": {
          "Fn::ImportValue": "hotel-system-vpc-VpcId"
        }
      },
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup"
    },
    "HotelPaymentMockListener": {
      "Properties": {
        "DefaultActions": [
          {
            "TargetGroupArn": {
              "Ref": "HotelPaymentMockNlbTg"
            },
            "Type": "forward"
          }
        ],
        "LoadBalancerArn": {
          "Ref": "Nlb"
        },
        "Port": 8090,
        "Protocol": "TCP"
      },
      "Type": "AWS::ElasticLoadBalancingV2::Listener"
    },
    "HotelPaymentMockNlbTg": {
      "Properties": {
        "HealthCheckPath": "/ready",
        "HealthCheckProtocol": "HTTP",
        "Port": 8090,
        "Protocol": "TCP",
        "TargetType": "ip",
        "VpcId": {
          "Fn::ImportValue": "hotel-system-vpc-VpcId"
        }
      },
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup"
    },
    "HotelStayServiceListener": {
      "Properties": {
        "DefaultActions": [
          {
            "TargetGroupArn": {
              "Ref": "HotelStayServiceNlbTg"
            },
            "Type": "forward"
          }
        ],
        "LoadBalancerArn": {
          "Ref": "Nlb"
        },
        "Port": 8001,
        "Protocol": "TCP"
      },
      "Type": "AWS::ElasticLoadBalancingV2::Listener"
    },
    "HotelStayServiceNlbTg": {
      "Properties": {
        "HealthCheckPath": "/ready",
        "HealthCheckProtocol": "HTTP",
        "Port": 8001,
        "Protocol": "TCP",
        "TargetType": "ip",
        "VpcId": {
          "Fn::ImportValue": "hotel-system-vpc-VpcId"
        }
      },
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup"
    },
    "Nlb": {
      "Properties": {
        "Name": "hotel-system-nlb",
        "Scheme": "internal",
        "SecurityGroups": [
          {
            "Ref": "NlbSecurityGroup"
          }
        ],
        "Subnets": [
          {
            "Fn::ImportValue": "hotel-system-vpc-PrivateSubnet1Id"
          },
          {
            "Fn::ImportValue": "hotel-system-vpc-PrivateSubnet2Id"
          }
        ],
        "Type": "network"
      },
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer"
    },
    "NlbSecurityGroup": {
      "Properties": {
        "GroupDescription": "Security group for hotel-system API gateway NLB",
        "SecurityGroupEgress": [
          {
            "CidrIp": "127.0.0.1/32",
            "Description": "Inline anchor so EC2 adds no default allow-all egress rule",
            "IpProtocol": "-1"
          }
        ],
        "VpcId": {
          "Fn::ImportValue": "hotel-system-vpc-VpcId"
        }
      },
      "Type": "AWS::EC2::SecurityGroup"
    }
  }
}
