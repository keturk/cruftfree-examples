    "NoticeDbSchemaTaskDefinition": {
      "Properties": {
        "ContainerDefinitions": [
          {
            "Command": [
              "set -eu; case \"${RUN_ID:-}\" in \"\"|.*|*[!A-Za-z0-9._-]*) echo \"RUN_ID must name the run: letters, digits, '.', '_' and '-', not starting with '.'\" >&2; exit 2;; esac; aws s3 cp \"s3://${RUN_STORE_BUCKET}/${RUN_STORE_PREFIX}${RUN_ID}/in\" \"/work/in\"; aws s3 cp \"s3://${RUN_STORE_BUCKET}/${RUN_STORE_PREFIX}${RUN_ID}/rds-global-bundle.pem\" \"/work/rds-global-bundle.pem\""
            ],
            "EntryPoint": [
              "sh",
              "-c"
            ],
            "Environment": [
              {
                "Name": "AWS_REGION",
                "Value": {
                  "Ref": "AWS::Region"
                }
              },
              {
                "Name": "RUN_STORE_BUCKET",
                "Value": {
                  "Fn::ImportValue": "hotel-system-bootstrap-RunStoreBucketName"
                }
              },
              {
                "Name": "RUN_STORE_PREFIX",
                "Value": "hotel.NoticeService.noticeDb/"
              }
            ],
            "Essential": false,
            "Image": "amazon/aws-cli:2.38.2@sha256:5d39fd52f236ed01c5c25fba66c9aebcfc6cbb88e7bb1b727c5fe1f150540597",
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "NoticeDbSchemaTaskLogGroup"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "copy-in"
              }
            },
            "MountPoints": [
              {
                "ContainerPath": "/work",
                "ReadOnly": false,
                "SourceVolume": "work"
              }
            ],
            "Name": "copy-in",
            "ReadonlyRootFilesystem": true
          },
          {
            "Command": [
              "( umask 077; trap 'rm -f /dev/shm/credential' EXIT; trap 'exit 2' HUP INT TERM; schema_credential=$(printf '%s' \"${SCHEMA_OWNER_SECRET}\") || { echo 'The schema client'\"'\"'s credential could not be fetched.' >&2; exit 2; }; [ -n \"$schema_credential\" ] || { echo 'The schema client'\"'\"'s credential is empty: the block'\"'\"'s owner secret is not set.' >&2; exit 2; }; printf '%s\\n' \"$schema_credential\" | sed -e 's/\\\\/\\\\\\\\/g' -e 's/:/\\\\:/g' -e 's/^/*:*:*:*:/' > /dev/shm/credential || { echo 'The schema client'\"'\"'s credential file could not be written.' >&2; exit 2; }; unset schema_credential SCHEMA_OWNER_SECRET; [ \"$(wc -l < /dev/shm/credential)\" -eq 1 ] || { echo 'The schema client'\"'\"'s credential holds a line break, which its file cannot.' >&2; exit 2; }; export PGPASSFILE=/dev/shm/credential; timeout -k 10 600 psql -X -A -t -q -f - \"$@\" < /work/in ) > /work/out 2> /work/err; echo $? > /work/exit",
              "sh"
            ],
            "DependsOn": [
              {
                "Condition": "SUCCESS",
                "ContainerName": "copy-in"
              }
            ],
            "EntryPoint": [
              "sh",
              "-c"
            ],
            "Environment": [
              {
                "Name": "PGHOST",
                "Value": {
                  "Fn::GetAtt": [
                    "NoticeDbDb",
                    "Endpoint.Address"
                  ]
                }
              },
              {
                "Name": "PGPORT",
                "Value": "5432"
              },
              {
                "Name": "PGDATABASE",
                "Value": "hotel_notice"
              },
              {
                "Name": "PGUSER",
                "Value": "cruftfree_admin"
              },
              {
                "Name": "PGSSLMODE",
                "Value": "verify-full"
              },
              {
                "Name": "PGSSLROOTCERT",
                "Value": "/work/rds-global-bundle.pem"
              }
            ],
            "Essential": false,
            "Image": "postgres:17-alpine@sha256:b0f9560a2de083e2cc7382e75f808c7381a32852a7ec49117deedb300e552b24",
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "NoticeDbSchemaTaskLogGroup"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "client"
              }
            },
            "MountPoints": [
              {
                "ContainerPath": "/work",
                "ReadOnly": false,
                "SourceVolume": "work"
              }
            ],
            "Name": "client",
            "ReadonlyRootFilesystem": true,
            "Secrets": [
              {
                "Name": "SCHEMA_OWNER_SECRET",
                "ValueFrom": {
                  "Fn::Sub": "${NoticeDbSecret}:password::"
                }
              }
            ]
          },
          {
            "Command": [
              "set -eu; case \"${RUN_ID:-}\" in \"\"|.*|*[!A-Za-z0-9._-]*) echo \"RUN_ID must name the run: letters, digits, '.', '_' and '-', not starting with '.'\" >&2; exit 2;; esac; aws s3 cp \"/work/out\" \"s3://${RUN_STORE_BUCKET}/${RUN_STORE_PREFIX}${RUN_ID}/out\"; aws s3 cp \"/work/err\" \"s3://${RUN_STORE_BUCKET}/${RUN_STORE_PREFIX}${RUN_ID}/err\"; aws s3 cp \"/work/exit\" \"s3://${RUN_STORE_BUCKET}/${RUN_STORE_PREFIX}${RUN_ID}/exit\""
            ],
            "DependsOn": [
              {
                "Condition": "COMPLETE",
                "ContainerName": "client"
              }
            ],
            "EntryPoint": [
              "sh",
              "-c"
            ],
            "Environment": [
              {
                "Name": "AWS_REGION",
                "Value": {
                  "Ref": "AWS::Region"
                }
              },
              {
                "Name": "RUN_STORE_BUCKET",
                "Value": {
                  "Fn::ImportValue": "hotel-system-bootstrap-RunStoreBucketName"
                }
              },
              {
                "Name": "RUN_STORE_PREFIX",
                "Value": "hotel.NoticeService.noticeDb/"
              }
            ],
            "Essential": true,
            "Image": "amazon/aws-cli:2.38.2@sha256:5d39fd52f236ed01c5c25fba66c9aebcfc6cbb88e7bb1b727c5fe1f150540597",
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "NoticeDbSchemaTaskLogGroup"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "copy-out"
              }
            },
            "MountPoints": [
              {
                "ContainerPath": "/work",
                "ReadOnly": false,
                "SourceVolume": "work"
              }
            ],
            "Name": "copy-out",
            "ReadonlyRootFilesystem": true
          }
        ],
        "Cpu": "256",
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "NoticeDbSchemaTaskExecutionRole",
            "Arn"
          ]
        },
        "Family": {
          "Fn::Sub": "${AWS::StackName}-notice-db-schema"
