{
  "compileOnSave": false,
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "dom"],
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": false,
    "experimentalDecorators": true,
    "importHelpers": true,
    "paths": {
      "@marram/system-api-common": ["./libs/system-api-common/src/index.ts"],
      "@marram/stay-service-api": ["./libs/stay-service-api/src/index.ts"],
      "@marram/notice-service-api": ["./libs/notice-service-api/src/index.ts"],
      "@marram/payment-mock-api": ["./libs/payment-mock-api/src/index.ts"],
      "@marram/email-mock-api": ["./libs/email-mock-api/src/index.ts"],
      "@marram/channel-mock-api": ["./libs/channel-mock-api/src/index.ts"],
      "@marram/system-api-state-common": ["./libs/system-api-state-common/src/index.ts"],
      "@marram/stay-service-api-state": ["./libs/stay-service-api-state/src/index.ts"],
      "@marram/notice-service-api-state": ["./libs/notice-service-api-state/src/index.ts"],
      "@marram/payment-mock-api-state": ["./libs/payment-mock-api-state/src/index.ts"],
      "@marram/email-mock-api-state": ["./libs/email-mock-api-state/src/index.ts"],
      "@marram/channel-mock-api-state": ["./libs/channel-mock-api-state/src/index.ts"],
      "@marram/system-api-common/testing": ["./libs/system-api-common/src/testing/index.ts"],
      "@marram/stay-service-api/testing": ["./libs/stay-service-api/src/testing/index.ts"],
      "@marram/notice-service-api/testing": ["./libs/notice-service-api/src/testing/index.ts"],
      "@marram/payment-mock-api/testing": ["./libs/payment-mock-api/src/testing/index.ts"],
      "@marram/email-mock-api/testing": ["./libs/email-mock-api/src/testing/index.ts"],
      "@marram/channel-mock-api/testing": ["./libs/channel-mock-api/src/testing/index.ts"],
      "@marram/ui-core": ["./libs/ui-core/src/index.ts"],
      "@marram/ui-core/testing": ["./libs/ui-core/src/testing/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "strictTemplates": true
  }
}
