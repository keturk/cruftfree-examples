# Settings of the git scripts for ONE machine. Copy this file to git-scripts.local.env (same folder)
# and fill in your own values. git-scripts.local.env is ignored by git and must never be committed:
# it names your machines. A real environment variable of the same name overrides it, and a command-line
# argument overrides both. Every line is optional.

# Where to look for a local model (Ollama): comma separated, host or host:port. Default: localhost.
# The host names listed here are also refused anywhere in the files to be committed.
CRUFTFREE_LOCAL_LLM_HOSTS=your-model-server:11434,another-server:11434

# Models to ask on each host, in order of preference, comma separated. A model already loaded on a
# host is tried first. Default: qwen3-coder:30b-ctx32k,qwen3.6:35b
CRUFTFREE_LOCAL_LLM_MODELS=your-preferred-model,your-second-model

# Full path of the Claude Code executable, for the Claude fallback, when it is not found on PATH.
# CRUFTFREE_CLAUDE_EXE=C:\path\to\claude.exe

# More text that must never be published (project or host names), comma separated, at least 4 characters each.
# CRUFTFREE_EXAMPLES_BLOCKED_TEXT=your-company-name,internal-hostname
