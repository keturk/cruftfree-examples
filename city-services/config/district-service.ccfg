config service cityservices.DistrictService {
  import "config/templates/infrastructure.ccfg";

  base {
    port = 8001;
    replicas = 1;
    healthCheck {
      path = "/health";
      initialDelay = "10s";
    }
    rdbms districtDb from postgisContainer(id: "f4c6cf3e-c0de-432c-8fcb-7cf9831d29f5", database: "cityservices_district");
    httpSecurity from localHttpSecurity(host: "cityservices-district-service");
    serviceCredentialOps from machineCredential();
    jobs {
      jobs {
        ConvertBoundaries {
          schedule = "* * * * *";
          timeout = "60s";
        }
      }
    }
    resilience {
      defaults {
        timeout = "10s";
      }
      dependencyPolicy {
        defaults {
          rdbms from standardDatabasePolicy();
        }
      }
    }
  }

  profile test as "test" extends base {
    alias env = "TEST";
    alias resource = "test";
  }

  profile aws as "aws" extends base {
    alias env = "AWS";
    alias resource = "aws";

    remoteConfigOps {
      appconfigMinPollSeconds = 15;
    }
    resources {
      requests {
        cpu = "100m";
        memory = "256Mi";
      }
      limits {
        cpu = "500m";
        memory = "512Mi";
      }
    }

    replicas = 2;
    scaling {
      replicas {
        min = 2;
        max = 4;
      }
      triggers = [];
    }
    replace rdbms districtDb from rdsPostgres(id: "f4c6cf3e-c0de-432c-8fcb-7cf9831d29f5", database: "cityservices_district", poolSize: 20, maxOverflow: 10);
  }

  profile development as "dev" extends aws {
    alias env = "DEV";
    alias resource = "dev";
  }

  profile production as "prod" extends base {
    alias env = "PROD";
    alias resource = "prod";
  }
}
