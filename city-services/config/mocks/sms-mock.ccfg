config service cityservices.SmsMock {
  import "config/templates/infrastructure.ccfg";

  base {
    port = 8090;
    replicas = 1;
    healthCheck {
      path = "/health";
      initialDelay = "10s";
    }
    rdbms smsDb from postgisContainer(id: "6d1f7a30-8c2e-4b5d-9f14-2a7c3e9b1d40", database: "cityservices_sms_mock");
    httpSecurity from localHttpSecurity(host: "cityservices-sms-mock");
    serviceCredentialOps from machineCredential();
    resilience {
      defaults {
        timeout = "10s";
      }
      dependencyPolicy {
        defaults {
          rdbms from standardDatabasePolicy();
        }
      }
    }
  }

  profile test as "test" extends base {
    alias env = "TEST";
    alias resource = "test";
  }

  profile aws as "aws" extends base {
    alias env = "AWS";
    alias resource = "aws";

    remoteConfigOps {
      appconfigMinPollSeconds = 15;
    }
    resources {
      requests {
        cpu = "100m";
        memory = "256Mi";
      }
    }
    scaling {
      replicas {
        min = 1;
        max = 1;
      }
      triggers = [];
    }

    replace rdbms smsDb from rdsPostgres(id: "6d1f7a30-8c2e-4b5d-9f14-2a7c3e9b1d40", database: "cityservices_sms_mock");
  }

  profile development as "dev" extends aws {
    alias env = "DEV";
    alias resource = "dev";
  }

  profile production as "prod" extends base {
    alias env = "PROD";
    alias resource = "prod";
  }
}
