config app finance.BackOffice {
  base {
    targets = ["angular"];
    clients {
      angular {
        scope = "@quillon";
      }
    }
    strings = ["config/strings/back-office.en-US.ccfg"];
  }
  profile test as "test" extends base {
    web { port = 4300; }
  }
  profile aws as "aws" extends base {
    web { domain { name = "backoffice.quillon.example.com"; } }
  }
  profile development as "dev" extends aws {
  }
  profile production as "prod" extends base {
    web { port = 4300; }
  }
}
