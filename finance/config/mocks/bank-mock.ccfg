config service finance.BankMock {
  import "config/templates/infrastructure.ccfg";

  base {
    port = 8090;
    language = "python";  // ComplianceService's agent needs Python, and one system generates in one language.
    replicas = 1;
    healthCheck {
      path = "/health";
      initialDelay = "10s";
    }
    rdbms bankDb from postgresContainer(id: "e7a32ff5-31a4-45e0-9da1-cbc729391840", database: "finance_bank_mock");
    httpSecurity from localHttpSecurity(host: "finance-bank-mock");
    serviceCredentialOps from machineCredential();
    resilience {
      defaults {
        timeout = "10s";
      }
      dependencyPolicy {
        defaults {
          rdbms from standardDatabasePolicy();
        }
      }
    }
  }

  profile test as "test" extends base {
    alias env = "TEST";
    alias resource = "test";
  }

  profile aws as "aws" extends base {
    alias env = "AWS";
    alias resource = "aws";

    remoteConfigOps {
      appconfigMinPollSeconds = 15;
    }
    resources {
      requests {
        cpu = "100m";
        memory = "256Mi";
      }
    }
    scaling {
      replicas {
        min = 1;
        max = 1;
      }
      triggers = [];
    }
    replace rdbms bankDb from rdsPostgres(id: "e7a32ff5-31a4-45e0-9da1-cbc729391840", database: "finance_bank_mock");
  }

  profile development as "dev" extends aws {
    alias env = "DEV";
    alias resource = "dev";
  }

  profile production as "prod" extends base {
    alias env = "PROD";
    alias resource = "prod";
  }
}
