config service finance.AccountService {
  import "config/templates/infrastructure.ccfg";

  base {
    port = 8001;
    language = "python";  // ComplianceService's agent needs Python, and one system generates in one language.
    replicas = 1;
    healthCheck {
      path = "/health";
      initialDelay = "10s";
    }
    rdbms accountDb from postgresContainer(id: "e35d42d1-b104-4438-a1ac-00c9ad13042e", database: "finance_account");
    pubsub mq from kafkaContainer();
    httpSecurity from localHttpSecurity(host: "finance-account-service");
    outboxOps from outboxBatches();
    kafkaOps from kafkaPolling();
    serviceCredentialOps from machineCredential();
    resilience {
      defaults {
        timeout = "10s";
      }
      dependencyPolicy {
        defaults {
          rdbms from standardDatabasePolicy();
        }
      }
    }
    secrets {
      // The default only exists on a local stack, where it matches the hash seeded in
      // seed/kyc-mock.cseed, so the example runs with nothing to configure. Any other deployment
      // must supply the handle's value.
      secret kyc_provider_api_key {
        required = true;
        purpose = "API key for the identity check vendor (KycProvider contract).";
        localDefault = "dev-only-kyc-key-not-a-credential";
      }
    }
  }

  profile test as "test" extends base {
    alias env = "TEST";
    alias resource = "test";
  }

  profile aws as "aws" extends base {
    alias env = "AWS";
    alias resource = "aws";

    remoteConfigOps {
      appconfigMinPollSeconds = 15;
    }
    resources {
      requests {
        cpu = "100m";
        memory = "256Mi";
      }
      limits {
        cpu = "500m";
        memory = "512Mi";
      }
    }
    // Consumers run as SQS-triggered Lambdas: the `mq` topics cross service boundaries, which on AWS
    // means SNS/SQS, and no language target runs an SQS pubsub consumer inside the service process.
    runtime { consumers = "decoupled"; }

    replicas = 2;
    scaling {
      replicas {
        min = 2;
        max = 4;
      }
      triggers = [];
    }
    replace rdbms accountDb from rdsPostgres(id: "e35d42d1-b104-4438-a1ac-00c9ad13042e", database: "finance_account", poolSize: 20, maxOverflow: 10);
    replace pubsub mq from snsSqs();
    // The machine identity is an operator-managed OIDC issuer on AWS, so its client secret is a handle
    // here: the value lives in the platform vault under this name, never in a generated artifact.
    secrets {
      secret machine_identity_client_secret {
        required = true;
        purpose = "OIDC client secret for the machine identity provider (external issuer on AWS).";
      }
    }
  }

  profile development as "dev" extends aws {
    alias env = "DEV";
    alias resource = "dev";
  }

  profile production as "prod" extends base {
    alias env = "PROD";
    alias resource = "prod";
  }
}
