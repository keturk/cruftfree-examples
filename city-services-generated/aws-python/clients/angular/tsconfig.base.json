{
  "compileOnSave": false,
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "dom"],
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": false,
    "experimentalDecorators": true,
    "importHelpers": true,
    "paths": {
      "@portalder/system-api-common": ["./libs/system-api-common/src/index.ts"],
      "@portalder/district-service-api": ["./libs/district-service-api/src/index.ts"],
      "@portalder/facility-service-api": ["./libs/facility-service-api/src/index.ts"],
      "@portalder/request-service-api": ["./libs/request-service-api/src/index.ts"],
      "@portalder/sms-mock-api": ["./libs/sms-mock-api/src/index.ts"],
      "@portalder/geocoder-mock-api": ["./libs/geocoder-mock-api/src/index.ts"],
      "@portalder/system-api-state-common": ["./libs/system-api-state-common/src/index.ts"],
      "@portalder/district-service-api-state": ["./libs/district-service-api-state/src/index.ts"],
      "@portalder/facility-service-api-state": ["./libs/facility-service-api-state/src/index.ts"],
      "@portalder/request-service-api-state": ["./libs/request-service-api-state/src/index.ts"],
      "@portalder/sms-mock-api-state": ["./libs/sms-mock-api-state/src/index.ts"],
      "@portalder/geocoder-mock-api-state": ["./libs/geocoder-mock-api-state/src/index.ts"],
      "@portalder/system-api-common/testing": ["./libs/system-api-common/src/testing/index.ts"],
      "@portalder/district-service-api/testing": ["./libs/district-service-api/src/testing/index.ts"],
      "@portalder/facility-service-api/testing": ["./libs/facility-service-api/src/testing/index.ts"],
      "@portalder/request-service-api/testing": ["./libs/request-service-api/src/testing/index.ts"],
      "@portalder/sms-mock-api/testing": ["./libs/sms-mock-api/src/testing/index.ts"],
      "@portalder/geocoder-mock-api/testing": ["./libs/geocoder-mock-api/src/testing/index.ts"],
      "@portalder/ui-core": ["./libs/ui-core/src/index.ts"],
      "@portalder/ui-core/testing": ["./libs/ui-core/src/testing/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "strictTemplates": true
  }
}
