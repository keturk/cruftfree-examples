{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Parameters": {
    "PreflightCodeKey": {
      "AllowedPattern": "[0-9A-Za-z!_.*'()/-]{1,1024}",
      "ConstraintDescription": "an S3 object key of unreserved characters, 1-1024 long",
      "Description": "Deployment-bucket key of the uploaded preflight function package.",
      "Type": "String"
    },
    "PreflightRunId": {
      "AllowedPattern": "[0-9A-Za-z-]{1,128}",
      "ConstraintDescription": "1-128 letters, digits or '-'",
      "Description": "A value that differs on every deploy, so the preflight runs each time.",
      "Type": "String"
    }
  },
  "Resources": {
    "Preflight": {
      "Properties": {
        "RunId": {
          "Ref": "PreflightRunId"
        },
        "SecretItems": [
          {
            "action_fn": "check_operator_secret",
            "effect": "API key for the address vendor (GeocoderProvider contract).",
            "handle": "geocoder_provider_api_key",
            "owning_integration": "geocoder_provider_api_key",
            "secret_name": "cityservices-request-service/geocoder_provider_api_key"
          },
          {
            "action_fn": "check_operator_secret",
            "effect": "OIDC client secret for the machine identity provider (external issuer on AWS).",
            "handle": "machine_identity_client_secret",
            "owning_integration": "machine_identity_client_secret",
            "secret_name": "cityservices-request-service/machine_identity_client_secret"
          },
          {
            "action_fn": "check_operator_secret",
            "effect": "API key for the text vendor (SmsProvider contract).",
            "handle": "sms_provider_api_key",
            "owning_integration": "sms_provider_api_key",
            "secret_name": "cityservices-request-service/sms_provider_api_key"
          },
          {
            "action_fn": "generate_owned_keypair_if_missing",
            "private_handle": "jwt_private_key",
            "private_secret_name": "jwt_private_key",
            "public_handle": "jwt_public_key",
            "public_secret_name": "jwt_public_key"
          }
        ],
        "ServiceTimeout": 360,
        "ServiceToken": {
          "Fn::GetAtt": [
            "PreflightFn",
            "Arn"
          ]
        }
      },
      "Type": "AWS::CloudFormation::CustomResource"
    },
    "PreflightFn": {
      "DependsOn": [
        "PreflightRoleDefaultPolicy",
        "PreflightRole"
      ],
      "Properties": {
        "Code": {
          "S3Bucket": {
            "Fn::ImportValue": "cityservices-system-bootstrap-DeploymentBucketName"
          },
          "S3Key": {
            "Ref": "PreflightCodeKey"
          }
        },
        "Handler": "preflight_handler.handler",
        "LoggingConfig": {
          "LogGroup": {
            "Ref": "PreflightLogGroup"
          }
        },
        "MemorySize": 256,
        "Role": {
          "Fn::GetAtt": [
            "PreflightRole",
            "Arn"
          ]
        },
        "Runtime": "python3.13",
        "Timeout": 300
      },
      "Type": "AWS::Lambda::Function"
    },
    "PreflightLogGroup": {
      "DeletionPolicy": "Delete",
      "Properties": {
        "RetentionInDays": 30
      },
      "Type": "AWS::Logs::LogGroup",
      "UpdateReplacePolicy": "Delete"
    },
    "PreflightRole": {
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": [
                "sts:AssumeRole"
              ],
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              }
            }
          ],
          "Version": "2012-10-17"
        }
      },
      "Type": "AWS::IAM::Role"
    },
    "PreflightRoleDefaultPolicy": {
      "Properties": {
        "PolicyDocument": {
          "Statement": [
            {
              "Action": [
                "logs:CreateLogStream",
                "logs:PutLogEvents"
              ],
              "Effect": "Allow",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "PreflightLogGroup",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${PreflightLogGroup.Arn}:*"
                }
              ]
            },
            {
              "Action": [
                "secretsmanager:DescribeSecret"
              ],
              "Effect": "Allow",
              "Resource": [
                {
                  "Fn::Sub": [
                    "arn:${AWS::Partition}:secretsmanager:${AWS::Region}:${AWS::AccountId}:secret:${Name}-??????",
                    {
                      "Name": "cityservices-request-service/geocoder_provider_api_key"
                    }
                  ]
                },
                {
                  "Fn::Sub": [
                    "arn:${AWS::Partition}:secretsmanager:${AWS::Region}:${AWS::AccountId}:secret:${Name}-??????",
                    {
                      "Name": "cityservices-request-service/machine_identity_client_secret"
                    }
                  ]
                },
                {
                  "Fn::Sub": [
                    "arn:${AWS::Partition}:secretsmanager:${AWS::Region}:${AWS::AccountId}:secret:${Name}-??????",
                    {
                      "Name": "cityservices-request-service/sms_provider_api_key"
                    }
                  ]
                },
                {
                  "Fn::Sub": [
                    "arn:${AWS::Partition}:secretsmanager:${AWS::Region}:${AWS::AccountId}:secret:${Name}-??????",
                    {
                      "Name": "jwt_public_key"
                    }
                  ]
                },
                {
                  "Fn::Sub": [
                    "arn:${AWS::Partition}:secretsmanager:${AWS::Region}:${AWS::AccountId}:secret:${Name}-??????",
                    {
                      "Name": "jwt_private_key"
                    }
                  ]
                }
              ]
            },
            {
              "Action": [
                "secretsmanager:GetSecretValue"
              ],
              "Effect": "Allow",
              "Resource": [
                {
                  "Fn::Sub": [
                    "arn:${AWS::Partition}:secretsmanager:${AWS::Region}:${AWS::AccountId}:secret:${Name}-??????",
                    {
                      "Name": "cityservices-request-service/geocoder_provider_api_key"
                    }
                  ]
                },
                {
                  "Fn::Sub": [
                    "arn:${AWS::Partition}:secretsmanager:${AWS::Region}:${AWS::AccountId}:secret:${Name}-??????",
                    {
                      "Name": "cityservices-request-service/machine_identity_client_secret"
                    }
                  ]
                },
                {
                  "Fn::Sub": [
                    "arn:${AWS::Partition}:secretsmanager:${AWS::Region}:${AWS::AccountId}:secret:${Name}-??????",
                    {
                      "Name": "cityservices-request-service/sms_provider_api_key"
                    }
                  ]
                }
              ]
            },
            {
              "Action": [
                "secretsmanager:CreateSecret",
                "secretsmanager:TagResource"
              ],
              "Effect": "Allow",
              "Resource": [
                {
                  "Fn::Sub": [
                    "arn:${AWS::Partition}:secretsmanager:${AWS::Region}:${AWS::AccountId}:secret:${Name}-??????",
                    {
                      "Name": "jwt_public_key"
                    }
                  ]
                },
                {
                  "Fn::Sub": [
                    "arn:${AWS::Partition}:secretsmanager:${AWS::Region}:${AWS::AccountId}:secret:${Name}-??????",
                    {
                      "Name": "jwt_private_key"
                    }
                  ]
                }
              ]
            }
          ],
          "Version": "2012-10-17"
        },
        "PolicyName": "PreflightRoleDefaultPolicy",
        "Roles": [
          {
            "Ref": "PreflightRole"
          }
        ]
      },
      "Type": "AWS::IAM::Policy"
    }
  }
}
