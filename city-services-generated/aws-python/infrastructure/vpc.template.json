    "InternetGatewayAttachment": {
      "Properties": {
        "InternetGatewayId": {
          "Ref": "InternetGateway"
        },
        "VpcId": {
          "Ref": "Vpc"
        }
      },
      "Type": "AWS::EC2::VPCGatewayAttachment"
    },
    "IsolatedSubnet1": {
      "Properties": {
        "AvailabilityZone": {
          "Fn::Select": [
            0,
