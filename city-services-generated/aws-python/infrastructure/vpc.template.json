{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Outputs": {
    "IsolatedSubnet1Id": {
      "Description": "Isolated subnet in AZ 1.",
      "Export": {
        "Name": "cityservices-system-vpc-IsolatedSubnet1Id"
      },
      "Value": {
        "Ref": "IsolatedSubnet1"
      }
    },
    "IsolatedSubnet2Id": {
      "Description": "Isolated subnet in AZ 2.",
      "Export": {
        "Name": "cityservices-system-vpc-IsolatedSubnet2Id"
      },
      "Value": {
        "Ref": "IsolatedSubnet2"
      }
    },
    "PrivateSubnet1Id": {
      "Description": "Private subnet in AZ 1.",
      "Export": {
        "Name": "cityservices-system-vpc-PrivateSubnet1Id"
      },
      "Value": {
        "Ref": "PrivateSubnet1"
      }
    },
    "PrivateSubnet2Id": {
      "Description": "Private subnet in AZ 2.",
      "Export": {
        "Name": "cityservices-system-vpc-PrivateSubnet2Id"
      },
      "Value": {
        "Ref": "PrivateSubnet2"
      }
    },
    "PublicSubnet1Id": {
      "Description": "Public subnet in AZ 1.",
      "Export": {
        "Name": "cityservices-system-vpc-PublicSubnet1Id"
      },
      "Value": {
        "Ref": "PublicSubnet1"
      }
    },
    "PublicSubnet2Id": {
      "Description": "Public subnet in AZ 2.",
      "Export": {
        "Name": "cityservices-system-vpc-PublicSubnet2Id"
      },
      "Value": {
        "Ref": "PublicSubnet2"
      }
    },
    "VpcCidrBlock": {
      "Description": "The VPC's CIDR block, for groups admitting traffic from the VPC.",
      "Export": {
        "Name": "cityservices-system-vpc-VpcCidrBlock"
      },
      "Value": {
        "Fn::GetAtt": [
          "Vpc",
          "CidrBlock"
        ]
      }
    },
    "VpcId": {
      "Description": "The application VPC.",
      "Export": {
        "Name": "cityservices-system-vpc-VpcId"
      },
      "Value": {
        "Ref": "Vpc"
      }
    }
  },
  "Parameters": {
    "DefaultSecurityGroupCodeKey": {
      "AllowedPattern": "[0-9A-Za-z!_.*'()/-]{1,1024}",
      "ConstraintDescription": "an S3 object key of unreserved characters, 1-1024 long",
      "Description": "Deployment-bucket key of the uploaded default security group function package.",
      "Type": "String"
    }
  },
  "Resources": {
    "CloudWatchLogsEndpoint": {
      "Properties": {
        "PrivateDnsEnabled": true,
        "SecurityGroupIds": [
          {
            "Ref": "CloudWatchLogsEndpointSecurityGroup"
          }
        ],
        "ServiceName": {
          "Fn::Sub": "com.amazonaws.${AWS::Region}.logs"
        },
        "SubnetIds": [
          {
            "Ref": "PrivateSubnet1"
          },
          {
            "Ref": "PrivateSubnet2"
          }
        ],
        "VpcEndpointType": "Interface",
        "VpcId": {
          "Ref": "Vpc"
        }
      },
      "Type": "AWS::EC2::VPCEndpoint"
    },
    "CloudWatchLogsEndpointSecurityGroup": {
      "Properties": {
        "GroupDescription": "HTTPS from the VPC to the CloudWatchLogsEndpoint",
        "SecurityGroupEgress": [
          {
            "CidrIp": "127.0.0.1/32",
            "Description": "Inline anchor so EC2 adds no default allow-all egress rule",
            "IpProtocol": "-1"
          }
        ],
        "SecurityGroupIngress": [
          {
            "CidrIp": "10.0.0.0/16",
            "Description": "HTTPS from the VPC",
            "FromPort": 443,
            "IpProtocol": "tcp",
            "ToPort": 443
          }
        ],
        "VpcId": {
          "Ref": "Vpc"
        }
      },
      "Type": "AWS::EC2::SecurityGroup"
    },
    "DefaultSecurityGroupClosed": {
      "Properties": {
        "GroupId": {
          "Fn::GetAtt": [
            "Vpc",
            "DefaultSecurityGroup"
          ]
        },
        "ServiceTimeout": 120,
        "ServiceToken": {
          "Fn::GetAtt": [
            "DefaultSecurityGroupFn",
            "Arn"
          ]
        }
      },
      "Type": "AWS::CloudFormation::CustomResource"
    },
    "DefaultSecurityGroupFn": {
      "DependsOn": [
        "DefaultSecurityGroupRoleDefaultPolicy",
        "DefaultSecurityGroupRole"
      ],
      "Properties": {
        "Code": {
          "S3Bucket": {
            "Fn::ImportValue": "cityservices-system-bootstrap-DeploymentBucketName"
          },
          "S3Key": {
            "Ref": "DefaultSecurityGroupCodeKey"
          }
        },
        "Handler": "index.cfn_handler",
        "LoggingConfig": {
          "LogGroup": {
            "Ref": "DefaultSecurityGroupLogGroup"
          }
        },
        "Role": {
          "Fn::GetAtt": [
            "DefaultSecurityGroupRole",
            "Arn"
          ]
        },
        "Runtime": "python3.13",
        "Timeout": 60
      },
      "Type": "AWS::Lambda::Function"
    },
    "DefaultSecurityGroupLogGroup": {
      "DeletionPolicy": "Delete",
      "Properties": {
        "RetentionInDays": 30
      },
      "Type": "AWS::Logs::LogGroup",
      "UpdateReplacePolicy": "Delete"
    },
    "DefaultSecurityGroupRole": {
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": [
                "sts:AssumeRole"
              ],
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              }
            }
          ],
          "Version": "2012-10-17"
        }
      },
      "Type": "AWS::IAM::Role"
    },
    "DefaultSecurityGroupRoleDefaultPolicy": {
      "Properties": {
        "PolicyDocument": {
          "Statement": [
            {
              "Action": [
                "logs:CreateLogStream",
                "logs:PutLogEvents"
              ],
              "Effect": "Allow",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "DefaultSecurityGroupLogGroup",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${DefaultSecurityGroupLogGroup.Arn}:*"
                }
              ]
            },
            {
              "Action": [
                "ec2:RevokeSecurityGroupIngress",
                "ec2:RevokeSecurityGroupEgress"
              ],
              "Effect": "Allow",
              "Resource": [
                {
                  "Fn::Sub": [
                    "arn:${AWS::Partition}:ec2:${AWS::Region}:${AWS::AccountId}:security-group/${Group}",
                    {
                      "Group": {
                        "Fn::GetAtt": [
                          "Vpc",
                          "DefaultSecurityGroup"
                        ]
                      }
                    }
                  ]
                }
              ]
            },
            {
              "Action": [
                "ec2:DescribeSecurityGroups"
              ],
              "Effect": "Allow",
              "Resource": [
                "*"
              ]
            }
          ],
          "Version": "2012-10-17"
        },
        "PolicyName": "DefaultSecurityGroupRoleDefaultPolicy",
        "Roles": [
          {
            "Ref": "DefaultSecurityGroupRole"
          }
        ]
      },
      "Type": "AWS::IAM::Policy"
    },
    "EcrApiEndpoint": {
      "Properties": {
        "PrivateDnsEnabled": true,
        "SecurityGroupIds": [
          {
            "Ref": "EcrApiEndpointSecurityGroup"
          }
        ],
        "ServiceName": {
          "Fn::Sub": "com.amazonaws.${AWS::Region}.ecr.api"
        },
