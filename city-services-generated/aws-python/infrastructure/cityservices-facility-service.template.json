{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Outputs": {
    "ServiceSecurityGroupId": {
      "Description": "The service's security group, which each callee admits.",
      "Export": {
        "Name": "cityservices-system-cityservices-facility-service-ServiceSecurityGroupId"
      },
      "Value": {
        "Fn::GetAtt": [
          "ServiceSecurityGroup",
          "GroupId"
        ]
      }
    }
  },
  "Parameters": {
    "CityservicesFacilityServiceImageTag": {
      "AllowedPattern": "[0-9a-f]{64}",
      "ConstraintDescription": "a lowercase SHA-256 hex content hash computed by the deploy script; never a floating tag such as 'latest'",
      "Description": "Resolved content-hash tag of the 'cityservices_facility_service' image, pushed by the deploy script.",
      "Type": "String"
    },
    "PreflightCodeKey": {
      "AllowedPattern": "[0-9A-Za-z!_.*'()/-]{1,1024}",
      "ConstraintDescription": "an S3 object key of unreserved characters, 1-1024 long",
      "Description": "Deployment-bucket key of the uploaded preflight function package.",
      "Type": "String"
    },
    "PreflightRunId": {
      "AllowedPattern": "[0-9A-Za-z-]{1,128}",
      "ConstraintDescription": "1-128 letters, digits or '-'",
      "Description": "A value that differs on every deploy, so the preflight runs each time.",
      "Type": "String"
    }
  },
  "Resources": {
    "AppConfigDeploymentConnections": {
      "Properties": {
        "ApplicationId": {
          "Ref": "AppconfigApplication"
        },
        "ConfigurationProfileId": {
          "Ref": "AppConfigProfileConnections"
        },
        "ConfigurationVersion": {
          "Ref": "AppConfigHostedVersionConnections"
        },
        "DeploymentStrategyId": {
          "Ref": "AppconfigDeploymentStrategy"
        },
        "EnvironmentId": {
          "Ref": "AppconfigEnvironment"
        }
      },
      "Type": "AWS::AppConfig::Deployment"
    },
    "AppConfigDeploymentSettings": {
      "Properties": {
        "ApplicationId": {
          "Ref": "AppconfigApplication"
        },
        "ConfigurationProfileId": {
          "Ref": "AppConfigProfileSettings"
        },
        "ConfigurationVersion": {
          "Ref": "AppConfigHostedVersionSettings"
        },
        "DeploymentStrategyId": {
          "Ref": "AppconfigDeploymentStrategy"
        },
        "EnvironmentId": {
          "Ref": "AppconfigEnvironment"
        }
      },
      "Type": "AWS::AppConfig::Deployment"
    },
    "AppConfigHostedVersionConnections": {
      "Properties": {
        "ApplicationId": {
          "Ref": "AppconfigApplication"
        },
        "ConfigurationProfileId": {
          "Ref": "AppConfigProfileConnections"
        },
        "Content": {
          "Fn::Join": [
            "",
            [
              "{\"facility_db_database\": \"cityservices_facility\", \"facility_db_port\": 5432, \"facility_db_user\": \"cityservices_facility_service_facility_db_rw\", \"facility_db_host\": \"",
              {
                "Fn::ImportValue": "cityservices-system-cityservices-facility-service-data-FacilityDbDbHost"
              },
              "\"}"
            ]
          ]
        },
        "ContentType": "application/json"
      },
      "Type": "AWS::AppConfig::HostedConfigurationVersion"
    },
    "AppConfigHostedVersionSettings": {
      "Properties": {
        "ApplicationId": {
          "Ref": "AppconfigApplication"
        },
        "ConfigurationProfileId": {
          "Ref": "AppConfigProfileSettings"
        },
        "Content": "{\"debugMode\": false}",
        "ContentType": "application/json"
      },
      "Type": "AWS::AppConfig::HostedConfigurationVersion"
    },
    "AppConfigProfileConnections": {
      "Properties": {
        "ApplicationId": {
          "Ref": "AppconfigApplication"
        },
        "LocationUri": "hosted",
        "Name": "connections",
        "Type": "AWS.Freeform"
      },
      "Type": "AWS::AppConfig::ConfigurationProfile"
    },
    "AppConfigProfileSettings": {
      "Properties": {
        "ApplicationId": {
          "Ref": "AppconfigApplication"
        },
        "LocationUri": "hosted",
        "Name": "settings",
        "Type": "AWS.Freeform"
      },
      "Type": "AWS::AppConfig::ConfigurationProfile"
    },
    "AppconfigApplication": {
      "Properties": {
        "Description": "Config store for cityservices_facility_service",
        "Name": "portalder"
      },
      "Type": "AWS::AppConfig::Application"
    },
    "AppconfigDeploymentStrategy": {
      "Properties": {
        "DeploymentDurationInMinutes": 10,
        "FinalBakeTimeInMinutes": 0,
        "GrowthFactor": 100.0,
        "GrowthType": "LINEAR",
        "Name": "cityservices_facility_service-linear",
        "ReplicateTo": "NONE"
      },
      "Type": "AWS::AppConfig::DeploymentStrategy"
    },
    "AppconfigEnvironment": {
      "Properties": {
        "ApplicationId": {
          "Ref": "AppconfigApplication"
        },
        "Name": "local"
      },
      "Type": "AWS::AppConfig::Environment"
    },
    "CloudMapService": {
      "Properties": {
        "DnsConfig": {
          "DnsRecords": [
            {
              "TTL": 10,
              "Type": "A"
            }
          ],
          "NamespaceId": {
            "Fn::ImportValue": "cityservices-system-ecs-NamespaceId"
          },
          "RoutingPolicy": "MULTIVALUE"
        },
        "HealthCheckCustomConfig": {
          "FailureThreshold": 1
        },
        "Name": "cityservices-facility-service",
        "NamespaceId": {
          "Fn::ImportValue": "cityservices-system-ecs-NamespaceId"
        }
      },
      "Type": "AWS::ServiceDiscovery::Service"
    },
    "ConfigPreflight": {
      "DependsOn": [
        "AppConfigDeploymentSettings",
        "AppConfigDeploymentConnections"
      ],
      "Properties": {
        "ConfigItems": [
          {
            "action_fn": "seed_config_default",
            "application": {
              "Ref": "AppconfigApplication"
            },
            "content_shape": "freeform",
            "default_value": "\"cityservices_facility\"",
            "environment": {
              "Ref": "AppconfigEnvironment"
            },
            "key": "facility_db_database",
            "profile": {
              "Ref": "AppConfigProfileConnections"
            }
          },
          {
            "action_fn": "check_config_key",
            "application": {
              "Ref": "AppconfigApplication"
            },
            "environment": {
              "Ref": "AppconfigEnvironment"
            },
            "key": "facility_db_host",
            "profile": {
              "Ref": "AppConfigProfileConnections"
            }
          },
          {
            "action_fn": "seed_config_default",
            "application": {
              "Ref": "AppconfigApplication"
            },
            "content_shape": "freeform",
            "default_value": "5432",
            "environment": {
              "Ref": "AppconfigEnvironment"
            },
            "key": "facility_db_port",
            "profile": {
              "Ref": "AppConfigProfileConnections"
            }
          },
          {
            "action_fn": "check_config_key",
            "application": {
              "Ref": "AppconfigApplication"
            },
            "environment": {
              "Ref": "AppconfigEnvironment"
            },
            "key": "facility_db_user",
            "profile": {
              "Ref": "AppConfigProfileConnections"
            }
          },
          {
            "action_fn": "seed_config_default",
            "application": {
              "Ref": "AppconfigApplication"
            },
            "content_shape": "freeform",
            "default_value": "false",
            "environment": {
              "Ref": "AppconfigEnvironment"
            },
            "key": "debugMode",
            "profile": {
              "Ref": "AppConfigProfileSettings"
            }
          }
        ],
        "RunId": {
          "Ref": "PreflightRunId"
        },
        "ServiceTimeout": 360,
        "ServiceToken": {
          "Fn::GetAtt": [
            "ConfigPreflightFn",
            "Arn"
          ]
        }
      },
      "Type": "AWS::CloudFormation::CustomResource"
    },
    "ConfigPreflightFn": {
      "DependsOn": [
        "ConfigPreflightRoleDefaultPolicy",
        "ConfigPreflightRole"
      ],
      "Properties": {
        "Code": {
          "S3Bucket": {
            "Fn::ImportValue": "cityservices-system-bootstrap-DeploymentBucketName"
          },
          "S3Key": {
            "Ref": "PreflightCodeKey"
          }
        },
        "Handler": "preflight_handler.handler",
        "LoggingConfig": {
          "LogGroup": {
            "Ref": "ConfigPreflightLogGroup"
          }
        },
        "MemorySize": 256,
        "Role": {
          "Fn::GetAtt": [
            "ConfigPreflightRole",
            "Arn"
          ]
        },
        "Runtime": "python3.13",
        "Timeout": 300
      },
      "Type": "AWS::Lambda::Function"
    },
    "ConfigPreflightLogGroup": {
      "DeletionPolicy": "Delete",
      "Properties": {
        "RetentionInDays": 30
      },
      "Type": "AWS::Logs::LogGroup",
      "UpdateReplacePolicy": "Delete"
    },
    "ConfigPreflightRole": {
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": [
                "sts:AssumeRole"
              ],
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              }
            }
          ],
          "Version": "2012-10-17"
        }
      },
      "Type": "AWS::IAM::Role"
    },
    "ConfigPreflightRoleDefaultPolicy": {
      "Properties": {
        "PolicyDocument": {
          "Statement": [
            {
              "Action": [
                "logs:CreateLogStream",
                "logs:PutLogEvents"
              ],
              "Effect": "Allow",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "ConfigPreflightLogGroup",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${ConfigPreflightLogGroup.Arn}:*"
                }
              ]
            },
            {
              "Action": [
                "appconfig:StartConfigurationSession",
                "appconfig:GetLatestConfiguration"
              ],
              "Effect": "Allow",
              "Resource": [
                {
                  "Fn::Sub": [
                    "arn:${AWS::Partition}:appconfig:${AWS::Region}:${AWS::AccountId}:application/${ApplicationId}/environment/${EnvironmentId}/configuration/${ConfigurationProfileId}",
                    {
                      "ApplicationId": {
                        "Ref": "AppconfigApplication"
                      },
                      "ConfigurationProfileId": {
                        "Ref": "AppConfigProfileConnections"
                      },
                      "EnvironmentId": {
                        "Ref": "AppconfigEnvironment"
                      }
                    }
                  ]
                },
                {
                  "Fn::Sub": [
                    "arn:${AWS::Partition}:appconfig:${AWS::Region}:${AWS::AccountId}:application/${ApplicationId}/environment/${EnvironmentId}/configuration/${ConfigurationProfileId}",
                    {
                      "ApplicationId": {
                        "Ref": "AppconfigApplication"
                      },
                      "ConfigurationProfileId": {
                        "Ref": "AppConfigProfileSettings"
                      },
                      "EnvironmentId": {
                        "Ref": "AppconfigEnvironment"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "Action": [
                "appconfig:CreateHostedConfigurationVersion"
              ],
              "Effect": "Allow",
              "Resource": [
                {
                  "Fn::Sub": [
                    "arn:${AWS::Partition}:appconfig:${AWS::Region}:${AWS::AccountId}:application/${ApplicationId}",
                    {
                      "ApplicationId": {
                        "Ref": "AppconfigApplication"
                      }
                    }
                  ]
                },
                {
                  "Fn::Sub": [
                    "arn:${AWS::Partition}:appconfig:${AWS::Region}:${AWS::AccountId}:application/${ApplicationId}/configurationprofile/${ConfigurationProfileId}",
                    {
                      "ApplicationId": {
                        "Ref": "AppconfigApplication"
                      },
                      "ConfigurationProfileId": {
                        "Ref": "AppConfigProfileConnections"
                      }
                    }
                  ]
                },
                {
                  "Fn::Sub": [
                    "arn:${AWS::Partition}:appconfig:${AWS::Region}:${AWS::AccountId}:application/${ApplicationId}/configurationprofile/${ConfigurationProfileId}",
                    {
                      "ApplicationId": {
                        "Ref": "AppconfigApplication"
                      },
                      "ConfigurationProfileId": {
                        "Ref": "AppConfigProfileSettings"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "Action": [
                "appconfig:StartDeployment"
              ],
              "Effect": "Allow",
              "Resource": [
                {
                  "Fn::Sub": [
                    "arn:${AWS::Partition}:appconfig:${AWS::Region}:${AWS::AccountId}:application/${ApplicationId}",
                    {
                      "ApplicationId": {
                        "Ref": "AppconfigApplication"
                      }
                    }
                  ]
                },
                {
                  "Fn::Sub": [
                    "arn:${AWS::Partition}:appconfig:${AWS::Region}:${AWS::AccountId}:application/${ApplicationId}/configurationprofile/${ConfigurationProfileId}",
                    {
                      "ApplicationId": {
                        "Ref": "AppconfigApplication"
                      },
                      "ConfigurationProfileId": {
                        "Ref": "AppConfigProfileConnections"
                      }
                    }
                  ]
                },
                {
                  "Fn::Sub": [
                    "arn:${AWS::Partition}:appconfig:${AWS::Region}:${AWS::AccountId}:application/${ApplicationId}/configurationprofile/${ConfigurationProfileId}",
                    {
                      "ApplicationId": {
                        "Ref": "AppconfigApplication"
                      },
                      "ConfigurationProfileId": {
                        "Ref": "AppConfigProfileSettings"
                      }
                    }
                  ]
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:appconfig:${AWS::Region}:${AWS::AccountId}:deploymentstrategy/AppConfig.AllAtOnce"
                },
                {
                  "Fn::Sub": [
                    "arn:${AWS::Partition}:appconfig:${AWS::Region}:${AWS::AccountId}:application/${ApplicationId}/environment/${EnvironmentId}",
                    {
                      "ApplicationId": {
                        "Ref": "AppconfigApplication"
                      },
                      "EnvironmentId": {
                        "Ref": "AppconfigEnvironment"
                      }
                    }
                  ]
                }
              ]
            }
          ],
          "Version": "2012-10-17"
        },
        "PolicyName": "ConfigPreflightRoleDefaultPolicy",
        "Roles": [
          {
            "Ref": "ConfigPreflightRole"
          }
        ]
      },
      "Type": "AWS::IAM::Policy"
    },
    "CpuScaling": {
      "Properties": {
        "PolicyName": "CpuScaling",
        "PolicyType": "TargetTrackingScaling",
        "ScalingTargetId": {
          "Ref": "ScalableTarget"
        },
        "TargetTrackingScalingPolicyConfiguration": {
          "PredefinedMetricSpecification": {
            "PredefinedMetricType": "ECSServiceAverageCPUUtilization"
          },
          "ScaleInCooldown": 60,
          "ScaleOutCooldown": 60,
          "TargetValue": 70
        }
      },
      "Type": "AWS::ApplicationAutoScaling::ScalingPolicy"
    },
    "DLQConvertShapes": {
      "DeletionPolicy": "Delete",
      "Properties": {
        "MessageRetentionPeriod": 1209600,
        "QueueName": "cityservices_facility_service-scheduled-convert_shapes-dlq",
        "SqsManagedSseEnabled": true
      },
      "Type": "AWS::SQS::Queue",
      "UpdateReplacePolicy": "Delete"
    },
    "DLQConvertShapesPolicy": {
      "Properties": {
        "PolicyDocument": {
          "Statement": [
            {
              "Action": [
                "sqs:SendMessage"
              ],
              "Condition": {
                "ArnEquals": {
                  "aws:SourceArn": {
                    "Fn::GetAtt": [
                      "RuleConvertShapes",
                      "Arn"
                    ]
                  }
                }
              },
              "Effect": "Allow",
              "Principal": {
                "Service": "events.amazonaws.com"
              },
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "DLQConvertShapes",
                    "Arn"
                  ]
                }
              ]
            }
          ],
          "Version": "2012-10-17"
        },
        "Queues": [
          {
            "Ref": "DLQConvertShapes"
          }
        ]
      },
      "Type": "AWS::SQS::QueuePolicy"
    },
    "FacilityDbDbIngress": {
      "Properties": {
        "Description": "Database access to facilityDb",
        "FromPort": 5432,
        "GroupId": {
          "Fn::ImportValue": "cityservices-system-cityservices-facility-service-data-FacilityDbDbSecurityGroupId"
        },
        "IpProtocol": "tcp",
        "SourceSecurityGroupId": {
          "Fn::GetAtt": [
            "ServiceSecurityGroup",
            "GroupId"
          ]
        },
        "ToPort": 5432
      },
      "Type": "AWS::EC2::SecurityGroupIngress"
    },
    "FargateService": {
      "DependsOn": [
        "TaskRoleDefaultPolicy",
        "TaskRole",
        "ConfigPreflight"
      ],
      "Properties": {
        "Cluster": {
          "Fn::ImportValue": "cityservices-system-ecs-ClusterName"
        },
        "DeploymentConfiguration": {
          "MaximumPercent": 200,
          "MinimumHealthyPercent": 50
        },
        "DesiredCount": 2,
        "EnableECSManagedTags": false,
        "HealthCheckGracePeriodSeconds": 60,
        "LaunchType": "FARGATE",
        "LoadBalancers": [
          {
            "ContainerName": "cityservices_facility_service",
            "ContainerPort": 8002,
            "TargetGroupArn": {
              "Fn::ImportValue": "cityservices-system-gateway-nlb-CityservicesFacilityServiceNlbTargetGroupArn"
            }
          }
        ],
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "DISABLED",
            "SecurityGroups": [
              {
                "Fn::GetAtt": [
                  "ServiceSecurityGroup",
                  "GroupId"
                ]
              }
            ],
            "Subnets": [
              {
                "Fn::ImportValue": "cityservices-system-vpc-PrivateSubnet1Id"
              },
              {
                "Fn::ImportValue": "cityservices-system-vpc-PrivateSubnet2Id"
              }
            ]
          }
        },
        "ServiceRegistries": [
          {
            "RegistryArn": {
              "Fn::GetAtt": [
                "CloudMapService",
                "Arn"
              ]
            }
          }
        ],
        "TaskDefinition": {
          "Ref": "TaskDefinition"
        }
      },
      "Type": "AWS::ECS::Service"
    },
    "LogGroup": {
      "DeletionPolicy": "Delete",
      "Properties": {
        "LogGroupName": "/ecs/cityservices_facility_service",
        "RetentionInDays": 30
      },
      "Type": "AWS::Logs::LogGroup",
      "UpdateReplacePolicy": "Delete"
    },
    "RuleConvertShapes": {
      "Properties": {
        "Name": "cityservices_facility_service-convert_shapes",
        "ScheduleExpression": "cron(* * * * ? *)",
        "State": "ENABLED",
        "Targets": [
          {
            "Arn": {
              "Fn::ImportValue": "cityservices-system-ecs-ClusterArn"
            },
            "DeadLetterConfig": {
              "Arn": {
                "Fn::GetAtt": [
                  "DLQConvertShapes",
                  "Arn"
                ]
              }
            },
            "EcsParameters": {
              "LaunchType": "FARGATE",
              "NetworkConfiguration": {
                "AwsVpcConfiguration": {
                  "AssignPublicIp": "DISABLED",
                  "SecurityGroups": [
                    {
                      "Fn::GetAtt": [
                        "ServiceSecurityGroup",
                        "GroupId"
                      ]
                    }
                  ],
                  "Subnets": [
                    {
                      "Fn::ImportValue": "cityservices-system-vpc-PrivateSubnet1Id"
                    },
                    {
                      "Fn::ImportValue": "cityservices-system-vpc-PrivateSubnet2Id"
                    }
                  ]
                }
              },
              "TaskCount": 1,
              "TaskDefinitionArn": {
                "Ref": "TaskDefinition"
              }
            },
            "Id": "Target0",
            "Input": "{\"containerOverrides\":[{\"name\":\"cityservices_facility_service\",\"command\":[\"python\",\"-m\",\"cityservices_facility_service.jobs.runner\",\"--job\",\"ConvertShapes\"]}]}",
            "RetryPolicy": {
              "MaximumEventAgeInSeconds": 3600,
              "MaximumRetryAttempts": 2
            },
            "RoleArn": {
              "Fn::GetAtt": [
                "TaskDefinitionEventsRole",
                "Arn"
              ]
            }
          }
        ]
      },
      "Type": "AWS::Events::Rule"
    },
    "ScalableTarget": {
      "Properties": {
        "MaxCapacity": 4,
        "MinCapacity": 2,
        "ResourceId": {
          "Fn::Join": [
            "/",
            [
              "service",
              {
                "Fn::ImportValue": "cityservices-system-ecs-ClusterName"
              },
              {
                "Fn::GetAtt": [
                  "FargateService",
                  "Name"
                ]
              }
            ]
          ]
        },
        "RoleARN": {
          "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/aws-service-role/ecs.application-autoscaling.amazonaws.com/AWSServiceRoleForApplicationAutoScaling_ECSService"
        },
        "ScalableDimension": "ecs:service:DesiredCount",
        "ServiceNamespace": "ecs"
      },
      "Type": "AWS::ApplicationAutoScaling::ScalableTarget"
    },
    "ServiceDashboard": {
      "Properties": {
        "DashboardBody": "{\"widgets\": [{\"type\": \"metric\", \"x\": 0, \"y\": 0, \"width\": 12, \"height\": 6, \"properties\": {\"metrics\": [[\"AWS/ECS\", \"CPUUtilization\", \"ServiceName\", \"cityservices.FacilityService\", \"ClusterName\", \"cityservices.FacilityService-cluster\", {\"stat\": \"Average\"}]], \"period\": 30, \"region\": \"us-east-1\", \"title\": \"ECS CPU Utilization\", \"stat\": \"Average\", \"yAxis\": {\"left\": {\"min\": 0, \"max\": 100}}}}, {\"type\": \"metric\", \"x\": 12, \"y\": 0, \"width\": 12, \"height\": 6, \"properties\": {\"metrics\": [[\"AWS/ECS\", \"MemoryUtilization\", \"ServiceName\", \"cityservices.FacilityService\", \"ClusterName\", \"cityservices.FacilityService-cluster\", {\"stat\": \"Average\"}]], \"period\": 30, \"region\": \"us-east-1\", \"title\": \"ECS Memory Utilization\", \"stat\": \"Average\", \"yAxis\": {\"left\": {\"min\": 0, \"max\": 100}}}}, {\"type\": \"metric\", \"x\": 0, \"y\": 6, \"width\": 12, \"height\": 6, \"properties\": {\"metrics\": [[\"AWS/ApiGateway\", \"4XXError\", \"ApiName\", \"cityservices.FacilityService\", {\"stat\": \"Sum\", \"label\": \"4XX\"}], [\"AWS/ApiGateway\", \"5XXError\", \"ApiName\", \"cityservices.FacilityService\", {\"stat\": \"Sum\", \"label\": \"5XX\"}]], \"period\": 30, \"region\": \"us-east-1\", \"title\": \"API Gateway Errors - cityservices.FacilityService\"}}, {\"type\": \"metric\", \"x\": 12, \"y\": 6, \"width\": 12, \"height\": 6, \"properties\": {\"metrics\": [[\"AWS/ApiGateway\", \"Count\", \"ApiName\", \"cityservices.FacilityService\", {\"stat\": \"Sum\", \"label\": \"Requests\"}], [\"AWS/ApiGateway\", \"Latency\", \"ApiName\", \"cityservices.FacilityService\", {\"stat\": \"Average\", \"label\": \"Latency\"}]], \"period\": 30, \"region\": \"us-east-1\", \"title\": \"API Gateway Requests & Latency - cityservices.FacilityService\"}}, {\"type\": \"metric\", \"x\": 0, \"y\": 12, \"width\": 12, \"height\": 6, \"properties\": {\"metrics\": [[\"AWS/RDS\", \"CPUUtilization\", \"D