{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Outputs": {
    "AppConfigApplicationId": {
      "Description": "AppConfig application the service's functions read their configuration from.",
      "Export": {
        "Name": "cityservices-system-cityservices-request-service-AppConfigApplicationId"
      },
      "Value": {
        "Ref": "AppconfigApplication"
      }
    },
    "AppConfigEnvironmentId": {
      "Description": "AppConfig environment the service's functions read their configuration from.",
      "Export": {
        "Name": "cityservices-system-cityservices-request-service-AppConfigEnvironmentId"
      },
      "Value": {
        "Ref": "AppconfigEnvironment"
      }
    },
    "RequestEventsQueueArn": {
      "Description": "ARN of the RequestEvents_queue queue a consumer function reads.",
      "Export": {
        "Name": "cityservices-system-cityservices-request-service-RequestEventsQueueArn"
      },
      "Value": {
        "Fn::GetAtt": [
          "RequestEventsQueue",
          "Arn"
        ]
      }
    },
    "ServiceSecurityGroupId": {
      "Description": "The service's security group, which each callee admits.",
      "Export": {
        "Name": "cityservices-system-cityservices-request-service-ServiceSecurityGroupId"
      },
      "Value": {
        "Fn::GetAtt": [
          "ServiceSecurityGroup",
          "GroupId"
        ]
      }
    }
  },
  "Parameters": {
    "CityservicesRequestServiceImageTag": {
      "AllowedPattern": "[0-9a-f]{64}",
      "ConstraintDescription": "a lowercase SHA-256 hex content hash computed by the deploy script; never a floating tag such as 'latest'",
      "Description": "Resolved content-hash tag of the 'cityservices_request_service' image, pushed by the deploy script.",
      "Type": "String"
    },
    "PreflightCodeKey": {
      "AllowedPattern": "[0-9A-Za-z!_.*'()/-]{1,1024}",
      "ConstraintDescription": "an S3 object key of unreserved characters, 1-1024 long",
      "Description": "Deployment-bucket key of the uploaded preflight function package.",
      "Type": "String"
    },
    "PreflightRunId": {
      "AllowedPattern": "[0-9A-Za-z-]{1,128}",
      "ConstraintDescription": "1-128 letters, digits or '-'",
      "Description": "A value that differs on every deploy, so the preflight runs each time.",
      "Type": "String"
    }
  },
  "Resources": {
    "AppConfigDeploymentConnections": {
      "Properties": {
        "ApplicationId": {
          "Ref": "AppconfigApplication"
        },
        "ConfigurationProfileId": {
          "Ref": "AppConfigProfileConnections"
        },
        "ConfigurationVersion": {
          "Ref": "AppConfigHostedVersionConnections"
        },
        "DeploymentStrategyId": {
          "Ref": "AppconfigDeploymentStrategy"
        },
        "EnvironmentId": {
          "Ref": "AppconfigEnvironment"
        }
      },
      "Type": "AWS::AppConfig::Deployment"
    },
    "AppConfigDeploymentSettings": {
      "Properties": {
        "ApplicationId": {
          "Ref": "AppconfigApplication"
        },
        "ConfigurationProfileId": {
          "Ref": "AppConfigProfileSettings"
        },
        "ConfigurationVersion": {
          "Ref": "AppConfigHostedVersionSettings"
        },
        "DeploymentStrategyId": {
          "Ref": "AppconfigDeploymentStrategy"
        },
        "EnvironmentId": {
          "Ref": "AppconfigEnvironment"
        }
      },
      "Type": "AWS::AppConfig::Deployment"
    },
    "AppConfigHostedVersionConnections": {
      "Properties": {
        "ApplicationId": {
          "Ref": "AppconfigApplication"
        },
        "ConfigurationProfileId": {
          "Ref": "AppConfigProfileConnections"
        },
        "Content": {
          "Fn::Join": [
            "",
            [
              "{\"cityservices_district_service_base_url\": \"http://cityservices-district-service.cityservices.System.local:8001\", \"geocoder_provider_base_url\": \"http://cityservices-geocoder-mock:8091\", \"request_db_database\": \"cityservices_request\", \"request_db_port\": 5432, \"request_db_user\": \"cityservices_request_service_request_db_rw\", \"sms_provider_base_url\": \"http://cityservices-sms-mock:8090\", \"request_db_host\": \"",
              {
                "Fn::ImportValue": "cityservices-system-cityservices-request-service-data-RequestDbDbHost"
              },
              "\", \"mq_request_events_address\": \"",
              {
                "Fn::Sub": [
                  "arn:${AWS::Partition}:sns:${AWS::Region}:${AWS::AccountId}:${TopicName}",
                  {
                    "TopicName": "cityservices_request_service-mq-request_events"
                  }
                ]
              },
              "\"}"
            ]
          ]
        },
        "ContentType": "application/json"
      },
      "Type": "AWS::AppConfig::HostedConfigurationVersion"
    },
    "AppConfigHostedVersionSettings": {
      "Properties": {
        "ApplicationId": {
          "Ref": "AppconfigApplication"
        },
        "ConfigurationProfileId": {
          "Ref": "AppConfigProfileSettings"
        },
        "Content": "{\"debugMode\": false}",
        "ContentType": "application/json"
      },
      "Type": "AWS::AppConfig::HostedConfigurationVersion"
    },
    "AppConfigProfileConnections": {
      "Properties": {
        "ApplicationId": {
          "Ref": "AppconfigApplication"
        },
        "LocationUri": "hosted",
        "Name": "connections",
        "Type": "AWS.Freeform"
      },
      "Type": "AWS::AppConfig::ConfigurationProfile"
    },
    "AppConfigProfileSettings": {
      "Properties": {
        "ApplicationId": {
          "Ref": "AppconfigApplication"
        },
        "LocationUri": "hosted",
        "Name": "settings",
        "Type": "AWS.Freeform"
      },
      "Type": "AWS::AppConfig::ConfigurationProfile"
    },
    "AppconfigApplication": {
      "Properties": {
        "Description": "Config store for cityservices_request_service",
        "Name": "portalder"
      },
      "Type": "AWS::AppConfig::Application"
    },
    "AppconfigDeploymentStrategy": {
      "Properties": {
        "DeploymentDurationInMinutes": 10,
        "FinalBakeTimeInMinutes": 0,
        "GrowthFactor": 100.0,
        "GrowthType": "LINEAR",
        "Name": "cityservices_request_service-linear",
        "ReplicateTo": "NONE"
      },
      "Type": "AWS::AppConfig::DeploymentStrategy"
    },
    "AppconfigEnvironment": {
      "Properties": {
        "ApplicationId": {
          "Ref": "AppconfigApplication"
        },
        "Name": "local"
      },
      "Type": "AWS::AppConfig::Environment"
    },
    "CityservicesRequestServiceMqRequestEventsTopic": {
      "Properties": {
        "KmsMasterKeyId": "alias/aws/sns",
        "TopicName": "cityservices_request_service-mq-request_events"
      },
      "Type": "AWS::SNS::Topic"
    },
    "CloudMapService": {
      "Properties": {
        "DnsConfig": {
          "DnsRecords": [
            {
              "TTL": 10,
              "Type": "A"
            }
          ],
          "NamespaceId": {
            "Fn::ImportValue": "cityservices-system-ecs-NamespaceId"
          },
          "RoutingPolicy": "MULTIVALUE"
        },
        "HealthCheckCustomConfig": {
          "FailureThreshold": 1
        },
        "Name": "cityservices-request-service",
        "NamespaceId": {
          "Fn::ImportValue": "cityservices-system-ecs-NamespaceId"
        }
      },
      "Type": "AWS::ServiceDiscovery::Service"
    },
    "ConfigPreflight": {
      "DependsOn": [
        "AppConfigDeploymentSettings",
        "AppConfigDeploymentConnections"
      ],
      "Properties": {
        "ConfigItems": [
          {
            "action_fn": "check_config_key",
            "application": {
              "Ref": "AppconfigApplication"
            },
            "environment": {
              "Ref": "AppconfigEnvironment"
            },
            "key": "cityservices_district_service_base_url",
            "profile": {
              "Ref": "AppConfigProfileConnections"
            }
          },
          {
            "action_fn": "seed_config_default",
            "application": {
              "Ref": "AppconfigApplication"
            },
            "content_shape": "freeform",
            "default_value": "\"http://cityservices-geocoder-mock:8091\"",
            "environment": {
              "Ref": "AppconfigEnvironment"
            },
            "key": "geocoder_provider_base_url",
            "profile": {
              "Ref": "AppConfigProfileConnections"
            }
          },
          {
            "action_fn": "check_config_key",
            "application": {
              "Ref": "AppconfigApplication"
            },
            "environment": {
              "Ref": "AppconfigEnvironment"
            },
            "key": "mq_request_events_address",
            "profile": {
              "Ref": "AppConfigProfileConnections"
            }
          },
          {
            "action_fn": "seed_config_default",
            "application": {
              "Ref": "AppconfigApplication"
            },
            "content_shape": "freeform",
            "default_value": "\"cityservices_request\"",
            "environment": {
              "Ref": "AppconfigEnvironment"
            },
            "key": "request_db_database",
            "profile": {
              "Ref": "AppConfigProfileConnections"
            }
          },
          {
            "action_fn": "check_config_key",
            "application": {
              "Ref": "AppconfigApplication"
            },
            "environment": {
              "Ref": "AppconfigEnvironment"
            },
            "key": "request_db_host",
            "profile": {
              "Ref": "AppConfigProfileConnections"
            }
          },
          {
            "action_fn": "seed_config_default",
            "application": {
              "Ref": "AppconfigApplication"
            },
            "content_shape": "freeform",
            "default_value": "5432",
            "environment": {
              "Ref": "AppconfigEnvironment"
            },
            "key": "request_db_port",
            "profile": {
              "Ref": "AppConfigProfileConnections"
            }
          },
          {
            "action_fn": "check_config_key",
            "application": {
              "Ref": "AppconfigApplication"
            },
            "environment": {
              "Ref": "AppconfigEnvironment"
            },
            "key": "request_db_user",
            "profile": {
              "Ref": "AppConfigProfileConnections"
            }
          },
          {
            "action_fn": "seed_config_default",
            "application": {
              "Ref": "AppconfigApplication"
            },
            "content_shape": "freeform",
            "default_value": "\"http://cityservices-sms-mock:8090\"",
            "environment": {
              "Ref": "AppconfigEnvironment"
            },
            "key": "sms_provider_base_url",
            "profile": {
              "Ref": "AppConfigProfileConnections"
            }
          },
          {
            "action_fn": "seed_config_default",
            "application": {
              "Ref": "AppconfigApplication"
            },
            "content_shape": "freeform",
            "default_value": "false",
            "environment": {
              "Ref": "AppconfigEnvironment"
            },
            "key": "debugMode",
            "profile": {
              "Ref": "AppConfigProfileSettings"
            }
          }
        ],
        "RunId": {
          "Ref": "PreflightRunId"
        },
        "ServiceTimeout": 360,
        "ServiceToken": {
          "Fn::GetAtt": [
            "ConfigPreflightFn",
            "Arn"
          ]
        }
      },
      "Type": "AWS::CloudFormation::CustomResource"
    },
    "ConfigPreflightFn": {
      "DependsOn": [
        "ConfigPreflightRoleDefaultPolicy",
        "ConfigPreflightRole"
      ],
      "Properties": {
        "Code": {
          "S3Bucket": {
            "Fn::ImportValue": "cityservices-system-bootstrap-DeploymentBucketName"
          },
          "S3Key": {
            "Ref": "PreflightCodeKey"
          }
        },
        "Handler": "preflight_handler.handler",
        "LoggingConfig": {
          "LogGroup": {
            "Ref": "ConfigPreflightLogGroup"
          }
        },
        "MemorySize": 256,
        "Role": {
          "Fn::GetAtt": [
            "ConfigPreflightRole",
            "Arn"
          ]
        },
        "Runtime": "python3.13",
        "Timeout": 300
      },
      "Type": "AWS::Lambda::Function"
    },
    "ConfigPreflightLogGroup": {
      "DeletionPolicy": "Delete",
      "Properties": {
        "RetentionInDays": 30
      },
      "Type": "AWS::Logs::LogGroup",
      "UpdateReplacePolicy": "Delete"
    },
    "ConfigPreflightRole": {
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": [
                "sts:AssumeRole"
              ],
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              }
            }
          ],
          "Version": "2012-10-17"
        }
      },
      "Type": "AWS::IAM::Role"
    },
    "ConfigPreflightRoleDefaultPolicy": {
      "Properties": {
        "PolicyDocument": {
          "Statement": [
            {
              "Action": [
                "logs:CreateLogStream",
                "logs:PutLogEvents"
              ],
              "Effect": "Allow",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "ConfigPreflightLogGroup",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${ConfigPreflightLogGroup.Arn}:*"
                }
              ]
            },
            {
              "Action": [
                "appconfig:StartConfigurationSession",
                "appconfig:GetLatestConfiguration"
              ],
              "Effect": "Allow",
              "Resource": [
                {
                  "Fn::Sub": [
                    "arn:${AWS::Partition}:appconfig:${AWS::Region}:${AWS::AccountId}:application/${ApplicationId}/environment/${EnvironmentId}/configuration/${ConfigurationProfileId}",
                    {
                      "ApplicationId": {
                        "Ref": "AppconfigApplication"
                      },
                      "ConfigurationProfileId": {
                        "Ref": "AppConfigProfileConnections"
                      },
                      "EnvironmentId": {
                        "Ref": "AppconfigEnvironment"
                      }
                    }
                  ]
                },
                {
                  "Fn::Sub": [
                    "arn:${AWS::Partition}:appconfig:${AWS::Region}:${AWS::AccountId}:application/${ApplicationId}/environment/${EnvironmentId}/configuration/${ConfigurationProfileId}",
                    {
                      "ApplicationId": {
                        "Ref": "AppconfigApplication"
                      },
                      "ConfigurationProfileId": {
                        "Ref": "AppConfigProfileSettings"
                      },
                      "EnvironmentId": {
                        "Ref": "AppconfigEnvironment"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "Action": [
                "appconfig:CreateHostedConfigurationVersion"
              ],
              "Effect": "Allow",
              "Resource": [
                {
                  "Fn::Sub": [
                    "arn:${AWS::Partition}:appconfig:${AWS::Region}:${AWS::AccountId}:application/${ApplicationId}",
                    {
                      "ApplicationId": {
                        "Ref": "AppconfigApplication"
                      }
                    }
                  ]
                },
                {
                  "Fn::Sub": [
                    "arn:${AWS::Partition}:appconfig:${AWS::Region}:${AWS::AccountId}:application/${ApplicationId}/configurationprofile/${ConfigurationProfileId}",
                    {
                      "ApplicationId": {
                        "Ref": "AppconfigApplication"
                      },
                      "ConfigurationProfileId": {
                        "Ref": "AppConfigProfileConnections"
                      }
                    }
                  ]
                },
                {
                  "Fn::Sub": [
                    "arn:${AWS::Partition}:appconfig:${AWS::Region}:${AWS::AccountId}:application/${ApplicationId}/configurationprofile/${ConfigurationProfileId}",
                    {
                      "ApplicationId": {
                        "Ref": "AppconfigApplication"
                      },
                      "ConfigurationProfileId": {
                        "Ref": "AppConfigProfileSettings"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "Action": [
                "appconfig:StartDeployment"
              ],
              "Effect": "Allow",
              "Resource": [
                {
                  "Fn::Sub": [
                    "arn:${AWS::Partition}:appconfig:${AWS::Region}:${AWS::AccountId}:application/${ApplicationId}",
                    {
                      "ApplicationId": {
                        "Ref": "AppconfigApplication"
                      }
                    }
                  ]
                },
                {
                  "Fn::Sub": [
                    "arn:${AWS::Partition}:appconfig:${AWS::Region}:${AWS::AccountId}:application/${ApplicationId}/configurationprofile/${ConfigurationProfileId}",
                    {
                      "ApplicationId": {
                        "Ref": "AppconfigApplication"
                      },
                      "ConfigurationProfileId": {
                        "Ref": "AppConfigProfileConnections"
                      }
                    }
                  ]
                },
                {
                  "Fn::Sub": [
                    "arn:${AWS::Partition}:appconfig:${AWS::Region}:${AWS::AccountId}:application/${ApplicationId}/configurationprofile/${ConfigurationProfileId}",
                    {
                      "ApplicationId": {
                        "Ref": "AppconfigApplication"
                      },
                      "ConfigurationProfileId": {
                        "Ref": "AppConfigProfileSettings"
                      }
                    }
                  ]
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:appconfig:${AWS::Region}:${AWS::AccountId}:deploymentstrategy/AppConfig.AllAtOnce"
                },
                {
                  "Fn::Sub": [
                    "arn:${AWS::Partition}:appconfig:${AWS::Region}:${AWS::AccountId}:application/${ApplicationId}/environment/${EnvironmentId}",
                    {
                      "ApplicationId": {
                        "Ref": "AppconfigApplication"
                      },
                      "EnvironmentId": {
                        "Ref": "AppconfigEnvironment"
                      }
                    }
                  ]
                }
              ]
            }
          ],
          "Version": "2012-10-17"
        },
        "PolicyName": "ConfigPreflightRoleDefaultPolicy",
        "Roles": [
          {
            "Ref": "ConfigPreflightRole"
          }
        ]
      },
      "Type": "AWS::IAM::Policy"
    },
    "CpuScaling": {
      "Properties": {
        "PolicyName": "CpuScaling",
        "PolicyType": "TargetTrackingScaling",
        "ScalingTargetId": {
          "Ref": "ScalableTarget"
        },
        "TargetTrackingScalingPolicyConfiguration": {
          "PredefinedMetricSpecification": {
            "PredefinedMetricType": "ECSServiceAverageCPUUtilization"
          },
          "ScaleInCooldown": 60,
          "ScaleOutCooldown": 60,
          "TargetValue": 70
        }
      },
      "Type": "AWS::ApplicationAutoScaling::ScalingPolicy"
    },
    "FargateService": {
      "DependsOn": [
        "TaskRoleDefaultPolicy",
        "TaskRole",
        "ConfigPreflight"
      ],
      "Properties": {
        "Cluster": {
          "Fn::ImportValue": "cityservices-system-ecs-ClusterName"
        },
        "DeploymentConfiguration": {
          "MaximumPercent": 200,
          "MinimumHealthyPercent": 50
        },
        "DesiredCount": 2,
        "EnableECSManagedTags": false,
        "HealthCheckGracePeriodSeconds": 60,
        "LaunchType": "FARGATE",
        "LoadBalancers": [
          {
            "ContainerName": "cityservices_request_service",
            "ContainerPort": 8003,
            "TargetGroupArn": {
              "Fn::ImportValue": "cityservices-system-gateway-nlb-CityservicesRequestServiceNlbTargetGroupArn"
            }
          }
        ],
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "DISABLED",
            "SecurityGroups": [
              {
                "Fn::GetAtt": [
                  "ServiceSecurityGroup",
                  "GroupId"
                ]
              }
            ],
            "Subnets": [
              {
                "Fn::ImportValue": "cityservices-system-vpc-PrivateSubnet1Id"
              },
              {
                "Fn::ImportValue": "cityservices-system-vpc-PrivateSubnet2Id"
              }
            ]
          }
        },
        "ServiceRegistries": [
          {
            "RegistryArn": {
              "Fn::GetAtt": [
                "CloudMapService",
                "Arn"
              ]
            }
          }
        ],
        "TaskDefinition": {
          "Ref": "TaskDefinition"
        }
      },
      "Type": "AWS::ECS::Service"
    },
    "LogGroup": {
      "DeletionPolicy": "Delete",
      "Properties": {
        "LogGroupName": "/ecs/cityservices_request_service",
        "RetentionInDays": 30
      },
      "Type": "AWS::Logs::LogGroup",
      "UpdateReplacePolicy": "Delete"
    },
    "RequestDbDbIngress": {
      "Properties": {
        "Description": "Database access to requestDb",
        "FromPort": 5432,
        "GroupId": {
          "Fn::ImportValue": "cityservices-system-cityservices-request-service-data-RequestDbDbSecurityGroupId"
        },
        "IpProtocol": "tcp",
        "SourceSecurityGroupId": {
          "Fn::GetAtt": [
            "ServiceSecurityGroup",
            "GroupId"
          ]
        },
        "ToPort": 5432
      },
      "Type": "AWS::EC2::SecurityGroupIngress"
    },
    "RequestEventsDlq": {
      "DeletionPolicy": "Delete",
      "Properties": {
        "MessageRetentionPeriod": 1209600,
        "QueueName": "cityservices_request_service-RequestEvents-dlq",
        "SqsManagedSseEnabled": true
      },
      "Type": "AWS::SQS::Queue",
      "UpdateReplacePolicy": "Delete"
    },
    "RequestEventsQueue": {
      "DeletionPolicy": "Delete",
      "Properties": {
        "MessageRetentionPeriod": 345600,
        "QueueName": "cityservices_request_service-RequestEvents",
        "RedrivePolicy": {
          "deadLetterTargetArn": {
            "Fn::GetAtt": [
              "RequestEventsDlq",
              "Arn"
            ]
          },
          "maxReceiveCount": 5
        },
        "SqsManagedSseEnabled": true,
        "VisibilityTimeout": 30
      },
      "Type": "AWS::SQS::Queue",
      "UpdateReplacePolicy": "Delete"
    },
    "ScalableTarget": {
      "Properties": {
        "MaxCapacity": 4,
        "MinCapacity": 2,
        "ResourceId": {
          "Fn::Join": [
            "/",
            [
              "service",
              {
                "Fn::ImportValue": "cityservices-system-ecs-ClusterName"
              },
              {
                "Fn::GetAtt": [
                  "FargateService",
                  "Name"
                ]
              }
            ]
          ]
        },
        "RoleARN": {
          "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/aws-service-role/ecs.application-autoscaling.amazonaws.com/AWSServiceRoleForApplicationAutoScaling_ECSService"
        },
        "ScalableDimension": "ecs:service:DesiredCount",
        "ServiceNamespace": "ecs"
      },
      "Type": "AWS::ApplicationAutoScaling::ScalableTarget"
    },
    "ServiceDashboard": {
