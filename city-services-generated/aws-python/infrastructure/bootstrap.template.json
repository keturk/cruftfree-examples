{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Outputs": {
    "CityservicesDistrictServiceRepositoryArn": {
      "Description": "ARN of the 'cityservices_district_service' repository, for scoped image-pull grants.",
      "Export": {
        "Name": "cityservices-system-bootstrap-CityservicesDistrictServiceRepositoryArn"
      },
      "Value": {
        "Fn::GetAtt": [
          "CityservicesDistrictServiceRepository",
          "Arn"
        ]
      }
    },
    "CityservicesDistrictServiceRepositoryUri": {
      "Description": "Image URI of the 'cityservices_district_service' repository.",
      "Export": {
        "Name": "cityservices-system-bootstrap-CityservicesDistrictServiceRepositoryUri"
      },
      "Value": {
        "Fn::GetAtt": [
          "CityservicesDistrictServiceRepository",
          "RepositoryUri"
        ]
      }
    },
    "CityservicesFacilityServiceRepositoryArn": {
      "Description": "ARN of the 'cityservices_facility_service' repository, for scoped image-pull grants.",
      "Export": {
        "Name": "cityservices-system-bootstrap-CityservicesFacilityServiceRepositoryArn"
      },
      "Value": {
        "Fn::GetAtt": [
          "CityservicesFacilityServiceRepository",
          "Arn"
        ]
      }
    },
    "CityservicesFacilityServiceRepositoryUri": {
      "Description": "Image URI of the 'cityservices_facility_service' repository.",
      "Export": {
        "Name": "cityservices-system-bootstrap-CityservicesFacilityServiceRepositoryUri"
      },
      "Value": {
        "Fn::GetAtt": [
