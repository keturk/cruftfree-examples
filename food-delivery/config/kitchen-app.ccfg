config app fooddelivery.Kitchen {
  base {
    targets = ["angular"];
    clients {
      angular {
        scope = "@saltbox";
      }
    }
    strings = ["config/strings/kitchen.en-US.ccfg"];
  }
  profile test as "test" extends base {
    web { port = 4300; }
  }
  profile azure as "azure" extends base {
    web { domain { name = "kitchen.saltbox.example.com"; } }
  }
  profile development as "dev" extends azure {
  }
  profile production as "prod" extends base {
    web { port = 4300; }
  }
}
