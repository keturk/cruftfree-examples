config app helpdesk.Console {
  base {
    targets = ["angular"];
    clients {
      angular {
        scope = "@lanternpost";
      }
    }
    strings = ["config/strings/console.en-US.ccfg"];
  }
  profile test as "test" extends base {
    web { port = 4300; }
  }
  profile azure as "azure" extends base {
    web { domain { name = "console.lanternpost.example.com"; } }
  }
  profile development as "dev" extends azure {
  }
  profile production as "prod" extends base {
    web { port = 4300; }
  }
}
