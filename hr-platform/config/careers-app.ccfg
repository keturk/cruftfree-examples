config app hr.Careers {
  base {
    targets = ["angular"];
    clients {
      angular {
        scope = "@alderbrook";
      }
    }
    strings = ["config/strings/careers.en-US.ccfg"];
  }
  profile test as "test" extends base {
    web { port = 4400; }
  }
  profile azure as "azure" extends base {
    web { domain { name = "careers.alderbrook.example.com"; } }
  }
  profile development as "dev" extends azure {
  }
  profile production as "prod" extends base {
    web { port = 4400; }
  }
}
