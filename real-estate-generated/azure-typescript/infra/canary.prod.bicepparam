// realestate-system canary-stage parameters (prod)
// Generated by CruftFree. Do not edit manually.
// Mirrors main.prod.bicepparam so the canary (full infra minus APIM) uses identical values.

using 'canary.bicep'

param location = 'eastus'
param environment = 'prod'

// Placeholder per-service image tags -- canary.bicep declares
// the same {svc}ImageTag params as main.bicep (canary_only drops APIM only).
// scripts/deploy.ps1 canary rewrites each placeholder with the resolved
// content-hash tag BEFORE any Bicep deploy stage runs.
param realestateListingServiceImageTag = 'CRUFTFREE_IMAGE_TAG_PLACEHOLDER_realestateListingService'
param realestateViewingServiceImageTag = 'CRUFTFREE_IMAGE_TAG_PLACEHOLDER_realestateViewingService'
param realestateDealServiceImageTag = 'CRUFTFREE_IMAGE_TAG_PLACEHOLDER_realestateDealService'
param realestateMortgageMockImageTag = 'CRUFTFREE_IMAGE_TAG_PLACEHOLDER_realestateMortgageMock'
param realestateSignatureMockImageTag = 'CRUFTFREE_IMAGE_TAG_PLACEHOLDER_realestateSignatureMock'
param realestateEmailMockImageTag = 'CRUFTFREE_IMAGE_TAG_PLACEHOLDER_realestateEmailMock'

// The identity running the deploy, granted the rights each schema run needs.
// scripts/deploy.py resolves the signed-in identity and exports both variables
// before any stage runs; an unset variable fails the deployment here.
param operatorPrincipalId = readEnvironmentVariable('CRUFTFREE_OPERATOR_PRINCIPAL_ID')
param operatorPrincipalType = readEnvironmentVariable('CRUFTFREE_OPERATOR_PRINCIPAL_TYPE')
