// Azure Functions Flex Consumption plan (Linux). Generated by CruftFree. Do not edit manually.

@description('Azure region')
param location string

@description('Environment name')
param environment string

// Azure Flex Consumption is strictly ONE function app per plan, so main.bicep
// emits a dedicated plan per function app and passes its unique name here. A single
// shared plan fails the 2nd+ function app with "There can only be one site per Flex
// Consumption serverfarm".
@description('Unique Flex Consumption plan name (one plan per function app)')
param planName string

resource plan 'Microsoft.Web/serverfarms@2023-12-01' = {
  name: '${planName}-${environment}'
  location: location
  sku: {
    name: 'FC1'
    tier: 'FlexConsumption'
  }
  kind: 'functionapp'
  properties: {
    reserved: true  // Linux
  }
}

output planId string = plan.id
output planName string = plan.name
