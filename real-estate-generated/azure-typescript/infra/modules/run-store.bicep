// Run store and schema identities for realestate-system.
// Generated by CruftFree. Do not edit manually.
//
// The run store carries files to and from the one-shot schema workload each
// RDBMS block runs inside the virtual network: a run's files live under
// '<block prefix><run id>/' in the one container, and every blob is deleted a
// day after it is written. Each block has its own schema identity, which may
// read and write its own prefix and holds no other right on any resource but,
// for a block on an external server, reading that block's owner password.
//
// A run's container group pulls its images from the composition's private
// registry, by digest, as the block's schema identity, over the registry's
// private endpoint: the schema-run subnet admits no registry egress, so no image
// comes from a public registry. Each schema identity holds AcrPull on that
// registry.
//
// The identity running the deploy (the operator) starts each run: it imports the
// run's images into the registry, writes the run's input, creates one container
// group per run in the schema-run subnet under the block's schema
// identity, reads the run's output and removes both. Each of those rights is its
// own custom role at the narrowest scope that carries it, so the operator gains
// nothing wider than a run needs.

@description('Azure region')
param location string

@description('Environment name')
param environment string

@description('Object id of the identity running the deployment. It starts each schema run, so it is granted the run store and the per-run container-group rights. Deliberately has no default: the operator is a deploy-time fact.')
param operatorPrincipalId string

@description('Directory object type of operatorPrincipalId -- User for a signed-in human, ServicePrincipal for an automation identity. Azure rejects a role assignment whose declared principalType does not match the object.')
@allowed([
  'User'
  'ServicePrincipal'
  'Group'
])
param operatorPrincipalType string

@description('Resource id of the schema-run subnet, delegated to Microsoft.ContainerInstance/containerGroups, that each run\'s container group joins')
param schemaRunSubnetId string

@description('Name of the composition\'s private container registry, in this resource group, that each run\'s images are imported into and pulled from')
param containerRegistryName string

resource runRegistry 'Microsoft.ContainerRegistry/registries@2023-07-01' existing = {
  name: containerRegistryName
}

// Identity-only: no account key, no SAS, no anonymous access, TLS 1.2 over
// HTTPS only. Reachable from outside the virtual network because the
// operator's machine uploads each run's input; Entra RBAC is the only way in.
resource runStore 'Microsoft.Storage/storageAccounts@2023-01-01' = {
  name: 'run${uniqueString(resourceGroup().id, 'realestate-system', environment)}'
  location: location
  kind: 'StorageV2'
  sku: {
    name: 'Standard_LRS'
  }
  properties: {
    accessTier: 'Hot'
    supportsHttpsTrafficOnly: true
    minimumTlsVersion: 'TLS1_2'
    allowBlobPublicAccess: false
    allowSharedKeyAccess: false
    defaultToOAuthAuthentication: true
    allowCrossTenantReplication: false
    publicNetworkAccess: 'Enabled'
    networkAcls: {
      defaultAction: 'Allow'
      bypass: 'AzureServices'
    }
    encryption: {
      keySource: 'Microsoft.Storage'
      requireInfrastructureEncryption: true
      services: {
        blob: {
          enabled: true
          keyType: 'Account'
        }
      }
    }
  }
  tags: {
    environment: environment
  }
}

// No versions and no soft delete: either would keep a run's files past the
// one-day expiry below.
resource runStoreBlobs 'Microsoft.Storage/storageAccounts/blobServices@2023-01-01' = {
  parent: runStore
  name: 'default'
  properties: {
    isVersioningEnabled: false
    deleteRetentionPolicy: {
      enabled: false
    }
  }
}

resource runStoreContainer 'Microsoft.Storage/storageAccounts/blobServices/containers@2023-01-01' = {
  parent: runStoreBlobs
  name: 'runs'
  properties: {
    publicAccess: 'None'
  }
}

// Every blob of the account, with no prefix filter, is deleted a day after it
// is created.
resource runStoreExpiry 'Microsoft.Storage/storageAccounts/managementPolicies@2023-01-01' = {
  parent: runStore
  name: 'default'
  properties: {
    policy: {
      rules: [
        {
          name: 'expire-runs'
          enabled: true
          type: 'Lifecycle'
          definition: {
            filters: {
              blobTypes: [
                'blockBlob'
                'appendBlob'
              ]
            }
            actions: {
              baseBlob: {
                delete: {
                  daysAfterCreationGreaterThan: 1
                }
              }
            }
          }
        }
      ]
    }
  }
}

