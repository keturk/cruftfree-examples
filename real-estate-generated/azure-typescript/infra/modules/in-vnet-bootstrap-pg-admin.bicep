// In-VNet bootstrap: Postgres Entra-administrator binding (one pooled server).
// Split into its own module so the administrators child-resource `name` (the
// principal objectId) arrives as a start-calculable parameter. Declaring it in
// the same module that CREATES the user-assigned identity trips BCP120, because
// `bootstrapIdentity.properties.principalId` is a deploy-time value and the
// administrators `name` must be known at the start of the deployment.
// Generated by CruftFree. Do not edit manually.

@description('Name of the pooled Postgres flexible server to administer')
param pooledServerName string

@description('Object-id (principalId) of the bootstrap managed identity')
param bootstrapPrincipalId string

@description('Principal name (UAMI name) recorded on the Entra-admin binding')
param bootstrapPrincipalName string

resource pooledServer 'Microsoft.DBforPostgreSQL/flexibleServers@2023-03-01-preview' existing = {
  name: pooledServerName
}

resource pgAdmin 'Microsoft.DBforPostgreSQL/flexibleServers/administrators@2023-03-01-preview' = {
  parent: pooledServer
  name: bootstrapPrincipalId
  properties: {
    principalName: bootstrapPrincipalName
    principalType: 'ServicePrincipal'
    tenantId: tenant().tenantId
  }
}
