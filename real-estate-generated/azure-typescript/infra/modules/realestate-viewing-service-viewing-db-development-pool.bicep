// Pooled flexible server — realestate-viewing-service-viewing-db-development-5e557f17
// Generated by CruftFree. One server, 1 isolated child database(s).
// Per-child isolation: each member has its own database; Entra AD auth is used
// (passwordless — no connection-string secrets). Role assignments are emitted as
// standalone leaf modules in main.bicep to break the pool↔web-app BCP080
// dependency cycle.
// All server settings are declared in serverGroups{} (.ccfg); resource types and the
// connection scheme are derived from the declared engine. Nothing is defaulted here.

param location string = resourceGroup().location
@description('Resource ID of the subnet delegated to Microsoft.DBforPostgreSQL/flexibleServers for this server')
param pgDelegatedSubnetId string
@description('ARM resource ID of the shared private DNS zone (*.private.postgres.database.azure.com)')
param pgPrivateDnsZoneId string

// Administrator login is declared in deployment config.
var administratorLogin = 'pgadmin'

// ---------------------------------------------------------------------------
// Shared flexible server — realestate-viewing-service-viewing-db-development-5e557f17
// Resource identity: (group=realestate-viewing-service-viewing-db, profile=development)
// ---------------------------------------------------------------------------

resource pooledServer 'Microsoft.DBforPostgreSQL/flexibleServers@2023-03-01-preview' = {
  name: 'realestate-viewing-service-viewing-db-development-5e557f17'
  location: location
  sku: {
    name: 'Standard_B1ms'
    tier: 'Burstable'
  }
  properties: {
    // Microsoft Entra authentication is always enabled: the bootstrap identity
    // administers the server through it. Password authentication is enabled only
    // for a target that declares a password rdbms connection identity; when it is
    // off (the default) no administrator password exists at all.
    authConfig: {
      activeDirectoryAuth: 'Enabled'
      passwordAuth: 'Disabled'
      tenantId: tenant().tenantId
    }
    administratorLogin: administratorLogin
    storage: {
      storageSizeGB: 32
    }
    version: '16'
    backup: {
      backupRetentionDays: 7
      geoRedundantBackup: 'Disabled'
    }
    network: {
      delegatedSubnetResourceId: pgDelegatedSubnetId
      privateDnsZoneArmResourceId: pgPrivateDnsZoneId
    }
    highAvailability: {
      mode: 'Disabled'
    }
  }
  tags: {
    'cruftfree-pool-group': 'realestate-viewing-service-viewing-db'
    'cruftfree-pool-profile': 'development'
    'cruftfree-managed': 'true'
  }
}

// Connection capacity — pin max_connections to the compute SKU's default so the
// running engine admits the connections POOL005 validated. Without this resource
// the server keeps whatever max_connections it materialised under its ORIGINAL
// tier: max_connections is a STATIC parameter, and Azure does not re-apply a
// tier's default to an existing server after a later SKU change, so a pool sized
// up to raise capacity still crash-loops on "remaining connection slots are
// reserved". The value is the SKU default from Azure's declared Flexible Server capacity,
// the SAME number POOL005 checks the summed pool demand against — check and
// deployed value cannot diverge. Static parameter: it takes effect on the next
// server restart (fresh provisioning applies it; the deploy script restarts the
// server when a tier change leaves it staged, isConfigPendingRestart=true).
resource maxConnections 'Microsoft.DBforPostgreSQL/flexibleServers/configurations@2023-03-01-preview' = {
  parent: pooledServer
  name: 'max_connections'
  properties: {
    value: '50'
    source: 'user-override'
  }
}

// ---------------------------------------------------------------------------
// Physical databases — one per DISTINCT author-declared `database:` (1 total)
// Design of record (pooling.md): PostgreSQL per-member isolation is by SCHEMA
// within a SHARED database, NOT one database per member. Several members that
// declare the same `database:` share one database resource here; each member's
// own `schema:` is created inside that database by the in-VNet bootstrap SQL.
// Passwordless auth: no connection-string KV secrets are emitted. Each service
// connects using its own web-app system-assigned managed identity via Entra AD.
// ---------------------------------------------------------------------------

resource db_1 'Microsoft.DBforPostgreSQL/flexibleServers/databases@2023-03-01-preview' = {
  parent: pooledServer
  name: 'realestate_viewing'
  properties: {
    charset: 'UTF8'
    collation: 'en_US.utf8'
  }
  dependsOn: [
    maxConnections
  ]
}


// ---------------------------------------------------------------------------
// Outputs for leaf member-grant modules — role assignment params were removed from
// pool modules; main.bicep now emits one leaf grant module per (pool, member) that
// references these outputs to scope the role assignment to the member's SHARED
// physical database (per-schema isolation is realized by the bootstrap SQL grants,
// not by an ARM assignment). There are NO connection-string secret outputs —
// passwordless Entra auth replaces all password / connection-string Key Vault
// secrets for Postgres datasources.
// ---------------------------------------------------------------------------

output pooledServerName string = pooledServer.name
// Keyed by the owner-qualified member key ("<owner>:<child_name>"), never by
// owner alone: one service may own several rdbms blocks and so be SEVERAL
// members of this pool — an owner-keyed object declares the same property twice
// (BCP025) and silently loses every member but the last.
output memberDatabaseNames object = {
  'realestate.ViewingService:viewing-db': db_1.name
}
