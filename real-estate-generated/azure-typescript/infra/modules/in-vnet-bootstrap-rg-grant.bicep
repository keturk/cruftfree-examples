// In-VNet bootstrap: a resource-group-scoped role grant for the bootstrap managed
// identity, named by principalId.
//
// Why a module (and why principalId in the name): the deploy ENSURES the resource
// group and never deletes it on redeploy, so the RG is a persistent container. An
// inline grant named guid(resourceGroup().id, identity.RESOURCE-id, role) keeps the
// SAME name across deploys (the UAMI name -- hence its resource id -- is stable),
// but a torn-down-and-recreated identity has a DIFFERENT principalId. ARM then tries
// to UPDATE the existing (now orphaned) assignment's principalId, which is immutable
// -> RoleAssignmentUpdateNotPermitted, failing the whole bootstrap deployment. Naming
// the assignment by principalId instead means a recreated identity yields a NEW
// assignment name and never touches the orphan. principalId is a deploy-time value,
// so it arrives here as a start-calculable module PARAMETER (using it in a resource
// name inline would trip BCP120).
// Generated by CruftFree. Do not edit manually.

@description('Object-id (principalId) of the bootstrap managed identity')
param bootstrapPrincipalId string

@description('Azure built-in role definition ID (GUID) to grant at resource-group scope')
param roleDefinitionId string

resource grant 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  name: guid(resourceGroup().id, bootstrapPrincipalId, roleDefinitionId)
  properties: {
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', roleDefinitionId)
    principalId: bootstrapPrincipalId
    principalType: 'ServicePrincipal'
  }
}
