// Microsoft Entra app registration for identity provider 'identity'
// Audience-resolved signInAudience: AzureADMyOrg
// Generated by CruftFree via the Microsoft Graph Bicep extension. Do not edit manually.

extension microsoftGraphV1

@description('Environment name')
param environment string

resource entraApplication 'Microsoft.Graph/applications@v1.0' = {
  displayName: 'identity-development'
  uniqueName: 'identity-${environment}'
  signInAudience: 'AzureADMyOrg'
  // Exposed API: the browser SPA (a public client on THIS registration) requests
  // the 'api://cobblestone.onmicrosoft.com/identity-development/access_as_user' scope to obtain an
  // API-audience access token for its own backend. The App ID URI is
  // tenant-qualified and name-based (api://<tenantId>/<uniqueName> — the default
  // tenant app-management policy rejects a bare name-based URI with
  // InvalidUniqueTenantIdentifierAsPerAppPolicy).
  // `preAuthorizedApplications` is omitted (self pre-authorization would need
  // this app's own read-only appId — a circular reference the Graph Bicep
  // extension cannot express); the SPA sees a one-time consent prompt on first
  // login instead.
  identifierUris: [
    'api://cobblestone.onmicrosoft.com/identity-development'
  ]
  api: {
    // v2 tokens: aud = this app's client ID (appId), iss = {loginEndpoint}/{tenant}/v2.0.
    // Entra fixes `iss` and `aud` TOGETHER per token version, so this MUST stay in
    // lock-step with the v2 issuer the identity provider plan emits and with the
    // gateway's v2 openid-config — the default (v1) version pairs a
    // sts.windows.net issuer with an api:// audience, a combination no token can
    // satisfy. EVERY registration requests v2, not only the SPA-facing ones: a
    // machine (service-to-service) audience with no exposed API still mints v2
    // tokens whose iss must match the same v2 plan issuer, and whose aud is this
    // app's client-ID GUID — delivered to services as IDENTITY_*_AUDIENCE_CLIENT_ID.
    // The delegated SPA-scope surface (the exposed API + its consent scope) is
    // emitted only for human audiences; the v2 token version is not conditional.
    requestedAccessTokenVersion: 2
    oauth2PermissionScopes: [
      {
        id: guid('identity', 'access_as_user')
        adminConsentDisplayName: 'Access identity API as the signed-in user'
        adminConsentDescription: 'Allow the application to access the identity API on behalf of the signed-in user.'
        userConsentDisplayName: 'Access the identity API on your behalf'
        userConsentDescription: 'Allow the application to access the identity API on your behalf.'
        value: 'access_as_user'
        type: 'User'
        isEnabled: true
      }
    ]
  }
  appRoles: [
    {
      id: guid('identity', 'agent')
      allowedMemberTypes: [
        'User'
      ]
      displayName: 'agent'
      description: 'Entra app role for CruftFree role agent (provider group agent).'
      value: 'agent'
      isEnabled: true
    }
    {
      id: guid('identity', 'operator')
      allowedMemberTypes: [
        'User'
      ]
      displayName: 'operator'
      description: 'Entra app role for CruftFree role operator (provider group operator).'
      value: 'operator'
      isEnabled: true
    }
  ]
}

resource entraServicePrincipal 'Microsoft.Graph/servicePrincipals@v1.0' = {
  appId: entraApplication.appId
}

output applicationId string = entraApplication.appId
output servicePrincipalId string = entraServicePrincipal.id
output applicationObjectId string = entraApplication.id
