// User-assigned managed identity for machine identity provider 'machine'
// Machine workloads acquire tokens via this identity (no client secret).
// Generated by CruftFree. Do not edit manually.

@description('Azure region')
param location string

// The identity name is baked at generation time and already carries the
// environment label ('machine-development-mi'), so no environment param is taken.
resource userAssignedIdentity 'Microsoft.ManagedIdentity/userAssignedIdentities@2023-01-31' = {
  name: 'machine-development-mi'
  location: location
}

output identityName string = userAssignedIdentity.name
output identityId string = userAssignedIdentity.id
output principalId string = userAssignedIdentity.properties.principalId
output clientId string = userAssignedIdentity.properties.clientId
