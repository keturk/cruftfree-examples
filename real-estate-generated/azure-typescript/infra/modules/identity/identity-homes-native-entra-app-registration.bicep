// Microsoft Entra app registration for identity provider 'identity'
// Audience-resolved signInAudience: AzureADMyOrg
// Generated by CruftFree via the Microsoft Graph Bicep extension. Do not edit manually.

extension microsoftGraphV1

@description('Environment name')
param environment string

@description('Application (client) id of the identity provider registration whose API this client calls')
param apiApplicationId string

resource entraApplication 'Microsoft.Graph/applications@v1.0' = {
  displayName: 'identity-homes-native-development'
  uniqueName: 'identity-homes-native-${environment}'
  signInAudience: 'AzureADMyOrg'
  api: {
    // v2 tokens: aud = this app's client ID (appId), iss = {loginEndpoint}/{tenant}/v2.0.
    // Entra fixes `iss` and `aud` TOGETHER per token version, so this MUST stay in
    // lock-step with the v2 issuer the identity provider plan emits and with the
    // gateway's v2 openid-config — the default (v1) version pairs a
    // sts.windows.net issuer with an api:// audience, a combination no token can
    // satisfy. EVERY registration requests v2, not only the SPA-facing ones: a
    // machine (service-to-service) audience with no exposed API still mints v2
    // tokens whose iss must match the same v2 plan issuer, and whose aud is this
    // app's client-ID GUID — delivered to services as IDENTITY_*_AUDIENCE_CLIENT_ID.
    // The delegated SPA-scope surface (the exposed API + its consent scope) is
    // emitted only for human audiences; the v2 token version is not conditional.
    requestedAccessTokenVersion: 2
  }
  // Native app (Authorization Code + PKCE through the system browser): a public
  // client on the mobile-and-desktop platform, with no client secret -- this
  // registration declares no credential of any kind. Its private-use-scheme
  // login redirect AND its post-logout redirect are both listed here, since
  // Entra only honours a post_logout_redirect_uri that is a registered
  // redirect URI. isFallbackPublicClient stays unset: that switch enables the
  // password, device-code and integrated-Windows flows, none of which this
  // client uses.
  publicClient: {
    redirectUris: [
      'com.example.cobblestone://oauth/callback'
      'com.example.cobblestone://oauth/logout'
    ]
  }
  // Delegated permission on the identity provider registration's exposed
  // 'access_as_user' scope -- the scope this client requests -- so its
  // access token is issued for that API (aud = the provider registration's
  // client id, the audience the backend accepts) and not for Microsoft Graph.
  // The scope id is the provider registration's own deterministic guid.
  requiredResourceAccess: [
    {
      resourceAppId: apiApplicationId
      resourceAccess: [
        {
          id: guid('identity', 'access_as_user')
          type: 'Scope'
        }
      ]
    }
  ]
}

resource entraServicePrincipal 'Microsoft.Graph/servicePrincipals@v1.0' = {
  appId: entraApplication.appId
}

output applicationId string = entraApplication.appId
output servicePrincipalId string = entraServicePrincipal.id
output applicationObjectId string = entraApplication.id
