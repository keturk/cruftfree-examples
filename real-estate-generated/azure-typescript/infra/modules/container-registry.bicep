// Shared Azure Container Registry for realestate-system. ONE
// registry per generated system and environment -- a registry name is globally
// unique, so it ends in the environment label -- images differentiated by
// repository name, not by registry (the backlog-010 asymmetry vs. AWS's
// repo-per-service ECR, deliberately kept): container-mode service images, and
// the images each schema run pulls under schema-run/. Pull auth is
// managed-identity only (adminUserEnabled: false). The registry has a private
// endpoint in every profile, so its SKU is Premium (ACR private endpoints are a
// Premium-only feature).
//
// TWO NETWORK PATHS -- do not conflate them:
//  * the private endpoint + privatelink DNS zone below govern the PULL path:
//    how web apps and schema runs inside the VNet reach the registry. Always
//    emitted.
//  * data_plane_public -> publicNetworkAccess. Governs the PUSH path: whether
//    the operator machine running deploy.ps1/deploy.sh can reach the data plane.
//    False whenever no container-mode web app is pushed to: a schema run's
//    images are imported, a control-plane action the AzureServices bypass admits.
// This mirrors key-vault.bicep.j2 and app-configuration.bicep.j2, which are both
// PROFILE-DERIVED on data_plane_public: under public-restricted and public the
// operator must reach the registry or 'az acr login' fails, falls back to
// interactive 'docker login', and the deploy hangs on a Username prompt.
// 'Enabled' only ADDS public reachability -- in-VNet pulls still resolve through
// the private endpoint (IP/public rules do not apply to private endpoints), and
// auth is unchanged: AAD/managed identity, adminUserEnabled false, no anonymous
// pull. private-by-default yields Disabled, and pushing then requires
// network line of sight to the VNet.
// Generated by CruftFree. Do not edit manually.

@description('Azure region')
param location string = resourceGroup().location

@description('Integration VNet resource ID for the privatelink.azurecr.io private DNS zone link')
param vnetId string

@description('Subnet resource ID hosting the ACR private endpoint (reuses the shared storage-family PE subnet -- ACR has no dedicated subnet in the CIDR plan, matching the deploy-script-infra.bicep precedent)')
param subnetId string

@description('Environment name: a registry name is globally unique, so it ends in this label')
param environment string

// The deploy script composes the same name from the same stem and label.
var registryName = 'realestatesystemacrbd8cc457${replace(environment, '-', '')}'

resource acr 'Microsoft.ContainerRegistry/registries@2023-07-01' = {
  name: registryName
  location: location
  sku: {
    name: 'Premium'
  }
  properties: {
    adminUserEnabled: false
    publicNetworkAccess: 'Disabled'
    networkRuleBypassOptions: 'AzureServices'
  }
}

// DNS resolution for the ACR private endpoint -- independent of, and required
// IN ADDITION TO, the properties.outboundVnetRouting.imagePullTraffic routing
// opt-in emitted on every container-mode web app (web-app.bicep.j2). Without
// this zone linked to the integration VNet, the registry's login server (and
// its regional data endpoint, <registry>.<region>.data.azurecr.io) do not
// resolve to the private endpoint's IP from inside the VNet -- one governs the
// traffic path, the other governs name resolution; both are needed for a
// private ACR pull to work.
resource acrPrivateDnsZone 'Microsoft.Network/privateDnsZones@2024-06-01' = {
  name: 'privatelink.azurecr.io'
  location: 'global'
}

resource acrPrivateDnsZoneVnetLink 'Microsoft.Network/privateDnsZones/virtualNetworkLinks@2024-06-01' = {
  parent: acrPrivateDnsZone
  name: '${registryName}-vnet-link'
  location: 'global'
  properties: {
    virtualNetwork: {
      id: vnetId
    }
    registrationEnabled: false
  }
}

// The actual private-link connection into the registry (Microsoft.ContainerRegistry
// private-link group id 'registry',
// learn.microsoft.com/azure/container-registry/container-registry-private-link).
// Without this resource, `publicNetworkAccess: 'Disabled'` above leaves the
// registry with NO network path at all, and 'Enabled' would route in-VNet pulls
// over the public endpoint -- the DNS zone alone only prepares name
// resolution, it does not by itself create a reachable endpoint. Both this
// resource AND the DNS zone above are required for a private ACR pull to work.
resource acrPrivateEndpoint 'Microsoft.Network/privateEndpoints@2023-11-01' = {
  name: '${registryName}-pe'
  location: location
  properties: {
    subnet: {
      id: subnetId
    }
    privateLinkServiceConnections: [
      {
        name: '${registryName}-plsc'
        properties: {
          privateLinkServiceId: acr.id
          groupIds: [
            'registry'
          ]
        }
      }
    ]
  }
}

resource acrPrivateEndpointDnsZoneGroup 'Microsoft.Network/privateEndpoints/privateDnsZoneGroups@2023-11-01' = {
  parent: acrPrivateEndpoint
  name: 'default'
  properties: {
    privateDnsZoneConfigs: [
      {
        name: 'config'
        properties: {
          privateDnsZoneId: acrPrivateDnsZone.id
        }
      }
    ]
  }
}

output acrId string = acr.id
output acrLoginServer string = acr.properties.loginServer
output acrName string = acr.name
