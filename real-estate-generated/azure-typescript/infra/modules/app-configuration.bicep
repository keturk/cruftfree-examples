// Azure App Configuration store for cobblestone
// Generated by CruftFree. Do not edit manually.
//
// Provisions the App Configuration store ONLY. Its network posture is
// PROFILE-DERIVED (data_plane_public), not per-service:
//  * private-by-default -> publicNetworkAccess 'Disabled'. The data plane is
//    reachable only over the private endpoint from inside the VNet.
//  * public-restricted / public -> publicNetworkAccess 'Enabled' so the
//    operator-machine runtime-requirements preflight can reach the data plane.
//    RBAC/AAD data-plane auth remains the guard; the private endpoint still
//    exists for in-VNet consumers ('Enabled' only ADDS public reachability).
//
// Key-values and feature flags are NOT emitted here in EITHER mode. They are
// seeded from INSIDE the VNet by the in-VNet bootstrap deploymentScript
// (az appconfig kv/feature set --auth-mode login) — a single seeding path that
// runs in both modes so the deployer never depends on public data-plane reach.
// The freeform key-values are stored as '<profile>:<key>'. The store endpoint is
// output for wiring into service environment variables; generated services read
// it via their managed identity (App Configuration Data Reader role).

@description('Azure region')
param location string

@description('Application name')
param appName string

@description('Environment name')
param environment string

resource configStore 'Microsoft.AppConfiguration/configurationStores@2023-03-01' = {
  name: '${appName}-appconfig-${environment}'
  location: location
  sku: {
    name: 'standard'
  }
  properties: {
    publicNetworkAccess: 'Disabled'
  }
}

// NOTE: key-values and feature flags are intentionally NOT emitted here in
// either network mode. They are seeded from inside the VNet by the in-VNet
// bootstrap deploymentScript (see in-vnet-bootstrap.bicep) so the deployer
// never depends on public data-plane reachability.

output configStoreName string = configStore.name
output endpoint string = configStore.properties.endpoint
