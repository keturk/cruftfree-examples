{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "apps",
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "schematics": {
    "@schematics/angular:component": {
      "style": "css",
      "standalone": true
    }
  },
  "projects": {
    "homes": {
      "projectType": "application",
      "root": "apps/homes",
      "sourceRoot": "apps/homes/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/homes",
            "index": "apps/homes/src/index.html",
            "browser": "apps/homes/src/main.ts",
            "tsConfig": "apps/homes/tsconfig.app.json",
            "allowedCommonJsDependencies": ["qrcode"],
            "styles": [
              "node_modules/maplibre-gl/dist/maplibre-gl.css",
              "libs/ui-core/src/lib/elements/elements.css",
              "apps/homes/src/styles.css"
            ],
            "assets": [
              { "glob": "**/*", "input": "apps/homes/public" },
              { "glob": "maplibre-gl-worker.mjs", "input": "node_modules/maplibre-gl/dist", "output": "/assets/maplibre" },
              { "glob": "maplibre-gl-shared.mjs", "input": "node_modules/maplibre-gl/dist", "output": "/assets/maplibre" },
              { "glob": "pdf.worker.min.mjs", "input": "node_modules/pdfjs-dist/build", "output": "/assets/pdfjs" },
              { "glob": "**/*", "input": "node_modules/pdfjs-dist/cmaps", "output": "/assets/pdfjs/cmaps" },
              { "glob": "**/*", "input": "node_modules/pdfjs-dist/standard_fonts", "output": "/assets/pdfjs/standard_fonts" }
            ]
          },
          "configurations": {
            "production": {
              "optimization": {
                "scripts": true,
                "styles": { "minify": true, "inlineCritical": false },
                "fonts": { "inline": false }
              },
              "outputHashing": "all",
              "sourceMap": false
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "homes:build:development",
            "tsConfig": "apps/homes/tsconfig.spec.json",
            "runner": "vitest",
            "include": ["**/*.spec.ts", "../../../libs/**/*.spec.ts"]
          }
        }
      }
    },
    "console": {
      "projectType": "application",
      "root": "apps/console",
      "sourceRoot": "apps/console/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/console",
            "index": "apps/console/src/index.html",
            "browser": "apps/console/src/main.ts",
            "tsConfig": "apps/console/tsconfig.app.json",
            "allowedCommonJsDependencies": ["qrcode"],
            "styles": [
              "node_modules/maplibre-gl/dist/maplibre-gl.css",
              "libs/ui-core/src/lib/elements/elements.css",
              "apps/console/src/styles.css"
            ],
            "assets": [
              { "glob": "**/*", "input": "apps/console/public" },
              { "glob": "maplibre-gl-worker.mjs", "input": "node_modules/maplibre-gl/dist", "output": "/assets/maplibre" },
              { "glob": "maplibre-gl-shared.mjs", "input": "node_modules/maplibre-gl/dist", "output": "/assets/maplibre" },
              { "glob": "pdf.worker.min.mjs", "input": "node_modules/pdfjs-dist/build", "output": "/assets/pdfjs" },
              { "glob": "**/*", "input": "node_modules/pdfjs-dist/cmaps", "output": "/assets/pdfjs/cmaps" },
              { "glob": "**/*", "input": "node_modules/pdfjs-dist/standard_fonts", "output": "/assets/pdfjs/standard_fonts" }
            ]
          },
          "configurations": {
            "production": {
              "optimization": {
                "scripts": true,
                "styles": { "minify": true, "inlineCritical": false },
                "fonts": { "inline": false }
              },
              "outputHashing": "all",
              "sourceMap": false
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "console:build:development",
            "tsConfig": "apps/console/tsconfig.spec.json",
            "runner": "vitest",
            "include": ["**/*.spec.ts", "../../../libs/**/*.spec.ts"]
          }
        }
      }
    }
  }
}
