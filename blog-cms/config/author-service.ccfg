config service blog.AuthorService {
  import "config/templates/infrastructure.ccfg";

  base {
    port = 8001;
    replicas = 1;
    healthCheck {
      path = "/health";
      initialDelay = "10s";
    }
    rdbms authorDb from postgresContainer(id: "33ba48db-1923-49dd-8bf6-24dcb512991c", database: "blog_authors");
    pubsub mq from kafkaContainer();
    httpSecurity from localHttpSecurity(host: "blog-author-service");
    outboxOps from outboxBatches();
    kafkaOps from kafkaPolling();
    resilience {
      defaults {
        timeout = "10s";
      }
      dependencyPolicy {
        defaults {
          rdbms from standardDatabasePolicy();
        }
      }
    }
  }

  profile test as "test" extends base {
    alias env = "TEST";
    alias resource = "test";
  }

  profile azure as "azure" extends base {
    alias env = "AZURE";
    alias resource = "azure";

    // Consumers run inside the web app, not in separate compute.
    runtime { consumers = "in-process"; }

    replicas = 2;
    scaling {
      replicas {
        min = 2;
        max = 4;
      }
      triggers = [];
    }
    replace rdbms authorDb from azurePostgres(id: "33ba48db-1923-49dd-8bf6-24dcb512991c", database: "blog_authors", poolSize: 20, maxOverflow: 10);
    replace pubsub mq from azureEventHubs();
  }

  profile development as "dev" extends azure {
    alias env = "DEV";
    alias resource = "dev";
  }

  profile production as "prod" extends base {
    alias env = "PROD";
    alias resource = "prod";
  }
}
