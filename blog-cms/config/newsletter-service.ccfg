config service blog.NewsletterService {
  import "config/templates/infrastructure.ccfg";

  base {
    port = 8004;
    replicas = 1;
    healthCheck {
      path = "/health";
      initialDelay = "10s";
    }
    rdbms newsletterDb from postgresContainer(id: "a4d9c6e8-1b2f-4c3d-8e7f-90a1b2c3d4e5", database: "blog_newsletter");
    pubsub mq from kafkaContainer();
    httpSecurity from localHttpSecurity(host: "blog-newsletter-service");
    outboxOps from outboxBatches();
    kafkaOps from kafkaPolling();
    jobs {
      jobs {
        SendPendingDeliveries {
          schedule = "* * * * *";
          timeout = "60s";
        }
      }
    }
    resilience {
      defaults {
        timeout = "10s";
      }
      dependencyPolicy {
        defaults {
          rdbms from standardDatabasePolicy();
        }
      }
    }
    secrets {
      // The default only exists on a local stack, where it matches the hash seeded in
      // seed/mail-mock.cseed, so the example runs with nothing to configure. Any other
      // deployment must supply the handle's value.
      secret mail_provider_api_key {
        required = true;
        purpose = "API key for the email provider (MailProvider contract).";
        localDefault = "dev-only-mail-api-key-not-a-credential";
      }
    }
  }

  profile test as "test" extends base {
    alias env = "TEST";
    alias resource = "test";
  }

  profile azure as "azure" extends base {
    alias env = "AZURE";
    alias resource = "azure";

    // Consumers run inside the web app, not in separate compute.
    runtime { consumers = "in-process"; }

    replicas = 2;
    scaling {
      replicas {
        min = 2;
        max = 4;
      }
      triggers = [];
    }
    replace rdbms newsletterDb from azurePostgres(id: "a4d9c6e8-1b2f-4c3d-8e7f-90a1b2c3d4e5", database: "blog_newsletter", poolSize: 20, maxOverflow: 10);
    replace pubsub mq from azureEventHubs();
  }

  profile development as "dev" extends azure {
    alias env = "DEV";
    alias resource = "dev";
  }

  profile production as "prod" extends base {
    alias env = "PROD";
    alias resource = "prod";
  }
}
