config app ecommerce.Site {
  base {
    targets = ["angular"];
    clients {
      angular {
        scope = "@ecommerce";
      }
    }
    strings = ["config/strings/site.en-US.ccfg", "config/strings/site.tr-TR.ccfg"];
    // The addresses the site links to and names as its canonical home page. A static site
    // reads them at build time, so they are baked into every prerendered page.
    externalLinks {
      site = "https://www.wrenwood.example.com/";
      shop = "https://shop.wrenwood.example.com/";
      terms = "https://shop.wrenwood.example.com/legal/terms";
      privacy = "https://shop.wrenwood.example.com/legal/privacy";
    }
  }
  // Loopback profiles are never indexed: `indexable` defaults to false, so a local or test
  // site says `noindex` and ships `Disallow: /`.
  profile development as "dev" extends azure {
  }
  profile test as "test" extends base {
    web { port = 4400; }
  }
  profile production as "prod" extends base {
    web { port = 4400; }
  }
  // Deployed profiles name the site's origin and say it may be indexed: the build writes
  // `sitemap.xml` and every canonical and alternate-language link from this origin.
  profile aws extends base {
    web {
      domain { name = "www.wrenwood.example.com"; }
      indexable = true;
    }
  }
  profile azure extends base {
    web {
      domain { name = "www.wrenwood.example.com"; }
      indexable = true;
    }
  }
  profile azureVm extends base {
    web {
      domain { name = "www.wrenwood.example.com"; }
      indexable = true;
    }
  }
}
